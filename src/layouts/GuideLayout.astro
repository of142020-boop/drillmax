---
import MainLayout from './MainLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
interface Props {
  title: string;
  heading: string;
  description: string;
  path: string;
  published: string;
  image: string;
  toc: {id: string; label: string}[];
  related: {href: string; label: string; desc?: string}[];
  phoneNumber?: string;
  eyebrow?: string;
  modifiedDate?: string;
  modifiedLabel?: string;
  ctaHeading?: string;
  ctaBody?: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const {
  title,
  heading,
  description,
  path,
  published,
  image,
  toc,
  related,
  phoneNumber,
  eyebrow = 'دليل التجهيز والاختيار',
  modifiedDate = '2026-10-22T12:00:00+03:00',
  modifiedLabel = '22 أكتوبر 2026',
  ctaHeading = 'تجهّز فتحة تهوية أو تحتاج فني تركيب؟',
  ctaBody = 'جهّز رقم الموديل، وصورة المكان، ومقاس الفتحة الحالي لتوضيح متطلبات العمل قبل تحديد التكلفة.',
  ctaHref = '/contact/',
  ctaLabel = 'ناقش تفاصيل التركيب',
} = Astro.props;
const url = new URL(path, 'https://drilmax.com').href;
const modified = modifiedDate;
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {'@type': 'Organization', '@id': 'https://drilmax.com/#organization', name: 'Drill Max | دريل ماكس', url: 'https://drilmax.com/', logo: {'@type': 'ImageObject', url: 'https://drilmax.com/images/logodrillmax.png'}},
    {'@type': 'BlogPosting', '@id': `${url}#article`, headline: heading, description, image: new URL(image, 'https://drilmax.com').href, datePublished: published, dateModified: modified, inLanguage: 'ar-EG', mainEntityOfPage: url, author: {'@id': 'https://drilmax.com/#organization'}, publisher: {'@id': 'https://drilmax.com/#organization'}},
    {'@type': 'BreadcrumbList', itemListElement: [
      {'@type':'ListItem', position:1, name:'الرئيسية', item:'https://drilmax.com/'},
      {'@type':'ListItem', position:2, name:'المدونة', item:'https://drilmax.com/blog/'},
      {'@type':'ListItem', position:3, name:heading, item:url},
    ]},
  ],
});
---
<MainLayout title={title} description={description} canonical={url} ogImage={image} schema={schema} ogType="article" articlePublishedTime={published} articleModifiedTime={modified} {...(phoneNumber ? { phoneNumber } : {})}>
  <div class="guide-shell">
    <nav class="guide-breadcrumb" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true"> / </span><a href="/blog/">المدونة</a></nav>
    <header class="guide-heading">
      <p class="guide-eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="guide-description">{description}</p>
      <p class="guide-meta">إعداد فريق دريل ماكس · آخر تحديث <time datetime={modified}>{modifiedLabel}</time></p>
    </header>
    <nav class="guide-toc" aria-label="محتويات الدليل"><strong>في هذا الدليل</strong><ul>{toc.map(item => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul></nav>
    <article class="guide-content"><slot /></article>
    <aside class="guide-request" aria-label="طلب معاينة أو استشارة">
      <div><h2>{ctaHeading}</h2><p>{ctaBody}</p></div>
      <a class="guide-button" href={ctaHref}>{ctaLabel}</a>
    </aside>
    <RelatedLinks title="أدلة وخدمات مرتبطة" links={related} />
  </div>
</MainLayout>
<style is:global>
  .guide-shell { width: min(100% - 40px, 1020px); margin: 0 auto; padding: 36px 0 72px; }
  .guide-breadcrumb { color: #5b616a; font-size: .88rem; margin-bottom: 20px; }
  .guide-breadcrumb a { text-decoration: none; border-bottom: 1px solid #c9c5bb; padding-bottom: 1px; }
  .guide-breadcrumb a:hover { color: #c2410c; border-color: #c2410c; }
  .guide-heading { border-bottom: 1px solid #dad7ce; padding-bottom: 28px; }
  .guide-eyebrow { color: #c2410c; font-size: .88rem; font-weight: 700; margin-bottom: 10px; letter-spacing: .02em; }
  .guide-heading h1 { font-size: clamp(1.7rem, 3.8vw, 2.55rem); line-height: 1.45; color: #14171c; margin-bottom: 16px; }
  .guide-description { font-size: 1.06rem; line-height: 1.85; color: #4b5058; max-width: 78ch; }
  .guide-meta { color: #5b616a; font-size: .85rem; margin-top: 16px; }
  .guide-toc { background: #f5f4f0; border: 1px solid #dad7ce; border-inline-start: 3px solid #c2410c; border-radius: 4px; padding: 22px 24px; margin: 28px 0; }
  .guide-toc strong { display: block; color: #14171c; font-size: .95rem; margin-bottom: 6px; }
  .guide-toc ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px; margin-top: 10px; }
  .guide-toc a { display: block; padding: 6px 0; color: #14171c; border-bottom: 1px solid #e5e2da; font-weight: 500; font-size: .95rem; }
  .guide-toc a:hover { color: #c2410c; border-color: #c2410c; }
  .guide-content { color: #2b3038; font-size: 1.04rem; line-height: 1.95; overflow-wrap: anywhere; }
  .guide-content h2 { font-size: clamp(1.35rem, 2.8vw, 1.8rem); color: #14171c; margin: 44px 0 16px; line-height: 1.5; scroll-margin-top: 150px; padding-top: 18px; border-top: 1px solid #eae8e1; }
  .guide-content h2:first-child { border-top: 0; padding-top: 0; }
  .guide-content h3 { font-size: 1.15rem; color: #14171c; margin: 24px 0 10px; scroll-margin-top: 150px; }
  .guide-content p { margin: 0 0 18px; }
  .guide-content ul, .guide-content ol { padding-inline-start: 24px; margin: 0 0 22px; }
  .guide-content ul { list-style: disc; }
  .guide-content ol { list-style: decimal; }
  .guide-content li { margin-bottom: 10px; }
  .guide-content a { color: #9a3412; text-decoration: underline; text-underline-offset: 4px; }
  .guide-summary { background: #f5f4f0; border: 1px solid #dad7ce; border-inline-start: 4px solid #c2410c; border-radius: 4px; padding: 22px; }
  .guide-table-wrap { overflow-x: auto; border: 1px solid #dad7ce; border-radius: 4px; margin: 24px 0; }
  .guide-content table { width: 100%; border-collapse: collapse; font-size: .95rem; font-variant-numeric: tabular-nums; }
  .guide-content th { background: #eae8e1; color: #14171c; text-align: right; font-weight: 700; }
  .guide-content th, .guide-content td { padding: 13px 15px; border-bottom: 1px solid #dad7ce; vertical-align: top; }
  .guide-figure { margin: 28px 0; }
  .guide-figure img { display: block; width: min(100%, 580px); max-height: 360px; object-fit: contain; margin: 0 auto; border-radius: 4px; border: 1px solid #dad7ce; background: #f5f4f0; }
  .guide-figure figcaption { margin-top: 10px; color: #5b616a; font-size: .86rem; text-align: center; }
  .measurement-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 24px 0; }
  .measurement-card { border: 1px solid #dad7ce; background: #f5f4f0; border-radius: 4px; padding: 20px; }
  .measurement-card strong { display: block; color: #c2410c; margin-bottom: 8px; }
  .measurement-card p { margin: 0; font-size: .95rem; }
  .guide-sources { border-top: 1px solid #dad7ce; margin-top: 36px; padding-top: 14px; font-size: .9rem; }
  .guide-request { display: flex; align-items: center; justify-content: space-between; gap: 24px; background: #14171c; color: #fff; border-top: 3px solid #c2410c; border-radius: 4px; padding: 30px; margin-top: 44px; }
  .guide-request h2 { font-size: 1.35rem; line-height: 1.5; margin-bottom: 8px; color: #fff; }
  .guide-request p { color: #d6d3cb; line-height: 1.8; margin: 0; }
  .guide-button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 13px 22px; background: #c2410c; color: #fff; border-radius: 4px; font-weight: 700; text-align: center; flex-shrink: 0; }
  .guide-button:hover { background: #9a3412; }
  @media (max-width: 640px) {
    .guide-shell { padding-top: 24px; }
    .guide-toc { padding: 18px; }
    .guide-toc ul, .measurement-cards { grid-template-columns: 1fr; }
    .guide-request { flex-direction: column; align-items: stretch; padding: 22px; }
    .guide-content th, .guide-content td { padding: 10px; }
    .guide-content h2, .guide-content h3 { scroll-margin-top: 90px; }
  }
</style>
