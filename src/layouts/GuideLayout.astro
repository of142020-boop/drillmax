---
import MainLayout from './MainLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
interface Props {
  title: string;
  heading: string;
  description: string;
  path: string;
  published: string;
  image: string;
  toc: {id: string; label: string}[];
  related: {href: string; label: string; desc?: string}[];
}
const {title, heading, description, path, published, image, toc, related} = Astro.props;
const url = new URL(path, 'https://drilmax.com').href;
const modified = '2026-10-22T12:00:00+03:00';
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {'@type': 'Organization', '@id': 'https://drilmax.com/#organization', name: 'Drill Max | دريل ماكس', url: 'https://drilmax.com/', logo: {'@type': 'ImageObject', url: 'https://drilmax.com/images/logodrillmax.png'}},
    {'@type': 'BlogPosting', '@id': `${url}#article`, headline: heading, description, image: new URL(image, 'https://drilmax.com').href, datePublished: published, dateModified: modified, inLanguage: 'ar-EG', mainEntityOfPage: url, author: {'@id': 'https://drilmax.com/#organization'}, publisher: {'@id': 'https://drilmax.com/#organization'}},
    {'@type': 'BreadcrumbList', itemListElement: [
      {'@type':'ListItem', position:1, name:'الرئيسية', item:'https://drilmax.com/'},
      {'@type':'ListItem', position:2, name:'المدونة', item:'https://drilmax.com/blog/'},
      {'@type':'ListItem', position:3, name:heading, item:url},
    ]},
  ],
});
---
<MainLayout title={title} description={description} canonical={url} ogImage={image} schema={schema} ogType="article" articlePublishedTime={published} articleModifiedTime={modified}>
  <div class="guide-shell">
    <nav class="guide-breadcrumb" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true"> / </span><a href="/blog/">المدونة</a></nav>
    <header class="guide-heading">
      <p class="guide-eyebrow">دليل التجهيز والاختيار</p>
      <h1>{heading}</h1>
      <p class="guide-description">{description}</p>
      <p class="guide-meta">إعداد فريق دريل ماكس · آخر تحديث <time datetime={modified}>22 أكتوبر 2026</time></p>
    </header>
    <nav class="guide-toc" aria-label="محتويات الدليل"><strong>في هذا الدليل</strong><ul>{toc.map(item => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul></nav>
    <article class="guide-content"><slot /></article>
    <aside class="guide-request" aria-label="طلب معاينة التركيب">
      <div><h2>تجهّز فتحة تهوية أو تحتاج فني تركيب؟</h2><p>جهّز رقم الموديل، وصورة المكان، ومقاس الفتحة الحالي لتوضيح متطلبات العمل قبل تحديد التكلفة.</p></div>
      <a class="guide-button" href="/contact/">ناقش تفاصيل التركيب</a>
    </aside>
    <RelatedLinks title="أدلة وخدمات مرتبطة" links={related} />
  </div>
</MainLayout>
<style is:global>
  .guide-shell { width: min(100% - 40px, 1000px); margin: 0 auto; padding: 32px 0 64px; }
  .guide-breadcrumb { color: #475569; font-size: .9rem; margin-bottom: 24px; }
  .guide-breadcrumb a { text-decoration: underline; text-underline-offset: 4px; }
  .guide-heading { border-bottom: 1px solid #e2e8f0; padding-bottom: 28px; }
  .guide-eyebrow { color: #9a3412; font-size: .9rem; font-weight: 700; margin-bottom: 12px; }
  .guide-heading h1 { font-size: clamp(1.6rem, 4vw, 2.6rem); line-height: 1.6; color: #1e293b; margin-bottom: 18px; }
  .guide-description { font-size: 1.05rem; line-height: 1.9; color: #475569; }
  .guide-meta { color: #475569; font-size: .85rem; margin-top: 16px; }
  .guide-toc { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin: 28px 0; }
  .guide-toc ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 24px; margin-top: 12px; }
  .guide-toc a { display: block; padding: 8px 0; color: #9a3412; text-decoration: underline; text-underline-offset: 4px; }
  .guide-content { color: #334155; font-size: 1.05rem; line-height: 2; overflow-wrap: anywhere; }
  .guide-content h2 { font-size: clamp(1.35rem, 3vw, 1.8rem); color: #1e293b; margin: 40px 0 16px; line-height: 1.7; scroll-margin-top: 150px; }
  .guide-content h3 { font-size: 1.15rem; color: #1e293b; margin: 24px 0 10px; scroll-margin-top: 150px; }
  .guide-content p { margin: 0 0 18px; }
  .guide-content ul, .guide-content ol { padding-inline-start: 26px; margin: 0 0 22px; }
  .guide-content ul { list-style: disc; }
  .guide-content ol { list-style: decimal; }
  .guide-content li { margin-bottom: 10px; }
  .guide-content a { color: #9a3412; text-decoration: underline; text-underline-offset: 4px; }
  .guide-summary { background: #fff7ed; border-inline-start: 4px solid #c2410c; border-radius: 8px; padding: 22px; }
  .guide-table-wrap { overflow-x: auto; border: 1px solid #cbd5e1; border-radius: 10px; margin: 22px 0; }
  .guide-content table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  .guide-content th { background: #f1f5f9; color: #1e293b; text-align: right; }
  .guide-content th, .guide-content td { padding: 14px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
  .guide-figure { margin: 28px 0; }
  .guide-figure img { display: block; width: min(100%, 560px); max-height: 340px; object-fit: contain; margin: 0 auto; border-radius: 10px; background: #f8fafc; }
  .guide-figure figcaption { margin-top: 10px; color: #475569; font-size: .85rem; text-align: center; }
  .measurement-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 24px 0; }
  .measurement-card { border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 12px; padding: 20px; }
  .measurement-card strong { display: block; color: #9a3412; margin-bottom: 8px; }
  .measurement-card p { margin: 0; font-size: .95rem; }
  .guide-sources { border-top: 1px solid #cbd5e1; margin-top: 36px; padding-top: 12px; font-size: .9rem; }
  .guide-request { display: flex; align-items: center; gap: 24px; background: #1e293b; color: #fff; border-radius: 12px; padding: 28px; margin-top: 40px; }
  .guide-request h2 { font-size: 1.3rem; line-height: 1.8; margin-bottom: 10px; }
  .guide-request p { color: #e2e8f0; line-height: 1.8; }
  .guide-button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 14px 20px; background: #c2410c; color: #fff; border-radius: 8px; font-weight: 700; text-align: center; flex-shrink: 0; }
  .guide-button:hover { background: #9a3412; }
  @media (max-width: 640px) {
    .guide-shell { padding-top: 24px; }
    .guide-toc { padding: 18px; }
    .guide-toc ul, .measurement-cards { grid-template-columns: 1fr; }
    .guide-request { flex-direction: column; align-items: stretch; padding: 22px; }
    .guide-content th, .guide-content td { padding: 10px; }
    .guide-content h2, .guide-content h3 { scroll-margin-top: 90px; }
  }
</style>
