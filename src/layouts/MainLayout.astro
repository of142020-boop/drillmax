---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: string;
  phoneNumber?: string;
}

const { 
  title, 
  description = "محتاج صنايعي كور أو فني منشار؟ Drill Max هي شركة رائدة لخدمات \"قص وتخريم خرسانة\" بالكور والمنشار الماسي لعمل فتحات الغاز والتكييف والتعديلات المعمارية.",
  canonical,
  ogImage = "https://drilmax.com/wp-content/uploads/2025/09/logo-1.webp",
  schema,
  phoneNumber = "01070046464"
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || "https://drilmax.com").toString();
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/logodrillmax.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <!-- JSON-LD Schema -->
    {schema && <script type="application/ld+json" set:html={schema} />}
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="top-bar">
      <div class="container top-bar-container">
        <div class="top-bar-contact">
          <span>لديك أي استفسار؟</span>
          <span>📞 <a href="tel:+201070046464" dir="ltr">{phoneNumber}<//a></span>
          <span>📧 <a href="mailto:support@drilmax.com">support@drilmax.com</a></span>
        </div>
        <div class="top-bar-social">
          <!-- Add social links here when available -->
        </div>
      </div>
    </div>
    <header class="main-header">
      <div class="container header-container">
        <a href="/" class="logo">
          <img src="/images/logodrillmax.png" alt="Drill Max Logo" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'120\\' height=\\'40\\'><text x=\\'0\\' y=\\'30\\' font-size=\\'30\\' fill=\\'%23ffffff\\' font-weight=\\'bold\\' font-family=\\'Arial\\'>Drill Max</text></svg>'"/>
        </a>
        <nav class="main-nav">
          <ul>
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/services/">خدماتنا</a></li>
            <li><a href="/core-drilling-%d8%b5%d9%86%d8%a7%d9%8a%d8%b9%d9%8a-%d9%83%d9%88%d8%b1/">الكور</a></li>
            <li><a href="/saw-cutting%d9%82%d8%b5-%d8%ae%d8%b1%d8%b3%d8%a7%d9%86%d8%a9/">المنشار</a></li>
            <li><a href="/%d9%82%d8%b5-%d8%a7%d9%84%d8%ae%d8%b1%d8%b3%d8%a7%d9%86%d8%a9-%d8%a8%d8%a7%d9%84%d9%88%d8%a7%d9%8a%d8%b1/">الواير</a></li>
            <li><a href="/%d8%aa%d8%b2%d8%b1%d9%8a%d8%b9-%d8%a7%d9%84%d8%a7%d8%b4%d8%a7%d9%8a%d8%b1/">تزريع</a></li>
            <li><a href="/%d9%81%d9%86%d9%8a-%d8%b4%d9%81%d8%a7%d8%b7%d8%a7%d8%aa/">شفاطات</a></li>
            <li><a href="/prices/">الاسعار</a></li>
          </ul>
        </nav>
        <a href="/contact/" class="cta-header-btn hide-on-mobile">تواصل معنا</a>
        <button class="mobile-menu-btn" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Floating Call Button -->
    <a href={`tel:${phoneNumber}`} class="floating-call" aria-label="اتصل بنا">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor"><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"/></svg>
    </a>

    <!-- Scroll to Top Button -->
    <button class="scroll-to-top" aria-label="للأعلى" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" fill="currentColor"><path d="M214.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L160 141.2V448c0 17.7 14.3 32 32 32s32-14.3 32-32V141.2L329.4 246.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-160-160z"/></svg>
    </button>

    <!-- Floating WhatsApp Button -->
    <a href={`https://wa.me/2${phoneNumber}`} class="floating-whatsapp" target="_blank" rel="noopener noreferrer" aria-label="تواصل معنا عبر واتساب">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor">
        <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157.1zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
      </svg>
    </a>

    <footer class="main-footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <img src="/images/logodrillmax.png" alt="Drill Max Logo" style="height: 60px; margin-bottom: 20px;" onerror="this.style.display='none'" />
          <p>شركة متخصصة في خدمات قص وتخريم الخرسانة المسلحة بأحدث التقنيات الهندسية لضمان الدقة والأمان.</p>
          <div style="margin-top: 20px;">
            <p style="margin-bottom:10px;">📞 <a href="tel:+201070046464" dir="ltr" style="color:var(--primary); font-weight:bold;">{phoneNumber}<//a></p>
            <p>📧 <a href="mailto:support@drilmax.com" style="color:var(--primary);">support@drilmax.com</a></p>
          </div>
        </div>
        <div class="footer-links">
          <h4>الخدمات الرئيسية</h4>
          <ul>
            <li><a href="/core-drilling-%d8%b5%d9%86%d8%a7%d9%8a%d8%b9%d9%8a-%d9%83%d9%88%d8%b1/">تخريم الخرسانة (كور)</a></li>
            <li><a href="/saw-cutting%d9%82%d8%b5-%d8%ae%d8%b1%d8%b3%d8%a7%d9%86%d8%a9/">قص الخرسانة بالمنشار</a></li>
            <li><a href="/%d9%82%d8%b5-%d8%a7%d9%84%d8%ae%d8%b1%d8%b3%d8%a7%d9%86%d8%a9-%d8%a8%d8%a7%d9%84%d9%88%d8%a7%d9%8a%d8%b1/">قص الخرسانة بالواير</a></li>
            <li><a href="/%d8%aa%d8%b2%d8%b1%d9%8a%d8%b9-%d8%a7%d9%84%d8%a7%d8%b4%d8%a7%d9%8a%d8%b1/">تزريع الأشاير</a></li>
            <li><a href="/%d9%81%d9%86%d9%8a-%d8%b4%d9%81%d8%a7%d8%b7%d8%a7%d8%aa/">تركيب الشفاطات</a></li>
          </ul>
        </div>
        <div class="footer-links">
          <h4>روابط سريعة</h4>
          <ul>
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/projects/">كل المشاريع</a></li>
            <li><a href="/prices/">الأسعار</a></li>
            <li><a href="/contact/">تواصل معنا</a></li>
            <li><a href="/privacy-policy/">سياسة الخصوصية</a></li>
            <li><a href="/terms-condition/">الشروط والأحكام</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Drill Max. جميع الحقوق محفوظة.</p>
      </div>
    </footer>
  
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile Menu
    const menuBtn = document.querySelector('.mobile-menu-btn');
    const nav = document.querySelector('.main-nav');
    if (menuBtn && nav) {
      menuBtn.addEventListener('click', () => {
        nav.classList.toggle('active');
        
        // Animate hamburger
        const spans = menuBtn.querySelectorAll('span');
        if (nav.classList.contains('active')) {
          spans[0].style.transform = 'rotate(45deg) translate(6px, 6px)';
          spans[1].style.opacity = '0';
          spans[2].style.transform = 'rotate(-45deg) translate(6px, -7px)';
        } else {
          spans[0].style.transform = 'none';
          spans[1].style.opacity = '1';
          spans[2].style.transform = 'none';
        }
      });
    }

    // Scroll to Top
    const scrollBtn = document.querySelector('.scroll-to-top');
    if (scrollBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          scrollBtn.classList.add('visible');
        } else {
          scrollBtn.classList.remove('visible');
        }
      });
    }
  });
</script>
</body>

</html>

<style is:global>
  :root {
    --primary: #ff5722; /* Orange */
    --primary-hover: #e64a19;
    --secondary: #ffffff; /* White */
    --dark: #1e293b; /* Dark text */
    --header-bg: #1e2530; /* Dark Charcoal for header */
    --topbar-bg: #161b22; /* Even darker for top bar */
    --light: #f8fafc;
    --gray: #64748b;
    --bg-color: #ffffff;
    --section-bg: #f9fafb; /* Light gray section background */
    --card-bg: #ffffff;
    --border-color: #e2e8f0;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: 'Cairo', sans-serif;
    background-color: var(--bg-color);
    color: var(--dark);
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
  }

  a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  ul {
    list-style: none;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Top Bar */
  .top-bar {
    background-color: var(--topbar-bg);
    color: #cbd5e1;
    font-size: 0.85rem;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .top-bar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .top-bar-contact {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .top-bar-social {
    display: flex;
    gap: 15px;
  }
  .top-bar a {
    color: #cbd5e1;
  }
  .top-bar a:hover {
    color: var(--primary);
  }

  /* Header */
  .main-header {
    background: var(--header-bg);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 90px;
    max-width: 100%;
    padding: 0 40px;
  }

  .logo img {
    height: 45px;
    display: block;
  }

  .main-nav ul {
    display: flex;
    gap: 25px;
    align-items: center;
  }

  .main-nav a {
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .main-nav a:hover {
    color: var(--primary);
  }

  .cta-header-btn {
    background: var(--primary);
    color: #fff;
    padding: 10px 24px;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 4px;
    transition: background 0.3s;
  }
  .cta-header-btn:hover {
    background: var(--primary-hover);
  }

  /* Footer */
  .main-footer {
    background: var(--header-bg);
    padding: 80px 0 20px;
    color: #cbd5e1;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }



  .footer-brand h3 {
    font-size: 2rem;
    color: #fff;
    margin-bottom: 15px;
  }

  .footer-brand p {
    color: #cbd5e1;
    line-height: 1.8;
    max-width: 400px;
  }

  .footer-links h4 {
    font-size: 1.3rem;
    margin-bottom: 20px;
    color: #fff;
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    color: #cbd5e1;
  }

  .footer-links a:hover {
    color: var(--primary);
    padding-right: 5px;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 20px;
    margin-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #94a3b8;
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none; /* Mobile menu needed, hiding for simplicity in V1 */
    }
    .footer-content {
      grid-template-columns: 1fr;
    }
  }

  /* Floating WhatsApp */
  .floating-whatsapp {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 60px;
    height: 60px;
    background-color: #25d366;
    color: white;
    border-radius: 50px;
    text-align: center;
    font-size: 30px;
    box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.15);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }
  .floating-whatsapp:hover {
    transform: scale(1.1);
  }
  .floating-whatsapp svg {
    width: 35px;
    height: 35px;
  }

  /* Floating Buttons */
  .floating-call {
    position: fixed;
    bottom: 20px;
    left: 20px;
    width: 60px;
    height: 60px;
    background-color: var(--primary);
    color: white;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    z-index: 1000;
    transition: transform 0.3s ease;
  }
  .floating-call svg { width: 25px; height: 25px; }
  .floating-call:hover { transform: scale(1.1); }

  .scroll-to-top {
    position: fixed;
    bottom: 90px;
    left: 20px;
    width: 50px;
    height: 50px;
    background-color: var(--header-bg);
    color: white;
    border: none;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    z-index: 1000;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0;
    visibility: hidden;
  }
  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
  }
  .scroll-to-top svg { width: 20px; height: 20px; }
  .scroll-to-top:hover { background-color: var(--primary); }

  /* Mobile Responsive */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 10px;
  }
  .mobile-menu-btn span {
    display: block;
    width: 30px;
    height: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 2px;
  }
  .hide-on-mobile { display: block; }

  @media (max-width: 992px) {
    .top-bar { display: none; }
    .top-bar-contact {
      flex-direction: column;
      gap: 10px;
      align-items: center;
      width: 100%;
    }
    .top-bar-contact span { font-size: 0.9rem; }
    .hide-on-mobile { display: none !important; }
    .mobile-menu-btn { display: flex; }

    .header-container {
      position: relative;
    }
    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--header-bg);
      flex-direction: column;
      display: none;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      z-index: 999;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .main-nav.active {
      display: flex;
    }
    .main-nav ul {
      flex-direction: column;
      width: 100%;
    }
    .main-nav ul li {
      width: 100%;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .main-nav ul li a {
      display: block;
      padding: 15px;
    }
    .footer-content {
      flex-direction: column;
      text-align: center;
      gap: 30px;
    }
  }
</style>

