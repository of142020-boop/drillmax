    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll<HTMLImageElement>('[data-hide-on-error]').forEach((image) => {
          image.addEventListener('error', () => { image.style.display = 'none'; });
        });
        document.querySelectorAll<HTMLImageElement>('[data-logo-fallback]').forEach((image) => {
          image.addEventListener('error', () => {
            const label = document.createElement('span');
            label.textContent = image.alt || 'Drill Max';
            image.replaceWith(label);
          }, { once: true });
        });
        const menuBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn');
        const nav = document.querySelector<HTMLElement>('.main-nav');
        if (menuBtn && nav) {
          const setMenu = (open: boolean) => {
            nav.classList.toggle('active', open);
            menuBtn.setAttribute('aria-expanded', String(open));
            menuBtn.setAttribute('aria-label', open ? 'إغلاق القائمة' : 'فتح القائمة');
          };
          menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
          nav.addEventListener('click', (event) => {
            if ((event.target as HTMLElement).closest('a')) setMenu(false);
          });
          document.addEventListener('click', (event) => {
            if (!nav.contains(event.target as Node) && !menuBtn.contains(event.target as Node)) setMenu(false);
          });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
              setMenu(false);
              menuBtn.focus();
            }
          });
          const desktop = window.matchMedia('(min-width: 993px)');
          desktop.addEventListener('change', () => setMenu(false));
        }

        // Scroll to Top
        const scrollBtn = document.querySelector('.scroll-to-top');
        if (scrollBtn) {
          scrollBtn.addEventListener('click', () => window.scrollTo({top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'}));
          window.addEventListener('scroll', () => {
            if (window.scrollY > 300) {
              scrollBtn.classList.add('visible');
            } else {
              scrollBtn.classList.remove('visible');
            }
          });
        }
      });
    </script>
  </body>

</html>

<style is:global>
  h1 .heading-contact { display: inline-block; font-size: 0.7em; white-space: nowrap; }
  :root {
    --primary: #c2410c; /* Accessible Industrial Orange */
    --primary-hover: #9a3412;
    --secondary: #ffffff;
    --dark: #14171c; /* Foundry Charcoal Ink */
    --header-bg: #111419; /* Matte Deep Steel */
    --topbar-bg: #0b0d10;
    --light: #f5f4f0; /* Warm Architectural Concrete */
    --surface-muted: #eae8e1;
    --gray: #4b5058; /* Neutral Graphite */
    --bg-color: #ffffff;
    --section-bg: #f5f4f0; /* Warm Concrete Section Surface */
    --card-bg: #ffffff;
    --border-color: #dad7ce; /* Architectural Hairline */
    --font-display: 'Cairo', 'IBM Plex Sans Arabic', sans-serif;
    --font-body: 'IBM Plex Sans Arabic', 'Cairo', sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-body);
    background-color: var(--bg-color);
    color: var(--dark);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  body {
    overflow-x: clip;
  }

  .skip-link { position: fixed; top: -100px; right: 20px; padding: 12px 20px; background: #fff; color: #1e293b; z-index: 10000; border: 2px solid var(--primary); border-radius: 6px; }
  .skip-link:focus { top: 12px; }
  :focus-visible { outline: 3px solid var(--primary); outline-offset: 3px; }
  .post-grid > *, .related-grid > * { min-width: 0; }
  .post-body-text { overflow-wrap: anywhere; }
  .post-body-text img, .post-body-text figure { max-width: 100%; height: auto; }
  .post-body-text table { display: block; max-width: 100%; overflow-x: auto; }
  .post-body-text :is(h2,h3,h4,p,li) { min-width: 0; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
  }

  a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  ul {
    list-style: none;
  }

  .container {
    width: 100%;
