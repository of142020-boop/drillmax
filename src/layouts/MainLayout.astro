---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: string;
  phoneNumber?: string;
  preloadImage?: string;
  noindex?: boolean;
  keywords?: string;
  ogType?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  nofollow?: boolean;
}

const { 
  title, 
  description = "محتاج صنايعي كور أو فني منشار؟ Drill Max هي شركة رائدة لخدمات \"قص وتخريم خرسانة\" بالكور والمنشار الماسي لعمل فتحات الغاز والتكييف والتعديلات المعمارية.",
  canonical,
  ogImage = "/images/logodrillmax.png",
  schema,
  phoneNumber = "01070046464",
  preloadImage,
  noindex = false,
  keywords = "قص وتخريم خرسانة, صنايعي كور, فتحات كور, منشار قص خرسانة, كور دريل, تخريم خرسانة, فتحات تكييف, فتحات غاز, دريل ماكس, Drill Max",
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  nofollow = false,
} = Astro.props;

// Render contact details on the server so crawlers and visitors see the same text.
const contactNumber = phoneNumber.replace(/\D/g, '');
const withContactNumber = (text: string) =>
  noindex || text.includes(contactNumber) ? text : `${text} | ${contactNumber}`;
const contactTitle = withContactNumber(title);
const contactDescription = withContactNumber(description);
const pageContent = await Astro.slots.render('default');
const contentWithContact = noindex
  ? pageContent
  : pageContent.replace(/(<h1\b[^>]*>)([\s\S]*?)(<\/h1>)/gi,
      (_match, open: string, content: string, close: string) =>
        content.replace(/<[^>]*>/g, '').includes(contactNumber)
          ? `${open}${content}${close}`
          : `${open}${content} <bdi class="heading-contact" dir="ltr">${contactNumber}</bdi>${close}`);

const canonicalURL = new URL(canonical || Astro.url.pathname, Astro.site || "https://drilmax.com");
canonicalURL.search = "";
canonicalURL.hash = "";
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `https://drilmax.com${ogImage}`;

// Robots directives
const robotsDirectives = [
  noindex ? "noindex" : "index",
  nofollow ? "nofollow" : "follow",
  "max-image-preview:large",
  "max-snippet:-1",
  "max-video-preview:-1",
].join(", ");
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
