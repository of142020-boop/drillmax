const contentHtml = "<p>قبل طلب فتحة في جدار أو سقف، حدد استخدامها ومقاساتها ونوع العنصر وموقع الخدمات القريبة. تختلف تجهيزات فتحة ماسورة عن فتحة باب، ولا يكفي اسم المعدة للحكم على ملاءمة التنفيذ أو سلامة التعديل.</p>\n<h2>الكور أم المنشار: ما الفرق؟</h2><p>ينفذ الكور فتحات دائرية لمرور المواسير والكابلات وفق القطر المطلوب. ويُراجع المنشار لخطوط القطع المستقيمة وفتحات الأبواب والنوافذ وتعديل أبعادها. يتوقف الاختيار على السماكة وإمكانية الوصول والتثبيت وخطة فصل الجزء ورفعه.</p>\n<p>الكور والقص عمليتان تنتجان صوتًا ومخلفات، ويُستخدم الماء في كثير من أعمال التبريد. تُراجع حماية التشطيبات واحتواء المياه ومواعيد التشغيل المناسبة، ولا يُوعد بغياب الغبار أو الاهتزاز أو الحاجة إلى إصلاح التشطيب في كل موقع.</p>\n<h2>ما الذي تحدده قبل اختيار الفني؟</h2><ul><li>صور موضع العمل من الجانبين والمقاسات والسماكات إن كانت معروفة.</li><li>نوع الجدار أو البلاطة وموقع الكهرباء والسباكة والغاز القريب.</li><li>المخططات وموافقة المهندس للتعديلات في العناصر الإنشائية.</li><li>مساحة تثبيت المعدة ومسار التحميل ورفع الأجزاء المفصولة عند الحاجة.</li></ul>\n<p>للطلبات في المدن الجديدة، راجع تفاصيل <a href=\"/october-zayed-concrete-cutting-core/\">خدمات دريل ماكس في أكتوبر والشيخ زايد</a>، واذكر اسم الكمبوند والطابق وتصاريح ومواعيد الدخول المطلوبة. يُؤكد نطاق الخدمة والانتقال بعد مراجعة الموقع.</p>\n<h2>استخدامات الفتحات ومراجعة المقاس</h2><p>تشمل الطلبات فتحات التكييف والسباكة والكهرباء والتهوية. يحدد فني التمديدات أو المختص بالجهاز القطر والمسار؛ لا تُختار فتحة الغاز أو المدخنة من مقاس شائع على الإنترنت. إذا تطلب الموضع تعديل كمرة أو بلاطة أو عنصر حامل، يلزم اعتماد المهندس المسؤول قبل التخريم.</p>\n<figure id=\"attachment_2211\" aria-describedby=\"caption-attachment-2211\" style=\"width:100%;max-width:100%\" class=\"wp-caption aligncenter\"><img width=\"1080\" height=\"1106\" loading=\"lazy\" decoding=\"async\" class=\"size-medium wp-image-2211\" src=\"/images/صنايعي-كور-في-التجمع.webp\" alt=\"صنايعي كور في التجمع\"  srcset=\"/images/صنايعي-كور-في-التجمع.webp 293w, /images/صنايعي-كور-في-التجمع.webp 1000w, /images/صنايعي-كور-في-التجمع.webp 768w, /images/صنايعي-كور-في-التجمع.webp 1080w\" sizes=\"(max-width: 293px) 100vw, 293px\" /><figcaption id=\"caption-attachment-2211\" class=\"wp-caption-text\">تخريم صبات</figcaption></figure><h2>كيف تقارن عروض العمل؟</h2><p>قارن العروض على الكميات والأقطار والسماكات نفسها، وافصل التجهيز والتدعيم والرفع ونقل المخلفات والتشطيب إن كانت مطلوبة. اطلب توضيح البنود المشمولة والمستثناة، وراجع أمثلة أعمال موثقة ومناسبة لطبيعة طلبك بدل الاعتماد على اسم الماكينة أو وعد عام.</p>\n<p>يمكن البدء من <a href=\"/core-drilling-صنايعي-كور/\">تفاصيل خدمة تخريم الكور</a> أو <a href=\"/saw-cuttingقص-خرسانة/\">خدمة القص بالمنشار</a>، ومراجعة <a href=\"/prices/\">عوامل التكلفة</a> قبل إرسال الصور والمقاسات للحصول على تقدير نطاق العمل.</p>";
const relatedPosts = [{"title":"أسعار ماكينة كور تخريم الخرسانة هل الشراء أفضل أم الاعتماد على مقاول؟","url":"/أسعار-ماكينة-كور-تخريم-الخرسانة/","image":"/images/أسعار-ماكينة-كور-تخريم-الخرسانة.webp"},{"title":"أفضل اسعار فتحات الكور في مصر (اطلب عرض سعر) 01070046464","url":"/اسعار-فتحات-الكور/","image":"/images/اسعار-فتحات-الكور-scaled.webp"},{"title":"شركة قص وتخريم الخرسانة المسلحة بدون اهتزازات","url":"/قص-وتخريم-الخرسانة-المسلحة/","image":"/images/قص-وتخريم-الخرسانة-المسلحة-scaled.webp"}];
