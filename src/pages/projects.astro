---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="مشاريعنا تتحدث عن خبرتنا في قص وتخريم خرسانة | Drill Max" 
  description="شاهد دقة واحترافية عملنا في مشاريع حقيقية. نستعرض هنا مجموعة من مشاريعنا التي تبرز جودة خدماتنا في قص وتخريم الخرسانة."
>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
        <span class="hero-subtitle">dRILL MAX | كل المشاريع</span>
        <h1 style="text-align: center; font-size: 3.5rem;">مشاريعنا تتحدث عن خبرتنا</h1>
        <p style="text-align: center; font-size: 1.3rem;">شاهد دقة واحترافية عملنا في مشاريع حقيقية. نستعرض هنا مجموعة من مشاريعنا التي تبرز جودة خدماتنا في قص وتخريم الخرسانة، وتعكس ثقة عملائنا في الدقة التي نقدمها.</p>
      </div>
    </div>
  </section>

  <!-- PROJECTS GALLERY -->
  <section class="py-section bg-light">
    <div class="container">
      <div class="section-header text-center mb-5">
        <h2 style="font-size: 2.5rem; color: var(--dark);">معرض المشاريع</h2>
        <p style="color: var(--gray); font-size: 1.1rem;">مجموعة من أعمالنا في قص وتخريم الخرسانة</p>
      </div>
      
      <div class="projects-grid">
        <!-- Project 1 -->
        <div class="project-card shadow-hover">
          <div class="project-img">
            <img src="/images/saw-cutting-1.webp" alt="قص جدار خرساني بمنشار حائطي" />
            <div class="project-category">قص بالمنشار</div>
          </div>
          <div class="project-content">
            <h3>قص جدار خرساني بمنشار حائطي</h3>
            <p>استخدام منشار جداري مثبت على مسار لتنفيذ قص دقيق ومستقيم في حائط خرساني مسلح لعمل تعديل معماري.</p>
            <ul class="project-highlights">
              <li><strong>الموقع:</strong> التجمع الخامس، القاهرة</li>
              <li><strong>سمك الجدار:</strong> 25 سم</li>
            </ul>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="project-card shadow-hover">
          <div class="project-img">
            <img src="/images/core-1.webp" alt="فتحة كور أفقية بقطر كبير" />
            <div class="project-category">كور دريل</div>
          </div>
          <div class="project-content">
            <h3>فتحة كور أفقية بقطر كبير</h3>
            <p>تنفيذ فتحة كور أفقية بقطر كبير في جدار خرساني لتمرير تمديدات صناعية رئيسية، مع الحفاظ على نظافة الموقع.</p>
            <ul class="project-highlights">
              <li><strong>الموقع:</strong> مشروع سكني، الشيخ زايد</li>
              <li><strong>قطر الفتحة:</strong> 8 بوصة</li>
            </ul>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="project-card shadow-hover">
          <div class="project-img">
            <img src="/images/wire-saw-3.webp" alt="عمل فواصل تمدد للأرضيات" />
            <div class="project-category">قص رطب</div>
          </div>
          <div class="project-content">
            <h3>عمل فواصل تمدد للأرضيات</h3>
            <p>تنفيذ عملية قص رطب باستخدام منشار أرضي لعمل فواصل تمدد، مما يمنع التشققات المستقبلية ويضمن متانة الأرضية الخرسانية.</p>
            <ul class="project-highlights">
              <li><strong>الموقع:</strong> منطقة صناعية، 6 أكتوبر</li>
              <li><strong>عمق القص:</strong> 15 سم</li>
            </ul>
          </div>
        </div>

        <!-- Project 4 -->
        <div class="project-card shadow-hover">
          <div class="project-img">
            <img src="/images/core-worker-1.webp" alt="تخريم مائل في درج خرساني" />
            <div class="project-category">تخريم الخرسانة</div>
          </div>
          <div class="project-content">
            <h3>تخريم مائل في درج خرساني</h3>
            <p>مشروع تطلب حفرًا مائلاً بزاوية محددة في درج خرساني مسلح لتمرير تمديدات خاصة، مما يوضح قدرتنا على التعامل مع المهام الصعبة.</p>
            <ul class="project-highlights">
              <li><strong>الموقع:</strong> فيلا خاصة، الساحل الشمالي</li>
              <li><strong>زاوية الحفر:</strong> 45 درجة</li>
            </ul>
          </div>
        </div>

        <!-- Project 5 -->
        <div class="project-card shadow-hover">
          <div class="project-img">
            <img src="/images/demolition.webp" alt="إنشاء فتحة مصعد في سقف خرساني" />
            <div class="project-category">قص سقف خرساني</div>
          </div>
          <div class="project-content">
            <h3>إنشاء فتحة مصعد في سقف خرساني</h3>
            <p>مشروع قص سقف خرساني مسلح بالكامل لإنشاء فتحة لمصعد جديد، تم التنفيذ بدقة متناهية للحفاظ على السلامة الإنشائية للمبنى.</p>
            <ul class="project-highlights">
              <li><strong>الموقع:</strong> مدينتي، القاهرة</li>
              <li><strong>أبعاد الفتحة:</strong> 2م × 2.5م</li>
            </ul>
          </div>
        </div>

        <!-- Project 6 -->
        <div class="project-card shadow-hover">
          <div class="project-img">
            <img src="/images/core-drill-1.webp" alt="استخراج عينات خرسانية للاختبار" />
            <div class="project-category">عينات خرسانية</div>
          </div>
          <div class="project-content">
            <h3>استخراج عينات خرسانية للاختبار</h3>
            <p>استخدام تقنية الكور دريل لاستخراج عينات أسطوانية نظيفة من الهيكل الخرساني لأغراض الفحص والاختبار الهندسي.</p>
            <ul class="project-highlights">
              <li><strong>الموقع:</strong> مشروع كوبري، العاصمة الإدارية</li>
              <li><strong>عمق العينة:</strong> 40 سم</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="py-section">
    <div class="container" style="max-width: 900px;">
      <div class="section-header text-center mb-5">
        <h2 style="font-size: 2.2rem; color: var(--dark);">دراسات حالة: حلول هندسية لمشاريع حقيقية</h2>
        <p style="color: var(--gray); font-size: 1.15rem; line-height: 1.9;">
          في Drill Max، نؤمن بأن كل مشروع هو أكثر من مجرد عملية قص أو تخريم؛ إنه تحدٍ هندسي يتطلب تخطيطًا دقيقًا وتنفيذًا احترافيًا. هذه الصفحة ليست مجرد معرض للصور، بل هي سجل موثق لمشاريع حقيقية قمنا بتنفيذها.
        </p>
      </div>

      <div class="case-studies">
        <!-- Case Study 1 -->
        <div class="case-study-box">
          <h3>1. مشروع تعديل معماري كبير في الشيخ زايد</h3>
          <div class="case-meta"><strong>نوع المشروع:</strong> تعديل هيكلي سكني (قص بالمنشار)</div>
          <div class="case-content">
            <p><strong>التحدي:</strong> أراد العميل إعادة تصميم المساحة الداخلية لفيلا قائمة، الأمر الذي تطلب إزالة سلم خرساني مسلح بالكامل لدمج طابقين وتوسعة مساحة الاستقبال. كان التحدي الأكبر هو تنفيذ عملية القص بدقة متناهية دون التأثير على السلامة الإنشائية للأعمدة والأسقف المجاورة.</p>
            <p><strong>الحل الهندسي:</strong> قام فريقنا من <a href="/saw-cuttingقص-خرسانة/">فنيي المنشار</a> المحترفين بدراسة المخططات الهندسية وتحديد أفضل مسار للقص. باستخدام المنشار الجداري الماسي المثبت على مسار، تمكنا من تنفيذ عملية القص بشكل نظيف ومستقيم تمامًا، مع الحفاظ على حواف ناعمة لا تتطلب أي ترميم. تم تفكيك السلم الخرساني وإزالته بأمان، مما سمح للمقاول باستكمال أعمال التشطيبات بسلاسة.</p>
            <p><strong>النتيجة:</strong> تحولت المساحة بالكامل وأصبحت أكثر اتساعًا وحداثة، مع الحفاظ الكامل على قوة ومتانة الهيكل الخرساني للمبنى.</p>
          </div>
        </div>

        <!-- Case Study 2 -->
        <div class="case-study-box">
          <h3>2. مشروع فتحات مداخن وهوايات صناعية لمصنع بمدينة 6 أكتوبر</h3>
          <div class="case-meta"><strong>نوع المشروع:</strong> فتحات تهوية صناعية (تخريم بالكور)</div>
          <div class="case-content">
            <p><strong>التحدي:</strong> احتاج أحد المصانع الكبرى إلى تركيب نظام تهوية جديد يتطلب عمل فتحات كور بأقطار كبيرة في أسقف خرسانية مسلحة بكثافة. كان من الضروري تنفيذ العمل دون إيقاف خطوط الإنتاج ودون التسبب في أي غبار قد يؤثر على المعدات الحساسة في المصنع.</p>
            <p><strong>الحل الهندسي:</strong> باستخدام ماكينات الكور دريل المثبتة على حوامل، تمكنا من تحديد أماكن الفتحات بدقة متناهية. تم الاعتماد على تقنية القص الرطب، حيث يتم استخدام الماء لتبريد بنطة الكور ومنع تطاير الغبار تمامًا. قام <a href="/core-drilling-صنايعي-كور/">صنايعي الكور</a> لدينا بتنفيذ جميع الفتحات المطلوبة بسرعة وكفاءة، مما ضمن استمرارية العمل في المصنع.</p>
            <p><strong>النتيجة:</strong> تم تجهيز جميع الفتحات المطلوبة للمداخن والهوايات بالمقاسات الدقيقة، مع الحفاظ على بيئة عمل نظيفة وآمنة، وبدون أي تأثير على سير العمل في المصنع.</p>
          </div>
        </div>

        <!-- Case Study 3 -->
        <div class="case-study-box">
          <h3>3. مشروع فتحات تكييف وغاز في فيلا بالتجمع الخامس</h3>
          <div class="case-meta"><strong>نوع المشروع:</strong> فتحات تشطيبات سكنية (تخريم بالكور)</div>
          <div class="case-content">
            <p><strong>التحدي:</strong> أثناء مرحلة التشطيبات النهائية لفيلا فاخرة، احتاج العميل إلى عمل مجموعة من الفتحات الدقيقة لتمرير مواسير التكييف المركزي، الغاز الطبيعي، وتمديدات السباكة والصرف، مع شرط أساسي وهو عدم التسبب في أي ضرر أو تكسير للجدران التي تم تشطيبها بالفعل.</p>
            <p><strong>الحل الهندسي:</strong> قام فريقنا بتنفيذ جميع الفتحات المطلوبة باستخدام الكور الماسي. تم عمل فتحات الغاز وفتحات التكييف بالأقطار والميول المحددة بدقة، مما ضمن فتحات نظيفة وناعمة سهلت على الفنيين الآخرين تركيب تمديداتهم بسهولة.</p>
            <p><strong>النتيجة:</strong> تم تنفيذ جميع الفتحات المطلوبة بدون أي تكسير أو اهتزازات، مما حافظ على جودة التشطيبات ووفر على العميل تكاليف الترميم والإصلاح.</p>
          </div>
        </div>
      </div>
      
      <div class="text-center mt-5">
         <a href="/contact/" class="btn btn-primary">اطلب عرض سعر الآن</a>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  /* Base & Utility */
  .py-section { padding: 80px 0; }
  .bg-light { background-color: var(--section-bg); }
  .text-center { text-align: center; }
  .mb-5 { margin-bottom: 40px; }
  .mt-5 { margin-top: 40px; }

  .btn {
    display: inline-block;
    padding: 14px 30px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.3s, color 0.3s, transform 0.3s;
    border: none;
    text-align: center;
    text-decoration: none;
  }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); }

  /* Hero Section */
  .hero {
    position: relative;
    height: 45vh;
    min-height: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: url('/images/Untitled-134.webp') center/cover no-repeat;
    z-index: 1;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to right, rgba(30, 37, 48, 0.7), rgba(30, 37, 48, 0.95));
  }
  .hero-container {
    position: relative;
    z-index: 2;
  }
  .hero-subtitle {
    color: var(--primary);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 15px;
    display: block;
    text-transform: uppercase;
  }
  .hero h1 {
    color: #fff;
    line-height: 1.3;
    margin-bottom: 20px;
    font-weight: 800;
  }
  .hero p {
    color: #cbd5e1;
    line-height: 1.8;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 30px;
  }
  .project-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
  }
  .shadow-hover {
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .shadow-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.08);
  }
  .project-img {
    position: relative;
    height: 220px;
  }
  .project-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-category {
    position: absolute;
    top: 15px;
    right: 15px;
    background: var(--primary);
    color: #fff;
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .project-content {
    padding: 25px;
  }
  .project-content h3 {
    color: var(--dark);
    font-size: 1.3rem;
    margin-bottom: 10px;
  }
  .project-content p {
    color: var(--gray);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 15px;
  }
  .project-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-color);
    padding-top: 15px;
  }
  .project-highlights li {
    font-size: 0.9rem;
    color: var(--gray);
    margin-bottom: 5px;
  }
  .project-highlights li strong {
    color: var(--dark);
  }

  /* Case Studies */
  .case-studies {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .case-study-box {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.02);
  }
  .case-study-box h3 {
    color: var(--primary);
    font-size: 1.6rem;
    margin-bottom: 10px;
  }
  .case-meta {
    display: inline-block;
    background: var(--section-bg);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.95rem;
    color: var(--dark);
    margin-bottom: 20px;
  }
  .case-content p {
    color: var(--gray);
    line-height: 1.9;
    margin-bottom: 15px;
    font-size: 1.05rem;
  }
  .case-content p strong {
    color: var(--dark);
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2.2rem !important; }
    .py-section { padding: 40px 0; }
    .hero { min-height: 250px; }
    .case-study-box { padding: 25px; }
  }
</style>
