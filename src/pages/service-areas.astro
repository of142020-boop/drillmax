        "alternateName": "دريل ماكس",
        "publisher": { "@id": "https://drilmax.com/#organization" },
        "inLanguage": "ar"
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://drilmax.com/service-areas/#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "item": { "@id": "https://drilmax.com", "name": "الرئيسية" } },
          { "@type": "ListItem", "position": 2, "item": { "@id": "https://drilmax.com/service-areas/", "name": "مناطق الخدمة" } }
        ]
      },
      {
        "@type": "WebPage",
        "@id": "https://drilmax.com/service-areas/#webpage",
        "url": "https://drilmax.com/service-areas/",
        "name": "مناطق خدمة قص وتخريم الخرسانة | دريل ماكس",
        "description": "تفاصيل مناطق خدمة دريل ماكس لقص وتخريم الخرسانة في القاهرة الكبرى والمحافظات.",
        "inLanguage": "ar",
        "isPartOf": { "@id": "https://drilmax.com/#website" },
        "about": { "@id": "https://drilmax.com/#organization" },
        "breadcrumb": { "@id": "https://drilmax.com/service-areas/#breadcrumb" }
      }
    ]
  })
};

const cityPages = [
  { href: "/new-cairo-tagamoa-concrete-cutting-core/", label: "التجمع الخامس والقاهرة الجديدة" },
  { href: "/new-capital-shorouk-madinaty-core/", label: "العاصمة الإدارية والشروق ومدينتي" },
  { href: "/تخريم-خرسانة-مدينة-نصر/", label: "مدينة نصر" },
  { href: "/فتحات-كور-الحي-العاشر/", label: "الحي العاشر" },
  { href: "/october-zayed-concrete-cutting-core/", label: "6 أكتوبر والشيخ زايد" },
  { href: "/alexandria-concrete-cutting-core/", label: "الإسكندرية" },
  { href: "/mansoura-concrete-cutting-core/", label: "المنصورة والدقهلية" },
  { href: "/minya-concrete-cutting-core/", label: "المنيا" },
  { href: "/assiut-concrete-cutting-core/", label: "أسيوط" },
  { href: "/hurghada-concrete-cutting-core/", label: "الغردقة والبحر الأحمر" },
];

const regions = [
  {
    title: "القاهرة الكبرى والمدن الجديدة",
    areas: [
      "القاهرة الجديدة والتجمع الخامس",
      "مدينتي، الرحاب، الشروق، وبدر",
      "مدينة نصر، المعادي، ومصر الجديدة",
      "العاصمة الإدارية الجديدة",
      "القليوبية (العبور، شبرا الخيمة)"
    ]
  },
  {
    title: "محافظة الجيزة وأكتوبر وزايد",
    areas: [
      "6 أكتوبر، الشيخ زايد، وحدائق أكتوبر",
      "المهندسين، الدقي، والعجوزة",
      "الهرم، فيصل، وحدائق الأهرام",
      "القرية الذكية والمناطق الصناعية"
    ]
  },
  {
    title: "محافظات وجه بحري والدلتا والقناة",
    areas: [
      "الإسكندرية والساحل الشمالي والعلمين",
      "مدن الدلتا (المنصورة، طنطا، دمياط الجديدة)",
      "مدن القناة (السويس، الإسماعيلية، بورسعيد)",
      "العاشر من رمضان ومدينة السادات"
    ]
  },
  {
    title: "محافظة البحر الأحمر",
    areas: [
      "الغردقة والجونة",
      "العين السخنة ورأس غارب",
      "سفاجا، القصير، ومرسى علم",
      "المشاريع السياحية والفندقية"
    ]
  },
  {
    title: "محافظات وجه قبلي (الصعيد)",
    areas: [
      "بني سويف والمنيا",
      "أسيوط وسوهاج",
      "قنا والأقصر",
      "أسوان والمشاريع التنموية"
    ]
  },
  {
    title: "المشاريع الخاصة والصناعية",
    areas: [
      "المصانع والمناطق الصناعية",
      "مشاريع الطرق والكباري",
      "محطات الكهرباء والمياه",
      "مناطق أخرى حسب حجم المشروع"
    ]
  }
];
---

<MainLayout {...seo}>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 860px; margin: 0 auto;">
        <span class="hero-subtitle">دريل ماكس | التغطية الجغرافية</span>
        <h1>مناطق خدمة قص وتخريم الخرسانة في جميع محافظات مصر</h1>
        <p class="hero-lead">
          تغطي فرق دريل ماكس القاهرة الكبرى والمدن الجديدة والمحافظات لتنفيذ فتحات الكور وقص الخرسانة بالمنشار الماسي والواير. أرسل موقعك وتفاصيل العمل لتأكيد الموعد ونطاق التنفيذ.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">تواصل لتأكيد الموعد</a>
          <a href="https://wa.me/201070046464" class="btn btn-wa" target="_blank" rel="noopener noreferrer">أرسل الموقع عبر واتساب</a>
        </div>
      </div>
    </div>
  </section>

  <section class="areas-section bg-light">
    <div class="container">
      <div class="area-directory" aria-labelledby="area-details">
        <h2 id="area-details">صفحات تفاصيل الخدمة حسب المنطقة</h2>
        <p>تساعدنا معرفة المنطقة والعنوان وصور موضع الفتحات على مراجعة الوصول وتجهيز المعدات. يُؤكد نطاق العمل وموعد الانتقال بعد مراجعة بيانات الموقع.</p>
        <ul class="city-links-grid">
          {cityPages.map(city => (
            <li><a href={city.href}>{city.label}</a></li>
          ))}
        </ul>
        <p class="directory-note">
          جهّز عدد الفتحات والمقاسات ونوع العنصر ورقم الدور وصور الموقع، ثم <a href="/contact/">تواصل لمناقشة المعاينة والتنفيذ</a>، أو راجع <a href="/services/">أنواع خدمات القص والتخريم</a> قبل إرسال الطلب.
        </p>
      </div>
    </div>
  </section>

  <section class="areas-section">
    <div class="container">
      <div class="section-header text-center">
        <h2>أهم المناطق والمحافظات التي نخدمها</h2>
        <p>سواء كنت تحتاج صنايعي كور في القاهرة الجديدة أو فني منشار في الإسكندرية أو الغردقة أو الصعيد، ننسّق انتقال الفريق والمعدات وفق حجم المشروع.</p>
      </div>

      <div class="regions-grid">
        {regions.map(region => (
          <div class="region-card">
            <div class="region-icon" aria-hidden="true"></div>
            <h3>{region.title}</h3>
            <ul>
              {region.areas.map(area => <li>{area}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="areas-section bg-light">
    <div class="container">
      <div class="map-card">
        <h2>نطاق الانطلاق الرئيسي — القاهرة ومصر</h2>
        <div class="map-embed">
          <iframe
            src="https://www.google.com/maps?q=Cairo%2C%20Egypt&output=embed"
            loading="lazy"
            title="خريطة تغطية دريل ماكس في القاهرة ومصر"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <div class="areas-cta">
        <h2>لم تجد منطقتك في القائمة؟</h2>
        <p>تواصل معنا مباشرة — للمشاريع المتوسطة والكبيرة ينتقل فريق دريل ماكس بكامل معداته إلى جميع محافظات الجمهورية.</p>
        <div class="cta-actions">
          <a href="/contact/" class="btn btn-primary">استفسر الآن عن إمكانية خدمتك</a>
          <a href="tel:+201070046464" class="btn btn-outline">اتصل: 01070046464</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .text-center { text-align: center; }
  .bg-light { background-color: var(--section-bg); }
  .areas-section { padding: 64px 0; }
  .hero h1 { font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.35; margin-bottom: 16px; }
  .hero-lead { color: #dad7ce; font-size: 1.15rem; line-height: 1.85; margin-bottom: 24px; }
  .hero-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  .section-header { max-width: 760px; margin: 0 auto 40px; }
  .section-header h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--dark); margin-bottom: 12px; }
  .section-header p { color: var(--gray); line-height: 1.85; font-size: 1.05rem; }

  .area-directory {
    background: #fff;
    padding: 36px;
    border-radius:4px;
    border: 1px solid var(--border-color);
  }
  .area-directory h2 { color: var(--dark); font-size: 1.6rem; margin-bottom: 12px; }
  .area-directory p { color: var(--gray); line-height: 1.85; }
  .city-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 14px;
    margin: 24px 0;
  }
  .city-links-grid a {
    display: block;
    padding: 14px 16px;
    background: #f5f4f0;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    color: var(--dark);
    font-weight: 700;
    text-align: center;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .city-links-grid a:hover {
    border-color: var(--primary);
    color: var(--primary);
    
  }
  .directory-note a { color: var(--primary); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }

  .regions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
  }
  .region-card {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius:4px;
    padding: 28px;
  }
  .region-icon {
    width: 48px;
    height: 48px;
    border-radius:4px;
    background: #fff7ed;
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 14px;
  }
  .region-card h3 { color: var(--dark); font-size: 1.25rem; margin-bottom: 14px; }
  .region-card ul { list-style: disc; padding-inline-start: 20px; color: var(--gray); line-height: 1.9; }
  .region-card li { margin-bottom: 6px; }

  .map-card {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius:4px;
    padding: 32px;
    margin-bottom: 32px;
  }
  .map-card h2 { color: var(--dark); font-size: 1.5rem; margin-bottom: 20px; text-align: center; }
  .map-embed iframe { width: 100%; height: 380px; border: 0; border-radius: 4px; display: block; }

  .areas-cta {
    background: var(--header-bg);
    color: #fff;
    border-radius:4px;
    padding: 44px 32px;
    text-align: center;
    border-top: 3px solid var(--primary, #c2410c);
  }
  .areas-cta h2 { font-size: 1.8rem; margin-bottom: 12px; color: #fff; }
  .areas-cta p { color: #d6d3cb; max-width: 680px; margin: 0 auto 24px; line-height: 1.85; font-size: 1.05rem; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 640px) {
    .areas-section { padding: 40px 0; }
    .area-directory, .map-card, .areas-cta { padding: 24px 18px;   border-top: 3px solid var(--primary, #c2410c);
  }
  }
</style>
