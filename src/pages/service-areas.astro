---
import MainLayout from '../layouts/MainLayout.astro';

const seo = {
  title: "مناطق خدمة قص وتخريم الخرسانة في مصر | 01070046464",
  description: "خريطة مناطق خدمة قص وتخريم الخرسانة من دريل ماكس في القاهرة والجيزة والتجمع وأكتوبر والإسكندرية والصعيد والبحر الأحمر. اتصل 01070046464.",
  canonical: "/service-areas/",
  ogImage: "/images/gas-hole.webp",
  schema: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://drilmax.com/#organization",
        "name": "Drill Max | دريل ماكس",
        "url": "https://drilmax.com",
        "sameAs": ["https://www.facebook.com/drillmaxeg"],
