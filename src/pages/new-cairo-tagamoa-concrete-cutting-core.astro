---
import MainLayout from '../layouts/MainLayout.astro';

const PHONE = "01070046464";
const WHATSAPP = `https://wa.me/2${PHONE}`;

const NEW_CAIRO_AREAS = [
  { name: "التجمع الخامس (التسعين الشمالي والجنوبي)", popular: true },
  { name: "بيت الوطن واللوتس والأندلس", popular: true },
  { name: "النرجس والياسمين والبنفسج", popular: true },
  { name: "كمبوندات ميفيدا وهايد بارك وماونتن فيو", popular: true },
  { name: "القطامية هايتس وبالم هيلز قطامية", popular: false },
  { name: "مدينة الرحاب ومدينتي", popular: false },
  { name: "التجمع الأول والتجمع الثالث", popular: false },
  { name: "الشروق وبدر والعاصمة الإدارية", popular: false },
  { name: "المعادي وزهراء المعادي", popular: false },
  { name: "المنطقة الصناعية بالقاهرة الجديدة", popular: false },
];

const STATS = [
  { num: "+500", label: "فيلا ومشروع بالقاهرة الجديدة" },
  { num: "نفس اليوم", label: "استجابة ومعاينة سريعة" },
  { num: "0%", label: "تكسير عشوائي أو شروخ" },
  { num: "10+", label: "سنوات خبرة هندسية" },
];

const SERVICES = [
  { icon: "01", title: "فتحات كور للتكييف الكونسيلد والاسبليت", desc: "تخريم خرسانة مسلحة بأقطار 2 إلى 10 بوصة لمواسير الفريون والصرف ومسارات الدكت بدون غبار.", details: "مناسب للشقق والفيلات المشطبة" },
  { icon: "02", title: "قص خرسانة بالمنشار والليزر (تعديلات فيلات)", desc: "فتح أبواب وشبابيك جديدة، قص أسقف لعمل سلم داخلي دوبلكس، أو توسعة مساحات Open Space بحواف مستقيمة.", details: "دقة ملليمترية بدون اهتزاز" },
  { icon: "03", title: "فتحات الغاز الطبيعي ومداخن السخانات", desc: "تخريم فتحات هواية الغاز ومداخن السخانات بالمقاسات القياسية المطلوبة دون إتلاف السيراميك.", details: "تنفيذ في أقل من 30 دقيقة" },
  { icon: "04", title: "تأسيس فتحات الشفاطات والدكت والمداخن", desc: "فتحات 4 و5 و6 بوصة لشفاطات المطابخ الهرمية والبلت إن والشفاطات السقفية مع تنسيق فني الشفاطات.", details: "حماية كاملة للرخام والديكور" },
  { icon: "05", title: "تزريع الأشاير وتدعيم الخرسانة", desc: "تزريع أشاير الأعمدة والأسقف والسلالم بمواد كيمابوكسي 165 وسيكا وهيلتي المعتمدة.", details: "طبقاً لاشتراطات المهندس المشرف" },
  { icon: "06", title: "قص مكان أسانسير وفتحات MEP للمقاولين", desc: "قص أسقف المصاعد وتنفيذ مئات فتحات الكور لمشاريع المولات والمكاتب الإدارية بالتسعين والعاصمة.", details: "أسعار خاصة للكميات والمقاولين" },
];

const PROCESS = [
  { step: "01", title: "إرسال تفاصيل وصور الموقع", desc: "أرسل صور الحائط أو السقف والمقاسات المطلوبة وعنوانك في التجمع أو القاهرة الجديدة عبر واتساب أو الهاتف." },
  { step: "02", title: "تأكيد التكلفة والموعد", desc: "نحدد لك السعر الشفاف وموعد وصول الفريق مع مراعاة مواعيد العمل المسموحة في الكمبوند." },
  { step: "03", title: "تجهيز الحماية والتبريد المائي", desc: "تغطية الأرضيات وتجهيز نظام تجميع المياه قبل التشغيل للحفاظ على تشطيبات الفيلا أو الشقة." },
  { step: "04", title: "التنفيذ بالكور أو المنشار الماسي", desc: "تنفيذ الفتحات أو القص بدقة هندسية بدون تكسير أو شروخ إنشائية." },
  { step: "05", title: "التسليم والنظافة", desc: "سحب القلب الخرساني وتنظيف نقطة العمل لتسليم الفتحة جاهزة للتركيب مباشرة." },
];

const FAQ = [
  {
    q: "هل تصل فرق دريل ماكس إلى كمبوندات التجمع الخامس والقاهرة الجديدة؟",
    a: "نعم، مقرنا الرئيسي قريب جداً في مدينة نصر مما يتيح وصولاً سريعاً يومياً لجميع أحياء وكمبوندات التجمع الخامس والقاهرة الجديدة (ميفيدا، هايد بارك، ماونتن فيو، بالم هيلز، بيت الوطن، اللوتس، الرحاب، ومدينتي) مع الالتزام الكامل بقواعد الهدوء والنظافة ومواعيد العمل بالكمبوند."
  },
  {
    q: "هل تخريم الكور في شقة مشطبة بالتجمع الخامس يسبب بهدلة أو تلفاً للسيراميك؟",
    a: "نستخدم ماكينات كور دريل ماسية بالتبريد المائي مع ترتيبات تجميع المياه وحماية السيراميك والرخام والأثاث المحيط، مما يمنع تطاير الغبار ويحافظ على التشطيبات القائمة."
  },
  {
    q: "كم سعر فتحة الكور في التجمع الخامس والقاهرة الجديدة؟",
    a: "يتحدد السعر حسب قطر الفتحة بالبوصة (من 1 إلى 10 بوصة)، نوع الحائط (خرسانة مسلحة أم طوب)، سماكة الجدار، وعدد الفتحات. نقدم خصماً مميزاً عند تنفيذ أكثر من فتحة أو لمشاريع المقاولين في القاهرة الجديدة."
  },
  {
    q: "هل تنفذون فتحات شفاط المطبخ وتركيب الشفاط في التجمع الخامس؟",
    a: "نعم، ننفذ فتحة الكور في الخرسانة بقطر المخرج المناسب، كما نوفر فريق فني شفاطات متخصص لتركيب شفاط المطبخ والحمام وتأسيس المدخنة والدكت (يمكنكم حجز فني الشفاطات مباشرة عبر 01024596959)."
  },
  {
    q: "هل تغطون مشاريع العاصمة الإدارية والشروق ومدينتي؟",
    a: "نعم بالتأكيد، فرقنا المتمركزة في شرق القاهرة تخدم يومياً الشروق ومدينتي والرحاب وبدر والعاصمة الإدارية الجديدة سواء لتعديلات الوحدات السكنية أو عقود شركات المقاولات."
  }
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "دريل ماكس لقص وتخريم الخرسانة - التجمع الخامس والقاهرة الجديدة",
    "description": "خدمات صنايعي كور وفتحات كور وقص الخرسانة بالمنشار والليزر وتزريع الأشاير في التجمع الخامس والقاهرة الجديدة والرحاب ومدينتي.",
    "url": "https://drilmax.com/new-cairo-tagamoa-concrete-cutting-core/",
    "telephone": "+201070046464",
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "التجمع الخامس - القاهرة الجديدة", "addressRegion": "EG-C", "addressCountry": "EG" },
    "geo": { "@type": "GeoCoordinates", "latitude": 30.0074, "longitude": 31.4913 },
    "openingHours": "Mo-Su 08:00-22:00",
    "areaServed": [
      { "@type": "City", "name": "التجمع الخامس" },
      { "@type": "City", "name": "القاهرة الجديدة" },
      { "@type": "City", "name": "الرحاب" },
      { "@type": "City", "name": "مدينتي" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map(x => ({ "@type": "Question", "name": x.q, "acceptedAnswer": { "@type": "Answer", "text": x.a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://drilmax.com", "name": "الرئيسية" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://drilmax.com/service-areas/", "name": "مناطق الخدمة" } },
      { "@type": "ListItem", "position": 3, "item": { "@id": "https://drilmax.com/new-cairo-tagamoa-concrete-cutting-core/", "name": "التجمع الخامس والقاهرة الجديدة" } }
    ]
  }
]);
---

<MainLayout
  title="فتحات كور وقص خرسانة في التجمع الخامس والقاهرة الجديدة | 01070046464"
  description="صنايعي ومقاول فتحات كور وقص خرسانة بالمنشار والليزر في التجمع الخامس والقاهرة الجديدة والرحاب ومدينتي بدون غبار أو اهتزاز. اتصل 01070046464."
  canonical="/new-cairo-tagamoa-concrete-cutting-core/"
  ogImage="/images/صنايعي-كور-في-التجمع.webp"
  schema={schema}
>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
        <nav aria-label="breadcrumb" style="margin-bottom: 16px; font-size: 0.9rem; color: rgba(255,255,255,0.75); display:flex; align-items:center; justify-content:center; gap:6px;">
