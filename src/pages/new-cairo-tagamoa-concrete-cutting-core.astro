            { href: "/saw-cuttingقص-خرسانة/", label: "قص الخرسانة بالمنشار والليزر" },
            { href: "/اسعار-فتحات-الكور/", label: "أسعار فتحات الكور بالتفصيل" },
            { href: "/prices/", label: "جدول الأسعار الشامل" },
            { href: "/تزريع-الاشاير/", label: "تزريع الأشاير وتدعيم الخرسانة" },
            { href: "/فني-شفاطات/", label: "فني شفاطات التجمع الخامس" },
