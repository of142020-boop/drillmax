          <h2>الأحياء والكمبوندات التي نغطيها يومياً في القاهرة الجديدة</h2>
          <div class="areas-grid">
            {NEW_CAIRO_AREAS.map(a => (
              <div class={`area-card ${a.popular ? 'popular' : ''}`}>
                <span class="area-icon">{a.popular ? '●' : '▪'}</span>
                <span>{a.name}</span>
              </div>
            ))}
          </div>
