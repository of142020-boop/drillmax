const contentHtml = "<style>img{max-width:100%!important;height:auto!important}.wp-caption,.post-body-text figure{max-width:100%!important;overflow:hidden}html,body{overflow-x:hidden!important;max-width:100vw!important}</style>\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"1540\" class=\"elementor elementor-1540\" data-elementor-post-type=\"post\">\n\t\t\t\t<div class=\"elementor-element elementor-element-99dcaf3 e-flex e-con-boxed e-con e-parent\" data-id=\"99dcaf3\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-1fdd485 e-flex e-con-boxed e-con e-parent\" data-id=\"1fdd485\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-c48e867 elementor-widget elementor-widget-heading\" data-id=\"c48e867\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">لو بتجهّز شقة أو بتسلّم مشروع وعايز فتحات تكييف وسباكة وكهرباء تتعمل بسرعة وبنظافة ومن غير تكسير عشوائي،</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-5eca1da2 e-flex e-con-boxed e-con e-parent\" data-id=\"5eca1da2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-33a62525 elementor-widget elementor-widget-text-editor\" data-id=\"33a62525\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<h2> </h2><h6>الكور دريل بالماس هو الحل الاحترافي. التقنية دي بتطلع فتحة أسطوانية مظبوطة بالمليمتر، بفضل البنطة الماسية والتبريد بالمياه اللي بيقلل الغبار والاهتزاز. النتيجة: شغل أنضف، وقت أقل، وتكلفة محسوبة.</h6><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\" style=\"text-align: right;\">يعني إيه <a href=\"https://en.wikipedia.org/wiki/Core_drill\" target=\"_blank\" rel=\"noopener\">كور دريل</a>؟</h3><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\" style=\"text-align: right;\">الكور دريل هو ماكينة بتعمل فتحات دائرية دقيقة في الخرسانة المسلحة والطوب والحجر، عشان تمديدات المواسير والكابلات والدكتات، وكمان سحب عينات اختبار (كور) للمعامل. الفرق عن التكسير التقليدي إن الشغل بيطلع أنعم، أسرع، وآمن على الهيكل.</h6><h6> </h6><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">ليه الكور دريل أحسن اختيار؟</h3><ul class=\"marker:text-quiet list-disc\"><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">دقة عالية: فتحة ناعمة من غير شروخ حوالين الحفرة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">سرعة تنفيذ: سرعات متعددة وبنطة ماسية تقطع بكفاءة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">أمان ونظافة: تبريد مائي يقلل الغبار والحرارة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">مقاسات متنوعة: من 32 مم لحد 250 مم وأكثر حسب اللقم.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">مرونة: ينفع للحوائط والأسقف والأرضيات ومواد مختلفة.</h6></li></ul><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">استخدامات مطلوبة في مصر</h3><ul class=\"marker:text-quiet list-disc\"><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">فتحات التكييف: دكتات ومخارج وحدات الاسبليت والمركزي بأقطار مظبوطة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">السباكة: فتح مواسير صرف وتغذية من غير ما نبوّظ التشطيبات.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">الكهرباء والاتصالات: مسارات مواسير وكابلات منظمة وآمنة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">مداخن الغاز والسخانات: فتحات دقيقة بمعايير أمان.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">اختبارات خرسانة: سحب عينات (كور) لقياس المقاومة والجودة.</h6></li></ul><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">إزاي بنشتغل خطوة بخطوة؟</h3><ol class=\"marker:text-quiet list-decimal\"><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">المعاينة: تحديد المقاس والمكان بالمليمتر مع فحص وجود تمديدات مخفية.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">التثبيت: تركيب قاعدة الماكينة بإحكام لضمان عمودية القطع.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">اختيار البنطة: لقمة ماسية بالمقاس المناسب ونظام سرعة ملائم للمادة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">التبريد: تغذية مائية مستمرة لتقليل الغبار وإطالة عمر البنطة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">التخريم: ضغط منتظم من غير عنف لفتحة مستقيمة ونضيفة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\" style=\"text-align: right;\">التسليم: إزالة النواة الأسطوانية وت</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\" style=\"text-align: right;\">نظيف الموقع جاهز للتركيب.<img width=\"1200\" height=\"630\" loading=\"lazy\" decoding=\"async\" class=\"aligncenter wp-image-1144\" src=\"/images/core-drill-hero.webp\" alt=\"صنايعي كور دريل يعمل\"  /></h6></li></ol><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">مواصفات الماكينات الاحترافية</h3><h6> </h6><ul class=\"marker:text-quiet list-disc\"><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">قدرة 1600–2800 وات مع سرعات متعددة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">أقطار شائعة: 32، 50، 75، 110، 125، 160، 200، 250 مم.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">قواعد تثبيت ثابتة أو محمولة حسب الموقع.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">حماية من الحمل الزائد ونظام تبريد مائي.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">لقم ماسية أصلية لثبات ودقة أعلى.</h6></li></ul><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">الأمان أولًا</h3><h6> </h6><ul class=\"marker:text-quiet list-disc\"><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">وقاية شخصية: نظارات، خوذة، جوانتي، وسدادات أذن حسب الموقع.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">فحص المسار: التأكد من عدم وجود مواسير أو كابلات.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">تثبيت محكم: لتجنّب ميل الفتحة أو انزلاق الماكينة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">توصيلات آمنة: كهرباء مؤمّنة ومياه تبريد مضبوطة.</h6></li></ul><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">إزاي نحسب <a href=\"/prices/\">التكلفة</a>؟</h3><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">العوامل المؤثرة:</h6><ul class=\"marker:text-quiet list-disc\"><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">القطر المطلوب وسُمك الخرسانة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">عدد الفتحات في الزيارة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">سهولة الوصول والارتفاع.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">وجود تسليح كثيف.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">سرعة التنفيذ (عادي/عاجل).<br />نصيحة: تجميع فتحات أكتر في نفس الزيارة يقلل التكلفة الإجمالية، بينما المواقع الصعبة أو التسليح الكثيف يزوّد السعر.</h6></li></ul><h3 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">أسئلة شائعة</h3><ul class=\"marker:text-quiet list-disc\"><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">ينفع في الخرسانة المسلحة؟  نعم، البنطة الماسية مصممة تتعامل مع الحديد والخرسانة بكفاءة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">هل هيتّوسخ المكان؟  بنشتغل بتبريد مائي وشفط وتنضيف، والتسليم بيكون نظيف.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">في خطورة على الحيطة أو السقف؟  الاهتزازات قليلة والدقة عالية، فالمخاطر أقل بكثير من التكسير التقليدي.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">المقاسات المتاحة؟  من الصغير حتى 250 مم وأكثر حسب اللقم المتاحة.</h6></li><li class=\"py-0 my-0 prose-p:pt-0 prose-p:mb-2 prose-p:my-0 [&amp;&gt;p]:pt-0 [&amp;&gt;p]:mb-2 [&amp;&gt;p]:my-0\"><h6 class=\"my-2 [&amp;+p]:mt-4 [&amp;_strong:has(+br)]:inline-block [&amp;_strong:has(+br)]:pb-2\">مدة التنفيذ؟ بتعتمد على السمك والموقع، لكن أغلب الفتحات بتتم بسرع</h6></li><li><h6>مع الكور دريل بالماس، كل فتحة بتطلع مظبوطة ونضيفة وفي المعاد. سواء فتحات تكييف، سباكة، كهرباء، أو مداخن غاز، نفّذها باحتراف ومن غير فوضى. حدّد المقاس، نشتغل بدقة، ونسلّم المكان جاهز للتركيب فورًا.</h6></li></ul><h6><a href=\"/contact/\">جاهز تنفّذ فتحاتك بأقل تكسير وأعلى دقة؟ اطلب خدمة الكور دريل دلوقتي لمعاينة مجانية، تسعير فوري، وتنفيذ سريع على موعدك. تواصل عبر واتساب أو اتصال، وهيوصلّك فريق محترف في أسرع وقت.</a></h6>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-19c0bb0 e-flex e-con-boxed e-con e-parent\" data-id=\"19c0bb0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-50d17dd elementor-mobile-align-center elementor-widget elementor-widget-button\" data-id=\"50d17dd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"/prices/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">اطلب عرض سعر الان</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t";
