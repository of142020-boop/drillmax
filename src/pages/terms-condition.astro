---
import MainLayout from '../layouts/MainLayout.astro';

const seo = {
  title: "الشروط والأحكام | دريل ماكس",
  description: "اطلع على الشروط والأحكام الخاصة باستخدام موقع دريل ماكس، وضوابط طلب خدمات قص وتخريم الخرسانة وعروض الأسعار والمعاينة.",
  canonical: "/terms-condition/",
  ogImage: "/images/logo-1.webp",
  schema: JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://drilmax.com/terms-condition/#webpage",
    "url": "https://drilmax.com/terms-condition/",
    "name": "الشروط والأحكام",
    "inLanguage": "ar-EG",
    "isPartOf": {
      "@type": "WebSite",
      "@id": "https://drilmax.com/#website",
      "url": "https://drilmax.com/",
      "name": "Drill Max | دريل ماكس"
    }
  }),
};
---

<MainLayout {...seo}>
  <section class="legal-section">
    <div class="container">
      <article class="legal-card">
        <header class="legal-header">
          <p class="legal-eyebrow">دريل ماكس | السياسات القانونية</p>
          <h1>شروط وأحكام الاستخدام</h1>
          <p class="legal-lead">
            مرحباً بك في موقع <a href="/">Drill Max | دريل ماكس</a>. بدخولك أو استخدامك للموقع فإنك توافق على الشروط والأحكام الموضحة أدناه لتنظيم استخدام المحتوى وطلب الخدمات.
          </p>
        </header>

        <section class="legal-block">
          <h2>استخدام الموقع والمحتوى</h2>
          <p>المحتوى المعروض في صفحات هذا الموقع مخصص للتعريف بخدماتنا وتقديم إرشادات عامة للتجهيز، وهو قابل للتحديث دون إشعار مسبق. لا يجوز نسخ أو إعادة نشر المحتوى أو الصور لأغراض تجارية دون موافقة كتابية مسبقة من إدارة دريل ماكس.</p>
        </section>

        <section class="legal-block">
          <h2>الخدمات وعروض الأسعار</h2>
          <p>تخضع جميع الخدمات المعروضة للتوافر ومراجعة ظروف الموقع والاتفاق النهائي على نطاق العمل. الأسعار الاسترشادية المعروضة على الموقع أو عبر التواصل المبدئي تقديرية، ويُحدد السعر النهائي بناءً على المقاسات الفعلية، السماكة، كثافة التسليح، وموقع المشروع.</p>
        </section>

        <section class="legal-block">
          <h2>المعاينة والاعتماد الهندسي</h2>
          <p>يلتزم العميل بتوفير المعلومات المتاحة عن التمديدات المخفية، وفي حالة التعديل على عناصر إنشائية حاملة (كمرات أو أعمدة أو حوائط حاملة) يلزم الحصول على اعتماد المهندس الإنشائي المسؤول قبل التنفيذ.</p>
        </section>

        <section class="legal-block">
          <h2>تحديد المسؤولية وتحديث الشروط</h2>
          <p>نحرص على دقة المعلومات المنشورة، ولا تُعد الإرشادات العامة بديلاً عن المعاينة الفنية للموقع أو استشارة المهندس المختص. نحتفظ بالحق في تحديث هذه الشروط في أي وقت، ويُعد استمرارك في استخدام الموقع موافقة على النسخة المحدثة.</p>
        </section>

        <section class="legal-block">
          <h2>التواصل والاستفسارات</h2>
          <p>لأية أسئلة بخصوص هذه الشروط والأحكام، يمكنك التواصل معنا مباشرة:</p>
          <div class="legal-contact">
            <a class="btn btn-primary" href="mailto:support@drilmax.com">support@drilmax.com</a>
            <a class="btn btn-wa" href="https://wa.me/201070046464" target="_blank" rel="noopener noreferrer">تواصل عبر واتساب</a>
          </div>
        </section>
      </article>
    </div>
  </section>
</MainLayout>

<style>
  .legal-section {
    padding: 64px 0;
    background: var(--section-bg);
  }
  .legal-card {
    max-width: 860px;
    margin: 0 auto;
    background: #fff;
    padding: 48px;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.05);
  }
  .legal-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .legal-eyebrow {
    color: var(--primary);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 8px;
  }
  .legal-header h1 {
    color: var(--dark);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-bottom: 14px;
  }
  .legal-lead {
    color: var(--gray);
    font-size: 1.08rem;
    line-height: 1.9;
  }
  .legal-lead a {
    color: var(--primary);
    text-decoration: underline;
    font-weight: 700;
  }
  .legal-block {
    margin-bottom: 28px;
  }
  .legal-block h2 {
    color: var(--dark);
    font-size: 1.35rem;
    margin-bottom: 12px;
    border-right: 4px solid var(--primary);
    padding-right: 12px;
  }
  .legal-block p {
    color: var(--gray);
    line-height: 1.9;
    margin-bottom: 12px;
  }
  .legal-contact {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  @media (max-width: 640px) {
    .legal-section { padding: 36px 0; }
    .legal-card { padding: 26px 20px; }
  }
</style>
