---
import MainLayout from '../layouts/MainLayout.astro';

const PHONE    = "01070046464";
const WHATSAPP = `https://wa.me/20${PHONE}`;

const OCTOBER_ZAYED_AREAS = [
  { name: "مدينة الشيخ زايد", popular: true },
  { name: "مدينة 6 أكتوبر", popular: true },
  { name: "حدائق أكتوبر", popular: true },
  { name: "أكتوبر الجديدة", popular: true },
  { name: "بيفرلي هيلز والربوة", popular: false },
  { name: "كومبوندات زايد وأكتوبر", popular: false },
  { name: "الحزام الأخضر", popular: false },
  { name: "دريم لاند وحي الأشجار", popular: false },
  { name: "المنطقة الصناعية بأكتوبر", popular: false },
  { name: "دهشور وطريق الواحات", popular: false },
];

const STATS = [
  { num: "+600", label: "فيلا وكومبوند تم العمل بها" },
  { num: "24h", label: "استجابة سريعة" },
  { num: "0%", label: "أضرار إنشائية" },
  { num: "10+", label: "سنوات خبرة في التخريم" },
];

const PROCESS = [
  { step: "01", title: "الاتصال والاستشارة", desc: "تواصل معنا هاتفياً أو عبر الواتساب، صِف لنا متطلبات العمل في فيلتك أو مشروعك وسنرد فوراً." },
  { step: "02", title: "المعاينة الهندسية", desc: "نصل لموقعك في أكتوبر أو زايد لمعاينة الجدران واستخدام أجهزة الكشف عن الحديد لتحديد أفضل مسار للقص." },
  { step: "03", title: "عرض السعر النهائي", desc: "نقدم لك تكلفة دقيقة بناءً على حجم العمل، دون أي رسوم خفية أو مفاجآت." },
  { step: "04", title: "التنفيذ السريع والنظيف", desc: "نستخدم ماكيناتنا الألمانية المزودة بنظام التبريد المائي لضمان عمل هادئ وبدون غبار." },
  { step: "05", title: "تسليم الموقع", desc: "نترك المكان نظيفاً تماماً والفتحات جاهزة للتشطيب أو التركيب مباشرة." },
];

const FAQ = [
  {
    q: "هل تعملون داخل الكومبوندات في الشيخ زايد وأكتوبر؟",
    a: "نعم بالتأكيد. نمتلك تصاريح وخبرة واسعة في العمل داخل أرقى الكومبوندات مثل بيفرلي هيلز، الربوة، سوديك، وبالم هيلز. نلتزم باشتراطات النظافة والهدوء المفروضة من إدارة الكومبوند."
  },
  {
    q: "هل يؤثر قص الخرسانة على ديكورات وتشطيبات الفيلا؟",
    a: "إطلاقاً. نستخدم نظام التبريد المائي الذي يمنع تطاير الغبار تماماً، ونقوم بتغطية وحماية المناطق المحيطة. أجهزتنا تعمل بدون اهتزازات (Vibration-Free) مما يمنع حدوث أي شروخ في الديكورات أو التشطيبات المجاورة."
  },
  {
    q: "ما هي استخدامات فتحات الكور الشائعة في الفيلات؟",
    a: "في الفيلات الحديثة بأكتوبر وزايد، يُطلب منا غالباً: فتحات التكييف المركزي (الكونسيلد)، مسارات أنظمة المنزل الذكي (Smart Home)، تمرير كابلات الطاقة الشمسية، وفتحات المصاعد الداخلية."
  },
  {
    q: "أرغب في توسعة شباك أو فتح باب جديد في الجدار، هل هذا ممكن؟",
    a: "نعم، باستخدام المنشار الماسي نقوم بقص الجدران الخرسانية بدقة متناهية لعمل أبواب، شبابيك، أو ربط مساحتين ببعضهما (Open Space) بخطوط مستقيمة لا تتطلب تكسيراً إضافياً."
  },
  {
    q: "هل تعملون في المشاريع والمصانع في المنطقة الصناعية بأكتوبر؟",
    a: "نعم، نقدم خدمات تخريم وقص الخرسانة للمصانع، المخازن، والمنشآت التجارية في المنطقة الصناعية لدعم تركيب الآلات الثقيلة أو تحديث البنية التحتية والمرافق."
  },
  {
    q: "كم يستغرق من الوقت لعمل فتحة تكييف؟",
    a: "عملية التخريم بالكور دريل سريعة جداً. الفتحة الواحدة قد تستغرق من 30 إلى 45 دقيقة فقط، وتخرج جاهزة ونظيفة تماماً للتمديدات."
  },
  {
    q: "ما الفرق بين التكسير اليدوي والتخريم بالكور؟",
    a: "التكسير اليدوي (بواسطة الهمر أو الأجنة) يسبب شروخاً دقيقة في المبنى، ضوضاء مزعجة، غباراً كثيفاً، وفتحة غير منتظمة. الكور دريل يقطع أسطوانة نظيفة تماماً بدون ضوضاء عالية أو غبار، ويحافظ على سلامة الحديد والهيكل."
  },
  {
    q: "كيف يمكنني طلب معاينة في حدائق أكتوبر؟",
    a: "فقط اتصل بنا على 01070046464 أو أرسل لنا رسالة على الواتساب. نغطي حدائق أكتوبر وأكتوبر الجديدة يومياً، وسنرسل فريقنا للمعاينة في أسرع وقت."
  },
];

const SERVICES = [
  { icon: "🏡", title: "أنظمة التكييف والتهوية", desc: "فتحات دقيقة للتكييف الكونسيلد والسبليت في الفيلات والقصور.", details: "أقطار تناسب كافة الأجهزة" },
  { icon: "⚡", title: "أنظمة السمارت هوم", desc: "تمرير شبكات المنازل الذكية وكابلات الإنترنت والكهرباء.", details: "فتحات نظيفة بدون تشققات" },
  { icon: "✂️", title: "قص لتوسعة المساحات", desc: "توسعة النوافذ والأبواب وإزالة الجدران لتصميمات Open Space.", details: "قص بالمنشار الماسي مستقيم" },
  { icon: "🚰", title: "تأسيس السباكة والصرف", desc: "فتحات صواعد المياه والصرف الصحي وتمديدات حمامات السباحة.", details: "دقة هندسية عالية" },
  { icon: "🏗️", title: "فتحات المصاعد الداخلية", desc: "قص الأسقف لتركيب المصاعد داخل الفيلات والمباني الدوبلكس.", details: "أبعاد دقيقة ومطابقة" },
  { icon: "🔥", title: "توصيلات الغاز الطبيعي", desc: "عمل فتحات آمنة ونظامية لتمديدات الغاز للمطابخ المركزية.", details: "مطابقة لاشتراطات الغاز" },
  { icon: "🏭", title: "خدمات المصانع (المنطقة الصناعية)", desc: "تخريم الخرسانة لتثبيت المعدات وتأسيس بنية المصانع.", details: "معدات هيفي ديوتي" },
  { icon: "☀️", title: "كابلات الطاقة الشمسية", desc: "تمرير وصلات أنظمة الطاقة الشمسية من الأسطح بفتحات معزولة.", details: "فتحات آمنة" },
];

const WHY_US = [
  { icon: "⚡", title: "تغطية شاملة وفورية", desc: "فريقنا متواجد بالقرب منك لتلبية طلبات الشيخ زايد وكل مناطق 6 أكتوبر (الجديدة والحدائق) بسرعة فائقة." },
  { icon: "🤫", title: "عمل هادئ ونظيف للكومبوندات", desc: "ندرك تماماً أهمية الهدوء والنظافة في المجمعات السكنية الراقية. معداتنا تعمل بنظام التبريد المائي الكاتم للغبار." },
  { icon: "👷", title: "كادر فني مهندس ومدرب", desc: "لا نعتمد على العمالة العشوائية. فريقنا مدرب على استخدام الأجهزة الألمانية المتطورة وقراءة المخططات الهندسية." },
  { icon: "🛡️", title: "حماية تامة للتشطيبات والديكورات", desc: "نتخذ كافة التدابير لتغطية وحماية أثاث وأرضيات موقع العمل إذا كان مأهولاً ومُشطباً بالفعل." },
  { icon: "🤝", title: "التزام قاطع بالمواعيد", desc: "نقدر قيمة وقت عملائنا في زايد وأكتوبر، ونتواجد في موقع العمل بالدقيقة المتفق عليها." },
  { icon: "🔩", title: "كشف مسار الحديد مسبقاً", desc: "نستخدم أجهزة سكانر حديثة لتحديد أماكن حديد التسليح وتجنب قصه في الأماكن الحرجة، حفاظاً على المنشأة." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "دريل ماكس لقص الخرسانة - أكتوبر وزايد",
    "description": "شركة متخصصة في تخريم وقص الخرسانة بالكور دريل للكومبوندات والفيلات والمصانع في 6 أكتوبر والشيخ زايد.",
    "url": "https://drilmax.com/october-zayed-concrete-cutting-core/",
    "telephone": "+2001070046464",
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "6 أكتوبر والشيخ زايد", "addressRegion": "EG-GZ", "addressCountry": "EG" },
    "geo": { "@type": "GeoCoordinates", "latitude": 29.9705, "longitude": 30.9427 },
    "openingHours": "Mo-Su 00:00-23:59",
    "areaServed": [{ "@type": "City", "name": "6 أكتوبر" }, { "@type": "City", "name": "الشيخ زايد" }],
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "154" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map(x => ({ "@type": "Question", "name": x.q, "acceptedAnswer": { "@type": "Answer", "text": x.a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://drilmax.com", "name": "الرئيسية" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://drilmax.com/services/", "name": "الخدمات" } },
      { "@type": "ListItem", "position": 3, "item": { "@id": "https://drilmax.com/october-zayed-concrete-cutting-core/", "name": "قص وتخريم خرسانة في 6 أكتوبر والشيخ زايد" } }
    ]
  }
]);
---

<MainLayout
  title="قص وتخريم خرسانة في 6 أكتوبر والشيخ زايد | 01070046464"
  description="خبراء تخريم وقص الخرسانة للكومبوندات والفيلات في أكتوبر وزايد. خدمات كور دريل بدون غبار واهتزاز. أحدث المعدات الألمانية. اتصل الآن 01070046464."
  canonical="/october-zayed-concrete-cutting-core/"
  ogImage="/images/rebar-planting-1.webp"
  schema={schema}
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
        <nav aria-label="breadcrumb" style="margin-bottom: 16px; font-size: 0.9rem; color: rgba(255,255,255,0.7); display:flex; align-items:center; justify-content:center; gap:6px;">
          <a href="/" style="color: rgba(255,255,255,0.7); text-decoration: none;">الرئيسية</a>
          <span>›</span>
          <a href="/services/" style="color: rgba(255,255,255,0.7); text-decoration: none;">الخدمات</a>
          <span>›</span>
          <span style="color: #fff;">6 أكتوبر والشيخ زايد</span>
        </nav>
        <div class="hero-rating">⭐⭐⭐⭐⭐ <span>4.9/5 من 154+ عميل في أكتوبر وزايد</span></div>
        <h1 style="text-align: center; font-size: clamp(1.9rem, 4.5vw, 3.2rem); line-height: 1.3; margin-top: 12px;">
          قص وتخريم خرسانة بـ أكتوبر وزايد<br>
          <span style="color: #7dd3fc;">للكومبوندات والفيلات الراقية</span>
        </h1>
        <p style="text-align: center; font-size: 1.2rem; margin-top: 18px; color: rgba(255,255,255,0.9); line-height: 1.9; max-width: 720px; margin-left: auto; margin-right: auto;">
          حلول متطورة لقص الخرسانة وعمل الفتحات بالكور دريل لتأسيس التكييف وأنظمة السمارت هوم. خدمة فائقة الهدوء والنظافة تناسب مستوى مشاريعك في الشيخ زايد و 6 أكتوبر.
        </p>
        <div style="display: flex; gap: 12px; margin-top: 30px; justify-content: center; flex-wrap: wrap;">
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="font-size: 1.1rem; padding: 16px 36px; gap: 8px;">💬 واتساب مباشر</a>
          <a href={`tel:${PHONE}`} class="btn btn-outline" style="background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.4); font-size: 1.1rem; padding: 16px 36px;">📞 {PHONE}</a>
        </div>
        <div class="hero-trust">
          <span>✅ بدون غبار أو إزعاج</span>
          <span>✅ ماكينات ألمانية</span>
          <span>✅ معاينة مجانية</span>
          <span>✅ التزام بالمواعيد</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar">
    <div class="container stats-inner">
      {STATS.map(s => (
        <div class="stat-item">
          <div class="stat-num">{s.num}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="container city-page-wrapper">
    <div class="city-page-grid">
      <main class="city-main-content">

        <!-- INTRO SECTION -->
        <section class="city-card">
          <div class="inline-badge">✅ الخيار الهندسي الأول في غرب القاهرة</div>
          <h2 style="margin-top:15px;">قص وتخريم الخرسانة المسلحة بأحدث التقنيات — أكتوبر وزايد</h2>

          <img src="/images/rebar-planting-1.webp" alt="تنفيذ أعمال قص خرسانة بالكور دريل داخل كومبوند في الشيخ زايد" style="width:100%; border-radius:16px; margin: 18px 0 22px; object-fit:cover; max-height:420px; box-shadow:0 10px 40px rgba(0,0,0,0.12);" loading="eager" />

          <p>تعتبر مدينتي الشيخ زايد و 6 أكتوبر (بجميع امتداداتها) من أرقى وأكبر المناطق السكنية والتجارية الحديثة. تصميمات الفيلات الحديثة والكومبوندات الفاخرة تتطلب دقة متناهية عند إجراء أي تعديلات إنشائية لتأسيس أنظمة التكييف الحديث، الشبكات الذكية، والمصاعد.</p>
          <p style="margin-top: 14px;"><strong>دريل ماكس</strong> توفر لك الحلول الأكثر أماناً وتطوراً. معداتنا (الكور دريل والمنشار الماسي) مصممة لإجراء الفتحات والقص بخطوط هندسية نظيفة تماماً، بدون استخدام التكسير العشوائي الذي يسبب اهتزازات خطيرة، وبدون إصدار أتربة تزعج الجيران بفضل تقنية التبريد المائي.</p>

          <div class="check-grid">
            <div class="check-item"><span class="check-icon">✓</span> أمان تام للتشطيبات والديكور</div>
            <div class="check-item"><span class="check-icon">✓</span> خبرة في العمل بالكومبوندات</div>
            <div class="check-item"><span class="check-icon">✓</span> تخريم لتأسيس الـ Smart Home</div>
            <div class="check-item"><span class="check-icon">✓</span> دقة هندسية 100% للمقاسات</div>
            <div class="check-item"><span class="check-icon">✓</span> فريق محترف ومدرب</div>
            <div class="check-item"><span class="check-icon">✓</span> استجابة سريعة جداً</div>
          </div>
        </section>

        <!-- SERVICES GRID -->
        <section class="city-card">
          <h2>باقة خدماتنا المخصصة لأكتوبر وزايد</h2>
          <p style="color: var(--gray); margin-bottom: 24px;">نلبي كافة احتياجات الفيلات، الشقق الفندقية، والمصانع:</p>
          <div class="services-full-grid">
            {SERVICES.map(s => (
              <div class="service-full-card">
                <div class="service-icon-big">{s.icon}</div>
                <div class="service-content">
                  <h3>{s.title}</h3>
                  <p>{s.desc}</p>
                  <span class="service-tag">{s.details}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- PROCESS -->
        <section class="city-card">
          <h2>خطوات العمل معنا</h2>
          <p style="margin-bottom: 28px;">عملية سلسة ومنظمة لضمان راحتك من أول اتصال وحتى تسليم الموقع:</p>
          <div class="process-list">
            {PROCESS.map(p => (
              <div class="process-item">
                <div class="process-step">{p.step}</div>
                <div class="process-content">
                  <h3>{p.title}</h3>
                  <p>{p.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- WHY US -->
        <section class="city-card">
          <h2>لماذا دريل ماكس هي خيار الكومبوندات ومهندسي الديكور؟</h2>
          <p style="margin-bottom: 24px;">المشاريع الراقية تتطلب مقاولاً يفهم معايير الجودة العالية:</p>
          <div class="why-grid">
            {WHY_US.map(w => (
              <div class="why-card">
                <span class="why-icon-lg">{w.icon}</span>
                <div>
                  <strong>{w.title}</strong>
                  <p>{w.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- AREAS TABLE -->
        <section class="city-card">
          <h2>مناطق تغطيتنا في 6 أكتوبر والشيخ زايد</h2>
          <p style="margin-bottom: 24px; color: var(--gray);">نتواجد يومياً في غرب القاهرة ونغطي كافة التوسعات والأحياء:</p>
          <div class="areas-grid">
            {OCTOBER_ZAYED_AREAS.map(a => (
              <div class={`area-card ${a.popular ? 'popular' : ''}`}>
                <span class="area-icon">{a.popular ? '⭐' : '📍'}</span>
                <span>{a.name}</span>
              </div>
            ))}
          </div>
          <p style="margin-top: 20px; color: var(--gray); font-size: 0.95rem; background: #f8fafc; padding: 14px; border-radius: 12px; border-right: 4px solid var(--primary);">
            💡 <strong>مشروعك خارج هذه القائمة؟</strong> لا تقلق، نغطي أيضاً سفنكس الجديدة، طريق الإسكندرية الصحراوي، وأي موقع في نطاق الجيزة وغرب القاهرة.
          </p>
        </section>

        <!-- FAQ -->
        <section class="city-card">
          <h2>أكثر الأسئلة شيوعاً من عملائنا في أكتوبر وزايد</h2>
          <div class="faq-list">
            {FAQ.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                <p class="faq-a">{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </main>

      <!-- SIDEBAR -->
      <aside class="city-sidebar">
        <div class="sidebar-cta">
