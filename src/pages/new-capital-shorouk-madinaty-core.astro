.city-card h2 { color: var(--dark); font-size: 1.7rem; margin-bottom: 14px; font-weight: 900; line-height: 1.4; }
.city-card p { color: var(--gray); line-height: 1.95; font-size: 1.05rem; }
.city-card a { color: #9a3412; text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
.services-full-grid { display: flex; flex-direction: column; gap: 14px; margin-top:20px; }
.service-full-card { display:flex; align-items:flex-start; gap:16px; padding:18px 20px; border-radius:16px; border:1px solid #e5e7eb; background:#fafafa; }
.service-icon-big { font-size:2rem; flex-shrink:0; width:50px; text-align:center; }
.service-content h3 { color:var(--dark); font-size:1.05rem; font-weight:900; margin-bottom:4px; }
.service-content p { color:var(--gray); font-size:0.93rem; line-height:1.65; margin:0; }
.service-tag { display:inline-block; margin-top:8px; padding:3px 10px; background: #ffedd5; color:#9a3412; border-radius:999px; font-size:0.8rem; font-weight:700; }
