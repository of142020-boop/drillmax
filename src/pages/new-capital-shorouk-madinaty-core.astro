const AREAS = [
  { name: "العاصمة الإدارية الجديدة (R3 – R7 – R8 – الداون تاون)", popular: true },
  { name: "مدينتي (كل المجموعات والفيلات)", popular: true },
  { name: "مدينة الشروق وهليوبوليس الجديدة", popular: true },
  { name: "مدينة الرحاب (القديمة والامتداد)", popular: true },
  { name: "مدينة بدر وحدائق العاصمة", popular: false },
  { name: "مدينة العبور والعبور الجديدة", popular: false },
  { name: "مدينة المستقبل (المستقبل سيتي)", popular: false },
  { name: "الحي المالي ومنطقة الأعمال المركزية (CBD)", popular: false },
  { name: "العاشر من رمضان والمنطقة الصناعية", popular: false },
  { name: "طريق السويس والإسماعيلية الصحراوي", popular: false },
];

const STATS = [
  { num: "+400", label: "وحدة ومشروع بشرق القاهرة" },
  { num: "نفس اليوم", label: "استجابة سريعة للمعاينة" },
  { num: "0%", label: "تكسير عشوائي أو غبار" },
  { num: "MEP", label: "عقود مقاولين وكميات" },
];

const SERVICES = [
  { icon: "🏗️", title: "فتحات كور MEP للمولات والأبراج بالعاصمة الإدارية", desc: "تنفيذ مئات فتحات الكور بمسارات الكابلات والصرف والتكييف المركزي بدقة هندسية والتزام بالجدول الزمني.", details: "خصومات خاصة للكميات والمقاولين" },
  { icon: "🏡", title: "فتحات تكييف وغاز وشفاطات في مدينتي والشروق", desc: "تخريم خرسانة نظيف للشقق والفيلات المشطبة (أقطار 2 إلى 8 بوصة) دون إتلاف السيراميك أو الواجهات.", details: "التزام تام بقواعد الكمبوند" },
  { icon: "✂️", title: "قص خرسانة بالمنشار والليزر لتعديلات الفيلات", desc: "فتح أبواب وشبابيك جديدة وقص أسقف الدوبلكس والمصاعد بحواف مستقيمة وبدون اهتزاز.", details: "أعماق حتى 70 سم" },
  { icon: "🔩", title: "تزريع الأشاير وتدعيم الخرسانة بالكود المصري", desc: "تزريع أشاير الأعمدة والأسقف والسلالم بمواد كيمابوكسي 165 وسيكا وهيلتي المعتمدة.", details: "تنفيذ وتوريد مواد أصلية" },
  { icon: "💨", title: "فني شفاطات وتأسيس مداخن المطابخ والحمامات", desc: "عمل فتحة الكور وتركيب الشفاط البلت إن والهرمي والسقفي مع فريق الشفاطات (01024596959).", details: "تأسيس وتشطيب نظيف" },
  { icon: "🧱", title: "تكسير حوائط وتعديلات الشقق وتشوين المخلفات", desc: "تجهيز الشقق والمحلات للتجديد مع رفع وتشوين كامل للمخلفات وتسليم الموقع نظيفاً.", details: "إنجاز سريع ومنظم" },
];

const FAQ = [
  {
    q: "هل تعمل فرق دريل ماكس داخل العاصمة الإدارية الجديدة لمشاريع شركات المقاولات؟",
    a: "نعم، ننفّذ أعمال فتحات الكور وقص الخرسانة بالمنشار والواير وتزريع الأشاير لشركات المقاولات ومكاتب الـ MEP في الداون تاون، الحي المالي، وجميع الأحياء السكنية (R3، R7، R8) مع تسعير مخصص للكميات."
  },
  {
    q: "هل تصلون إلى مدينتي والرحاب والشروق لتنفيذ فتحات تكييف وغاز في الشقق المشطبة؟",
    a: "نعم، نخدم مدينتي والرحاب والشروق وهليوبوليس الجديدة يومياً بمعدات كور ماسية بالتبريد المائي وحماية كاملة للسيراميك والأرضيات والالتزام الكامل بمواعيد العمل المسموحة في المدينة."
  },
  {
    q: "ما أسعار فتحات الكور وقص الخرسانة في الشروق ومدينتي والعاصمة الإدارية؟",
    a: "تُحسب فتحات الكور حسب القطر بالبوصة ونوع الحائط والعدد، ويُحسب القص بالمنشار بالمتر الطولي حسب السماكة وكثافة التسليح، مع خصم واضح عند تنفيذ أكثر من فتحة أو للمشاريع الكبرى."
  },
  {
    q: "هل تغطون مدينة العبور والعاشر من رمضان للمصانع والمخازن؟",
    a: "نعم، ننفّذ قص فواصل التمدد للأرضيات الخرسانية، وفتحات الكور، وقص القواعد، وتزريع جوايط الماكينات في مصانع العبور والعاشر من رمضان وبدر."
  }
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "دريل ماكس لقص وتخريم الخرسانة - العاصمة الإدارية والشروق ومدينتي",
    "description": "خدمات صنايعي كور وفتحات كور وقص الخرسانة بالمنشار والليزر وتزريع الأشاير في العاصمة الإدارية الجديدة والشروق ومدينتي والرحاب وبدر والعبور.",
    "url": "https://drilmax.com/new-capital-shorouk-madinaty-core/",
    "telephone": "+201070046464",
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "العاصمة الإدارية والشروق ومدينتي", "addressRegion": "EG-C", "addressCountry": "EG" },
    "geo": { "@type": "GeoCoordinates", "latitude": 30.0131, "longitude": 31.7346 },
    "openingHours": "Mo-Su 08:00-22:00",
    "areaServed": [
      { "@type": "City", "name": "العاصمة الإدارية الجديدة" },
      { "@type": "City", "name": "الشروق" },
      { "@type": "City", "name": "مدينتي" },
      { "@type": "City", "name": "الرحاب" },
      { "@type": "City", "name": "العبور" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map(x => ({ "@type": "Question", "name": x.q, "acceptedAnswer": { "@type": "Answer", "text": x.a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://drilmax.com/", "name": "الرئيسية" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://drilmax.com/service-areas/", "name": "مناطق الخدمة" } },
      { "@type": "ListItem", "position": 3, "item": { "@id": "https://drilmax.com/new-capital-shorouk-madinaty-core/", "name": "العاصمة الإدارية والشروق ومدينتي" } }
    ]
  }
]);
---

<MainLayout
  title="قص وتخريم خرسانة العاصمة الإدارية والشروق ومدينتي | 01070046464"
  description="مقاول فتحات كور وقص خرسانة بالمنشار وتزريع أشاير في العاصمة الإدارية والشروق ومدينتي والرحاب وبدر والعبور بدون تكسير. اتصل 01070046464."
  canonical="/new-capital-shorouk-madinaty-core/"
  ogImage="/images/قص-وتخريم-الخرسانة-المسلحة.webp"
  schema={schema}
>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 920px; margin: 0 auto;">
        <nav aria-label="breadcrumb" style="margin-bottom: 16px; font-size: 0.9rem; color: rgba(255,255,255,0.75); display:flex; align-items:center; justify-content:center; gap:6px;">
          <a href="/" style="color: rgba(255,255,255,0.8); text-decoration: none;">الرئيسية</a>
          <span>›</span>
          <a href="/service-areas/" style="color: rgba(255,255,255,0.8); text-decoration: none;">مناطق الخدمة</a>
          <span>›</span>
          <span style="color: #fff;">العاصمة الإدارية والشروق ومدينتي</span>
        </nav>
        <div class="hero-rating">🏗️ <span>فرق شرق القاهرة · تغطية يومية للمدن الجديدة والمشاريع</span></div>
        <h1 style="text-align: center; font-size: clamp(1.85rem, 4.3vw, 3.05rem); line-height: 1.35; margin-top: 12px;">
          قص وتخريم خرسانة في العاصمة الإدارية <br />
          <span style="color: #fdba74;">والشروق ومدينتي والرحاب والعبور</span>
        </h1>
        <p style="text-align: center; font-size: 1.16rem; margin-top: 18px; color: rgba(255,255,255,0.92); line-height: 1.9; max-width: 760px; margin-left: auto; margin-right: auto;">
          مقاول فتحات كور وقص خرسانة بالمنشار الماسي والليزر وتزريع الأشاير للشقق والفيلات المشطبة ومشاريع شركات المقاولات والمصانع في شرق القاهرة والمدن الجديدة.
        </p>
        <div style="display: flex; gap: 12px; margin-top: 30px; justify-content: center; flex-wrap: wrap;">
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="font-size: 1.05rem; padding: 15px 32px;">💬 أرسل تفاصيل الموقع عبر واتساب</a>
          <a href={`tel:+2${PHONE}`} class="btn btn-outline" style="background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.45); font-size: 1.05rem; padding: 15px 32px;">📞 اتصل {PHONE}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="stats-bar">
    <div class="container stats-inner">
      {STATS.map(s => (
        <div class="stat-item">
          <div class="stat-num">{s.num}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="container city-page-wrapper">
    <div class="city-page-grid">
      <div class="city-main-content">
        <section class="city-card">
          <div class="inline-badge">✅ تغطية فورية لمدن شرق القاهرة والعاصمة الجديدة</div>
