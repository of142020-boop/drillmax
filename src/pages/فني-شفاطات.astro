---
import MainLayout from '../layouts/MainLayout.astro';

const PHONE = '01024596959';
const WHATSAPP = `https://wa.me/2${PHONE}`;
const title = 'فني شفاطات وتركيب شفاط المطبخ والحمام في مصر | 01024596959';
const description = 'احجز فني شفاطات محترف لتركيب شفاط المطبخ والحمام وتأسيس فتحة الكور والمدخنة وصيانة الأعطال في القاهرة والجيزة والمدن الجديدة. اتصل 01024596959.';
const canonical = '/فني-شفاطات/';

const faq = [
  {
    q: 'ما المعلومات المطلوبة لحجز فني تركيب شفاط المطبخ وتحديد التكلفة فورًا؟',
    a: 'أرسل عبر واتساب على 01024596959 نوع وموديل الشفاط (بلت إن، هرمي، مسطح، شباك، سقفي، أو هود مطعم)، وصورًا واضحة لمكان التركيب فوق البوتاجاز ومخرج الهواء المقترح، وهل توجد فتحة جاهزة أم نحتاج تأسيس فتحة كور جديدة، مع ذكر المنطقة والطابق. نؤكد لك السعر والموعد قبل الزيارة.'
  },
  {
    q: 'هل تقومون بعمل فتحة الشفاط في الخرسانة أو السيراميك بدون تكسير؟',
    a: 'نعم، هذه هي ميزتنا الأساسية مقارنة بأي فني تركيب عادي. نستخدم ماكينات الكور دريل الماسية (Core Drill) لعمل فتحة دائرية دقيقة بمقاس 4 أو 5 أو 6 بوصة في الخرسانة المسلحة والطوب مع حماية السيراميك والرخام وتجميع المياه، ثم نركّب الشفاط والمدخنة في نفس الزيارة.'
  },
  {
    q: 'ما الارتفاع المناسب لتركيب شفاط المطبخ فوق البوتاجاز؟',
    a: 'يتحدد الارتفاع بدقة وفق تعليمات موديل الشفاط ونوع البوتاجاز (غاز أم كهرباء/إندكشن)، وعادةً يتراوح بين 65 و75 سم فوق البوتاجاز الغاز لضمان سحب فعّال للبخار والدهون دون تعريض الفلاتر للحرارة المباشرة. يراجع الفني نقطة التثبيت قبل البدء.'
  },
  {
    q: 'هل الأفضل تركيب شفاط المطبخ بمدخنة خارجية أم بدون مدخنة (فلتر كربون)؟',
    a: 'تركيب شفاط مطبخ بمدخنة طرد خارجي هو الأقوى في سحب الروائح والحرارة والرطوبة خارج المنزل تمامًا. أما تركيب شفاط المطبخ بدون مدخنة (مثل شفاط بلت ان 90 بدون مدخنة بفلتر كربوني) فيُستخدم عندما يتعذر إخراج دكت للخارج، ويتطلب تغيير الفلتر الكربوني دوريًا وفق الاستخدام.'
  },
  {
    q: 'هل توفرون تركيب شفاط المطبخ على الشباك وفي الزجاج؟',
    a: 'نعم، نوفر فني تركيب شفاطات مطابخ على الشباك الألوميتال أو الخشب، ونراجع نوع الزجاج (عادي أم سيكوريت) قبل القص أو استبدال لوح الزجاج لتركيب شفاط الزجاج (15، 20، 25، 30 سم) بأمان كامل.'
  },
  {
    q: 'هل تركّبون شفاط الحمام السقفي داخل الجبس بورد؟',
    a: 'نعم، ننفذ تركيب شفاط المطبخ في السقف وتركيب شفاط الحمام السقفي المخفي والظاهر داخل الجبس بورد مع تمديد الدكت فوق السقف المستعار وتثبيت هواية خارجية محكمة تمنع رجوع الروائح والحشرات.'
  },
  {
    q: 'شفاط المطبخ صوته عالٍ وضعف سحبه — هل توفرون صيانة وإصلاح الأعطال؟',
    a: 'نعم، نفحص أسباب ضعف السحب والصوت المرتفع (تراكم الدهون على الموتور والريشة، اختناق أو ثنيات الدكت، تلف المفتاح أو الفتلة أو المكثف)، وننفذ التنظيف والصيانة وتغيير الفلاتر الكربونية ومواتير ومفاتيح الشفاطات في المنزل.'
  },
  {
    q: 'ما الماركات التي يتعامل معها فني شفاطات دريل ماكس في مصر؟',
    a: 'نتعامل مع جميع الماركات في السوق المصري: شفاطات توشيبا، فريش، تورنيدو، أريستون، إلبا، إليكا، بيورتي، بيكو، هوفر، آي كوك، KDK، وباناسونيك، بالإضافة إلى هود ومراوح البلاور المركزية للمطاعم.'
  },
  {
    q: 'ما المناطق التي يغطيها فني تركيب شفاط المطبخ في مصر؟',
    a: 'تغطي فرقنا جميع أحياء القاهرة الكبرى والجيزة والمدن الجديدة (التجمع الخامس، القاهرة الجديدة، العاصمة الإدارية، الشروق، مدينتي، الرحاب، مدينة نصر، المعادي، المهندسين، 6 أكتوبر، الشيخ زايد)، بالإضافة للإسكندرية والمحافظات والمشاريع التجارية.'
  },
];

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://drilmax.com/' },
        { '@type': 'ListItem', position: 2, name: 'الخدمات', item: 'https://drilmax.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'فني شفاطات وتركيب شفاط المطبخ والحمام', item: `https://drilmax.com${canonical}` },
      ],
    },
    {
      '@type': 'Service',
      name: 'فني شفاطات وتركيب شفاط المطبخ والحمام وتأسيس المداخن في مصر',
      alternateName: 'فني تركيب شفاط المطبخ | شركات تركيب شفاطات المطابخ',
      url: `https://drilmax.com${canonical}`,
      description,
      serviceType: 'تركيب شفاطات المطابخ والحمامات وتأسيس فتحات الكور والمداخن وصيانة الأعطال',
      provider: {
        '@type': 'LocalBusiness',
        name: 'Drill Max | دريل ماكس',
        url: 'https://drilmax.com/',
        telephone: `+2${PHONE}`,
      },
      areaServed: [
        { '@type': 'Country', name: 'Egypt' },
        { '@type': 'City', name: 'القاهرة' },
        { '@type': 'City', name: 'الجيزة' },
        { '@type': 'City', name: 'الإسكندرية' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'خدمات فني الشفاطات والمداخن',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'تركيب شفاط المطبخ (بلت إن، هرمي، مسطح، جزيرة، وشباك)' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'تأسيس فتحة شفاط المطبخ بالكور دريل وتركيب مدخنة المطبخ والدكت' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'تركيب شفاط الحمام السقفي والجبس بورد والجداري' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'صيانة أعطال شفاط المطبخ وتنظيف الدهون وتغيير فلاتر الكربون' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'تركيب الشفاط المركزي وهود ومراوح البلاور للمطاعم' } },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
});
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical}
  phoneNumber={PHONE}
  ogImage="/images/exhaust-fan-install.webp"
  preloadImage="/images/exhaust-fan-install.webp"
  schema={serviceSchema}
>
<article class="ex-page">
  <!-- ARCHITECTURAL SPLIT HERO -->
  <header class="ex-hero">
    <div class="container ex-intro">
      <div>
        <nav class="ex-crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span><a href="/services/">الخدمات</a><span>/</span><span>فني شفاطات وتركيب المداخن</span></nav>
        <p class="ex-eyebrow">دريل ماكس · فني تركيب شفاط المطبخ مصر</p>
        <h1>فني شفاطات لتركيب شفاط المطبخ والحمام وتأسيس المداخن</h1>
        <p class="ex-lead">تبحث عن <strong>فني تركيب شفاط المطبخ</strong> ينفذ المهمة كاملة في زيارة واحدة بدون تكسير السيراميك؟ بصفتنا من أبرز <strong>شركات تركيب شفاطات المطابخ</strong> في مصر، نجمع بين <strong>تأسيس فتحة الشفاط بالكور دريل</strong> و<strong>تركيب مدخنة المطبخ</strong> والدكت وتعليق <strong>شفاط مطبخ فوق البوتاجاز</strong> أو الحمام أو السقف، إلى جانب الصيانة الفورية في القاهرة والجيزة والمدن الجديدة.</p>
        <ul class="ex-trust" aria-label="مميزات خدمة فني الشفاطات">
          <li><strong>فتحة كور + تركيب</strong><span>فريق واحد بلا تكسير</span></li>
          <li><strong>كل الأنواع</strong><span>بلت إن · هرمي · سقفي</span></li>
          <li><strong>دكت وهواية</strong><span>منع ارتداد الروائح</span></li>
          <li><strong>صيانة منزلية</strong><span>سحب أقوى وصوت أقل</span></li>
        </ul>
        <div class="ex-actions">
          <a class="btn btn-primary" href={`tel:+2${PHONE}`}>اتصل لحجز الفني: <span dir="ltr">{PHONE}</span></a>
          <a class="btn btn-secondary" href={WHATSAPP} target="_blank" rel="noopener noreferrer">أرسل صورة المطبخ واتساب</a>
        </div>
      </div>
      <figure class="ex-hero-media">
        <img src="/images/exhaust-fan-install.webp" alt="فني شفاطات محترف يركب شفاط مطبخ فوق البوتاجاز مع مدخنة ودكت خارجي" width="1496" height="1513" loading="eager" fetchpriority="high" />
        <figcaption>تأسيس فتحة الكور وتركيب شفاط وهود المطبخ المنزلي بدون كسر السيراميك</figcaption>
      </figure>
    </div>
  </header>

  <div class="container ex-body">
    <nav class="ex-toc" aria-label="محتويات خدمة فني الشفاطات">
      <a href="#services">الخدمات الستة</a>
      <a href="#types">أنواع الشفاطات والمقاسات</a>
      <a href="#foundation">فتحة الكور والمدخنة</a>
      <a href="#gallery">صور من أعمالنا</a>
      <a href="#repair">صيانة الأعطال</a>
      <a href="#brands">الماركات المعتمدة</a>
      <a href="#pricing">تكلفة التركيب والتأسيس</a>
      <a href="#areas">مناطق الخدمة</a>
      <a href="#faq">الأسئلة الشائعة</a>
    </nav>

    <!-- SECTION 1: 01-06 SERVICES -->
    <section id="services">
      <h2>خدمات فني تركيب شفاطات المطابخ والحمامات المتكاملة</h2>
      <p>بدل الاستعانة بسباك أو كهربائي لتعليق الجهاز ومقاول آخر لتخريم الحائط، يقدّم لك <strong>فني شفاطات دريل ماكس</strong> الخدمة كاملة بأعلى دقة هندسية ونظافة تامة:</p>
      <div class="ex-grid ex-grid-3">
        <div>
          <span class="ex-num">01</span>
          <h3>تركيب شفاط مطبخ فوق البوتاجاز (هود منزلي)</h3>
          <p>تثبيت <strong>هود مطبخ منزلي</strong> (شفاط هود مطبخ هرمي أو مسطح أو ديكوري زجاجي) مع ضبط الارتفاع القياسي وتقفيل الغطاء الستانلس باستقامة تامة. راجع <a href="/تركيب-شفاط-المطبخ/">دليل طريقة تركيب شفاط المطبخ</a>.</p>
        </div>
        <div>
          <span class="ex-num">02</span>
          <h3>تركيب شفاط مطبخ بلت إن ومدمج بالخزانة</h3>
          <p>تركيب <strong>شفاط مطبخ بلت ان</strong> (60 أو 90 سم) سواء بمدخنة خارجية أو <strong>شفاط بلت ان 90 بدون مدخنة</strong> (فلتر كربوني)، مع قص خشب الكابينة بدقة وضبط مسار الدكت المخفي. راجع <a href="/تأسيس-مدخنة-شفاط-المطبخ-بلت-ان/">دليل تأسيس مدخنة البلت إن</a>.</p>
        </div>
        <div>
          <span class="ex-num">03</span>
          <h3>تأسيس فتحة الكور وتركيب مدخنة شفاط مطبخ</h3>
          <p>تخريم فتحة <strong>مدخنة شفاط مطبخ</strong> (4، 5، 6 بوصة) بالكور الماسي دون كسر السيراميك، وتمديد الدكت المرن أو الصاج وتركيب <strong>هواية المطبخ</strong> الخارجية (جريل بفتحات مائلة).</p>
        </div>
        <div>
          <span class="ex-num">04</span>
          <h3>تركيب شفاط المطبخ في السقف وشفاط الحمام</h3>
          <p>تنفيذ <strong>تركيب شفاط المطبخ في السقف</strong> وتركيب <strong>شفاطات سقف</strong> الحمامات المخفية والظاهرة في الجبس بورد مع تمديد الدكت وعزله. راجع <a href="/تركيب-شفاط-سقفي-جبس-بورد/">دليل الشفاط السقفي والجبس بورد</a> و<a href="/مقاس-شفاط-الحمام/">دليل مقاس شفاط الحمام</a>.</p>
        </div>
        <div>
          <span class="ex-num">05</span>
          <h3>تركيب شفاط المطبخ على الشباك والزجاج</h3>
          <p>تجهيز وتركيب <strong>شفاط الزجاج</strong> و<strong>شفاطات زجاج</strong> (15، 20، 25، 30 سم مثل شفاط مطبخ توشيبا أو فريش) على شباك الألوميتال أو الزجاج بعد فحص نوع اللوح بأمان.</p>
        </div>
        <div>
          <span class="ex-num">06</span>
          <h3>الشفاط المركزي وشفاطات المطاعم (B2B)</h3>
          <p>تأسيس وتركيب <strong>شفاط مطبخ قوي</strong> وشفاط مركزي للفيلات وهود ستانلس وبلاور ومداخن صاج مجلفن للمطاعم والكافيهات. راجع <a href="/شفاط-مركزي-وشفاطات-مطاعم/">صفحة الشفاط المركزي وشفاطات المطاعم</a>.</p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: TYPES & SPECS TABLE -->
    <section id="types">
      <h2>دليل أنواع شفاطات المطبخ ومقاسات الفتحات القياسية</h2>
      <p>اختيار طريقة التركيب الصحيحة لـ <strong>شفاطات المطبخ</strong> يعتمد على نوع الجهاز ومسار خروج الهواء. يوضح الجدول التالي أهم المواصفات الفنية لكل نوع قبل الحجز:</p>
      <div class="ex-table">
        <table>
          <thead>
            <tr>
              <th scope="col">نوع الشفاط</th>
              <th scope="col">المقاسات الشائعة</th>
              <th scope="col">قطر فتحة المدخنة</th>
              <th scope="col">أهم متطلبات التركيب الاحترافي</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">شفاط مطبخ بمدخنة (هرمي / هود)</th>
              <td>60 سم / 90 سم</td>
              <td>5 – 6 بوصة (12.5 – 15 سم)</td>
              <td>تثبيت حائطي متين + قص وضبط المدخنة الديكورية + أقصر مسار دكت للخارج.</td>
            </tr>
            <tr>
              <th scope="row">شفاط مطبخ بلت إن (مدمج / مخفي)</th>
              <td>60 سم / 90 سم</td>
              <td>5 – 6 بوصة أو فلتر كربون</td>
              <td>قص دقيق أسفل الكابينة + توصيل دكت داخلي محكم أو تركيب فلاتر الكربون المعتمدة.</td>
            </tr>
            <tr>
              <th scope="row">شفاط مسطح (Standard Flat)</th>
              <td>60 سم / 90 سم</td>
              <td>4 – 5 بوصة أو بدون مدخنة</td>
              <td>تثبيت أسفل الخزانة أو على الحائط بمسافة آمنة فوق البوتاجاز. راجع <a href="/مقارنة-الشفاط-الهرمي-والمسطح/">مقارنة الهرمي والمسطح</a>.</td>
            </tr>
            <tr>
              <th scope="row">شفاط شباك وزجاج (مربع/دائري)</th>
              <td>15 / 20 / 25 / 30 سم</td>
              <td>مطابق لإطار الشفاط</td>
              <td>تثبيت محكم بدون اهتزاز على شباك المطبخ أو الحمام مع شبكة خلفية ضد الحشرات.</td>
            </tr>
            <tr>
              <th scope="row">شفاط سقفي (جبس بورد / جزيرة)</th>
              <td>20–30 سم / 90 سم جزيرة</td>
              <td>4 – 6 بوصة فوق السقف</td>
              <td>تأسيس فتحة جبس بورد + تثبيت بالخرسانة للجزيرة + رداد منع رجوع الروائح.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECTION 3: CORE FOUNDATION & CHIMNEY -->
    <section id="foundation">
      <h2>تأسيس فتحة الشفاط بالكور دريل وتركيب مدخنة المطبخ بدون تكسير</h2>
      <p>أكبر خطأ يضعف سحب أي <strong>شفاط للمطبخ</strong> — حتى لو كان بأعلى قدرة موتور — هو تنفيذ فتحة ضيقة أو مسار دكت مليء بالانحناءات، أو تكسير السيراميك بالهيلتي. في <strong>دريل ماكس</strong> ننفذ التأسيس الهندسي كاملًا وفق 5 خطوات دقيقة:</p>
      <div class="ex-grid">
        <div>
          <h3>1. تخريم الخرسانة والسيراميك بالكور الماسي</h3>
          <ul>
            <li>تنفيذ فتحة دائرية ناعمة بالقطر القياسي (4، 5، أو 6 بوصة) عبر <a href="/core-drilling-صنايعي-كور/">ماكينات الكور دريل الماسية</a> بدون شروخ أو كسر للسيراميك والرخام.</li>
            <li>حماية دواليب المطبخ والأرضيات وتجميع مياه التبريد في المطابخ المشطبة والمفروشة.</li>
            <li>مراجعة مسارات مواسير الغاز والكهرباء والمياه داخل الجدار قبل بدء التخريم.</li>
          </ul>
        </div>
        <div>
          <h3>2. تركيب الدكت والمدخنة والهواية الخارجية</h3>
          <ul>
            <li>تمديد دكت ألومنيوم مرن مقوى أو دكت صاج مجلفن بأقل عدد ممكن من الأكواع لضمان أعلى معدل سحب وأقل صوت.</li>
            <li>تركيب <strong>هواية المطبخ</strong> الخارجية (جريل بريش مائلة وشبكة) لمنع دخول العصافير والأمطار والحشرات.</li>
            <li>عزل محيط الفتحة بالفوم أو السيليكون المخصص لمنع أي تسريب هواء أو روائح.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION 4: GALLERY -->
    <section id="gallery">
      <h2>صور حقيقية من أعمال تركيب وتأسيس شفاطات المطابخ والحمامات</h2>
      <p>نماذج من أعمال <strong>فني شفاطات</strong> دريل ماكس في تأسيس فتحات الكور وتركيب شفاطات البلت إن والهرمية وشفاطات الحمام:</p>
      <div class="ex-gallery">
        <figure>
          <img src="/images/exhaust-fan-foundation.webp" alt="تأسيس فتحة مدخنة شفاط المطبخ في الخرسانة بالكور دريل" width="1200" height="1200" loading="lazy" />
          <figcaption>تأسيس فتحة مدخنة الشفاط بالكور الماسي بدقة ملليمترية</figcaption>
        </figure>
        <figure>
          <img src="/images/exhaust-fan-hood.webp" alt="تركيب شفاط هود مطبخ هرمي ومدخنة ستانلس فوق البوتاجاز" width="1496" height="1513" loading="lazy" />
          <figcaption>تركيب شفاط هود مطبخ هرمي مع ضبط الارتفاع والمدخنة الديكورية</figcaption>
        </figure>
        <figure>
          <img src="/images/exhaust-fan-pro.webp" alt="فني تركيب شفاط المطبخ يضبط توصيلات الدكت والسحب" width="1496" height="1513" loading="lazy" />
          <figcaption>ضبط مسار الدكت وتقفيل التوصيلات الكهربائية لضمان سحب قوي</figcaption>
        </figure>
        <figure>
          <img src="/images/exhaust-fan-bathroom.webp" alt="تركيب شفاط حمام سقفي وجداري مع تهوية محكمة" width="736" height="981" loading="lazy" />
          <figcaption>تركيب شفاط الحمام السقفي والجداري وتأمين مخرج التهوية</figcaption>
        </figure>
      </div>
    </section>

    <!-- SECTION 5: REPAIR & MAINTENANCE -->
    <section id="repair">
      <h2>صيانة أعطال شفاط المطبخ وتنظيف الدهون وتغيير الفلاتر</h2>
      <p>إذا كان لديك شفاط قائم لكنه يصدر صوتًا مرتفعًا أو لا يسحب البخار بالكفاءة المعتادة، يقدّم فريقنا خدمة صيانة منزلية سريعة لجميع الأعطال (راجع أيضًا <a href="/صيانة-اعطال-شفاط-المطبخ/">دليل صيانة أعطال شفاط المطبخ بالتفصيل</a>):</p>
      <div class="ex-callout">
        <h3>أبرز أعطال الشفاطات التي نعالجها في المنزل</h3>
        <ul>
          <li><strong>علاج ضعف السحب والصوت العالي:</strong> فحص مسار الدكت وإزالة الانسدادات والثنيات، وتنظيف المروحة والموتور من الدهون المتراكمة.</li>
          <li><strong>إصلاح المفاتيح والفتلة والموتور:</strong> تغيير مفتاح السرعات، تركيب فتلة وسلك شفاط توشيبا وفريش، واستبدال المكثف أو الموتور التالف.</li>
          <li><strong>تغيير فلاتر الكربون والشبكات:</strong> توريد وتركيب فلاتر الكربون للشفاطات المسطحة والبلت إن بدون مدخنة وتنظيف فلاتر الألومنيوم.</li>
          <li><strong>معالجة ارتداد الروائح والهواء:</strong> تركيب صمام عدم رجوع (رداد) وجريل خارجي محكم على مخرج المدخنة.</li>
        </ul>
      </div>
    </section>

    <!-- SECTION 6: BRANDS -->
    <section id="brands">
      <h2>أشهر ماركات الشفاطات التي نركّبها ونصونها في مصر</h2>
      <p>فنيونا مدربون على التعامل مع المخططات الفنية ومقاسات التركيب لجميع الماركات المتوفرة في السوق المصري (وإذا كنت ما زلت في مرحلة المقارنة قبل الشراء، راجع <a href="/أسعار-شفاطات-المطبخ-افضل-انواع/">دليل أسعار وأنواع شفاطات المطبخ في مصر</a>):</p>
      <div class="ex-brands">
        <span>شفاطات توشيبا (25 و30 سم وزجاج)</span>
        <span>شفاطات فريش (مسطح، هرمي، بلت إن 90 سم)</span>
        <span>شفاطات تورنيدو (Tornado)</span>
        <span>شفاطات أريستون (Ariston)</span>
        <span>شفاطات إلبا وإليكا (Elba &amp; Elica)</span>
        <span>شفاطات بيورتي وبيكو وهوفر</span>
        <span>شفاطات آي كوك (iCook) والبلت إن</span>
        <span>شفاطات الحمام KDK وباناسونيك</span>
      </div>
    </section>

    <!-- SECTION 7: PRICING FACTORS -->
    <section id="pricing">
      <h2>كيف تُحسب تكلفة تركيب شفاط المطبخ وتأسيس المدخنة؟</h2>
      <p>نحدد لك التكلفة بوضوح كامل قبل تحرك الفني بناءً على نطاق العمل الفعلي في مطبخك:</p>
      <div class="ex-table">
        <table>
          <thead>
            <tr>
              <th scope="col">بند الخدمة</th>
              <th scope="col">ما يحدّد التكلفة</th>
              <th scope="col">ما ترسله لنا للتسعير السريع</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">تعليق وتركيب الشفاط فقط</th>
              <td>نوع الجهاز (مسطح، هرمي، بلت إن يحتاج قص خشب، أم جزيرة سقفي).</td>
              <td>صورة الموديل ومكان التركيب فوق البوتاجاز.</td>
            </tr>
            <tr>
              <th scope="row">عمل فتحة كور في الخرسانة/الطوب</th>
              <td>قطر الفتحة (4، 5، أو 6 بوصة) وسماكة الحائط وهل الجدار طوب أم خرسانة مسلحة.</td>
              <td>صورة الجدار من الداخل والخارج إن أمكن.</td>
            </tr>
            <tr>
              <th scope="row">تمديد الدكت والمدخنة والهواية</th>
              <td>طول مسار الدكت بالمتر، عدد الأكواع، وهل الدكت مرن معزول أم صاج مجلفن.</td>
              <td>المسافة التقريبية بين الشفاط ومخرج الهواء.</td>
            </tr>
            <tr>
              <th scope="row">تغطية الصيانة أو تغيير القطع</th>
              <td>نوع العطل (تنظيف دهون، مفتاح، فتلة، فلتر كربون، أم موتور).</td>
              <td>وصف المشكلة وفيديو قصير لصوت الجهاز إن وجد.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECTION 8: AREAS -->
    <section id="areas">
      <h2>مناطق خدمة فني شفاطات دريل ماكس في القاهرة والجيزة والمحافظات</h2>
      <p>تتحرك فرق <strong>فني تركيب شفاط المطبخ</strong> يوميًا لخدمة المنازل والكمبوندات والمطاعم في القاهرة الكبرى والمدن الجديدة والإسكندرية والمحافظات:</p>
      <div class="ex-area-links">
