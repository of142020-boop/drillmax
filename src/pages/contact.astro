---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="تواصل معنا | دريل ماكس | 01070046464" 
  description="اطلب عرض سعر أو استشارة فنية لمشروعك. تواصل مع فريق دريل ماكس لخدمات قص وتخريم الخرسانة عبر الهاتف أو الواتساب للحصول على استجابة فورية."
>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 800px; margin: 0 auto;">
        <span class="hero-subtitle">دريل ماكس | الدعم الفني</span>
        <h1 style="text-align: center; font-size: 3.5rem;">تواصل معنا</h1>
        <p style="text-align: center; font-size: 1.3rem;">اطلب عرض سعر أو استشارة فنية لمشروعك. تواصل مع فريق من المهندسين والفنيين جاهز للرد على جميع استفساراتك.</p>
      </div>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="contact-section py-section">
    <div class="container contact-grid">
      
      <!-- Contact Info -->
      <div class="contact-info">
        <span class="section-subtitle">بيانات التواصل المباشر</span>
        <h2 style="color: var(--dark); margin-bottom: 20px;">نحن هنا لخدمتك</h2>
        <p style="color: var(--gray); line-height: 1.8; margin-bottom: 30px;">للاستفسارات العاجلة أو لمناقشة تفاصيل مشروعك مباشرة مع أحد خبرائنا، يمكنك استخدام بيانات الاتصال التالية:</p>

        <div class="info-card">
          <div class="icon-circle">📍</div>
          <div>
            <h4>عنواننا</h4>
            <p>شارع احمد السلاب، الحي العاشر، مدينة نصر، القاهرة</p>
          </div>
        </div>

        <div class="info-card">
          <div class="icon-circle">📞</div>
          <div>
            <h4>اتصل بنا</h4>
            <p dir="ltr" style="text-align: right; margin-bottom: 5px;">01070046464</p>
            <p dir="ltr" style="text-align: right;">01055550195</p>
          </div>
        </div>

        <div class="info-card">
          <div class="icon-circle">✉️</div>
          <div>
            <h4>راسلنا</h4>
            <p>support@drilmax.com</p>
          </div>
        </div>

        <div class="mt-5">
          <a href="https://wa.me/201070046464" class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" style="vertical-align: middle; margin-left: 8px;">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            اطلب الخدمة الآن عبر واتساب
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-box">
        <h3 style="color: var(--dark); margin-bottom: 20px; font-size: 1.6rem;">أو عبر النموذج التالي</h3>
        <form>
          <div class="form-group">
            <input type="text" placeholder="الاسم الكريم" required />
          </div>
          <div class="form-group">
            <input type="tel" placeholder="رقم الهاتف" required />
          </div>
          <div class="form-group">
            <textarea placeholder="رسالتك أو تفاصيل المشروع" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100">إرسال الرسالة</button>
        </form>
      </div>

    </div>
  </section>

  <!-- SEO VALUE TEXT -->
  <section class="seo-value-section py-section bg-light border-top">
    <div class="container text-center" style="max-width: 900px;">
      <h3 style="color: var(--dark); font-size: 1.8rem; margin-bottom: 20px;">الاستثمار الذكي في الحلول الهندسية</h3>
      <p style="color: var(--gray); font-size: 1.1rem; line-height: 1.9;">
        قد يبدو التكسير العشوائي حلاً سريعًا ورخيصًا، لكن تكاليفه الخفية باهظة، فهو يسبب شروخًا دقيقة ويضعف الهيكل الخرساني، مما يؤدي إلى أضرار إنشائية مستقبلية تتطلب تكاليف ترميم وإعادة تشطيب عالية. في المقابل، فإن اختيار الحل الهندسي عبر خدمات قص وتخريم الخرسانة من Drill Max هو استثمار ذكي. صحيح أن سعر فتحة الكور أو تكلفة قص الجدار قد تكون أعلى قليلاً في البداية، لكنها توفر عليك آلاف الجنيهات على المدى الطويل. نحن نقدم جودة عالية ودقة متناهية تضمن السلامة وتحافظ على قيمة الممتلكات، مما يمنحك أفضل قيمة مقابل سعر.
      </p>
    </div>
  </section>

</MainLayout>

<style>
  /* Global Resets matching Index */
  .py-section { padding: 80px 0; }
  .bg-light { background-color: var(--section-bg); }
  .text-center { text-align: center; }
  .border-top { border-top: 1px solid var(--border-color); }
  .mt-5 { margin-top: 40px; }
  .w-100 { width: 100%; }

  .section-subtitle {
    color: var(--primary);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: inline-block;
  }

  .btn {
    display: inline-block;
    padding: 14px 30px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.3s, color 0.3s, transform 0.3s;
    border: none;
    text-align: center;
    text-decoration: none;
  }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-primary:hover { background: var(--primary-hover); }
  
  .btn-whatsapp {
    background: #25D366;
    color: #fff;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    border-radius: 8px;
  }
  .btn-whatsapp:hover {
    background: #128C7E;
    color: #fff;
    transform: translateY(-2px);
  }

  /* Hero Section */
  .hero {
    position: relative;
    height: 50vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: url('/images/core-drill-hero.webp') center/cover no-repeat;
    z-index: 1;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to right, rgba(30, 37, 48, 0.4), rgba(30, 37, 48, 0.95));
  }
  .hero-container {
    position: relative;
    z-index: 2;
  }
  .hero-subtitle {
    color: var(--primary);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 15px;
    display: block;
  }
  .hero h1 {
    color: #fff;
    line-height: 1.3;
    margin-bottom: 20px;
    font-weight: 800;
  }
  .hero p {
    color: #cbd5e1;
    line-height: 1.8;
  }

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: flex-start;
  }

  /* Info Cards */
  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 25px;
    background: #fff;
    padding: 25px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }
  .icon-circle {
    width: 50px;
    height: 50px;
    background: rgba(255,87,34,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .info-card h4 {
    color: var(--dark);
    font-size: 1.2rem;
    margin-bottom: 5px;
    font-weight: 700;
  }
  .info-card p {
    color: var(--gray);
    margin: 0;
    font-size: 1.05rem;
  }

  /* Form Box */
  .contact-form-box {
    background: #fff;
    padding: 50px 40px;
    border-radius: 12px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.05);
    border: 1px solid var(--border-color);
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 16px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    color: var(--dark);
    background: #fdfdfd;
    transition: border-color 0.3s;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    background: #fff;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .hero h1 { font-size: 2.5rem !important; }
    .contact-form-box { padding: 30px; }
  }
</style>
