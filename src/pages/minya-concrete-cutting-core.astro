        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 تلا</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 منشأة علي</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 الروضة</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 أبنوب</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 القوصية</div>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="py-section border-top">
    <div class="container">
      <div class="row-flex align-center">
        <div class="half-box img-box shadow-hover" style="min-height: auto;">
          <img src="/images/core-1.webp" alt="تخريم خرسانة المنيا" style="width: 100%; border-radius: 12px; object-fit: cover;" />
