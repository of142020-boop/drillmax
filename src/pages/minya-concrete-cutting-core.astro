---
import MainLayout from '../layouts/MainLayout.astro';

const PHONE    = "01070046464";
const WHATSAPP = `https://wa.me/20${PHONE}`;

const MINYA_AREAS = [
  "مدينة المنيا وكورنيش النيل",
  "المنيا الجديدة",
  "مركز المنيا وملوي",
  "مغاغة وبني مزار",
  "سمالوط وأبو قرقاص",
  "العدوة وديرمواس",
  "مطاي والشيخ عبادة",
  "المنطقة الصناعية المنيا",
];

const FAQ = [
  {
    q: "هل تعملون في تخريم الكور وقص الخرسانة في المنيا؟",
    a: "نعم، نقدم الخدمتين في المنيا وجميع مراكزها. تخريم الكور لفتحات التكييف والغاز والسباكة والصرف، وقص الخرسانة بالمنشار لفتح الأبواب والشبابيك وقص الأسقف. فريقنا يصل لأي موقع في محافظة المنيا."
  },
  {
    q: "ما الفرق بين تخريم الكور وقص الخرسانة بالمنشار؟",
    a: "الكور ينتج فتحات دائرية دقيقة مناسبة لمواسير التكييف والغاز والسباكة والصرف. المنشار ينتج فتحات مستطيلة مستقيمة مناسبة لفتح الأبواب والشبابيك وقص الأسقف للسلالم. كلتا الخدمتين تعملان بالتبريد المائي بدون غبار أو اهتزاز."
  },
  {
    q: "ما هي أقطار فتحات الكور المتاحة في المنيا؟",
    a: "ننفذ فتحات الكور من 1 بوصة لكابلات الكهرباء حتى 14 بوصة لدكتات التكييف المركزي ومواسير الصرف الرئيسية. الفريق يحدد القطر المناسب لك أثناء المعاينة المجانية."
  },
  {
    q: "هل تعملون في تأسيس فتحات الغاز وفق الاشتراطات في المنيا؟",
    a: "نعم، ننفذ فتحات مواسير الغاز الطبيعي بالأقطار والمواصفات المطلوبة من شركة الغاز في المنيا. الفتحة دائرية منتظمة تماماً تسهل على فني الغاز تمرير الماسورة وتثبيتها بأمان."
  },
  {
    q: "هل يمكنكم قص جدار لفتح باب في منزلي بالمنيا؟",
    a: "بالطبع. نأتي لموقعك ونعاين الجدار بالكاشف الإلكتروني لتحديد حديد التسليح، ثم ننفذ القص بمنشار السكة الماسي مع تبريد مائي كامل. الفتحة تخرج نظيفة وجاهزة لتركيب الباب مباشرة."
  },
  {
    q: "هل يتسبب العمل في غبار أو اهتزاز في منزلي بالمنيا؟",
    a: "لا إطلاقاً. كلتا التقنيتين تعتمدان على التبريد المائي الذي يحول الغبار إلى معجون سائل يسحب فورا. لا يتصاعد غبار في الهواء ولا تحدث اهتزازات تضر بالهيكل الإنشائي."
  },
  {
    q: "هل تعملون في المباني القديمة في مراكز المنيا؟",
    a: "نعم. خبرتنا تشمل التعامل مع مباني مراكز المنيا القديمة ذات الخرسانة المتقادمة. نقيم طبيعة الخرسانة أولاً ونختار السرعة المناسبة لضمان فتحة نظيفة دون تفتت المواد المحيطة."
  },
  {
    q: "كيف أحجز موعداً لخدمة في المنيا؟",
    a: `تواصل معنا على ${PHONE} أو واتساب وأخبرنا بنوع العمل وموقعك في المنيا. نرتب المعاينة المجانية وعرض السعر بسرعة. يمكن تنفيذ القص والتخريم في نفس الزيارة.`
  },
];

const SERVICES = [
  { icon: "🔥", title: "فتحات الغاز الطبيعي", desc: "تنفيذ دقيق بمعايير شركة الغاز بالمنيا — دائرية منتظمة بدون تكسير." },
  { icon: "❄️", title: "فتحات التكييف والتهوية", desc: "مسارات السبليت والمركزي وفتحات التهوية بأي قطر مطلوب." },
  { icon: "✂️", title: "قص الخرسانة بالمنشار", desc: "فتح الأبواب والشبابيك وقص الأسقف بخطوط مستقيمة دقيقة." },
  { icon: "🚰", title: "أعمال السباكة والصرف", desc: "مسارات الصرف الصحي والمياه والصواعد الرأسية بنظافة تامة." },
  { icon: "🏗️", title: "فتحات المصاعد والسلالم", desc: "تنفيذ الفتحات الكبيرة لتركيب المصاعد والدرج الداخلي." },
  { icon: "💨", title: "فتحات الشفاطات والمداخن", desc: "فتحات خروج الشفاطات والمداخن بدون إتلاف الواجهات." },
];

const WHY_US = [
  { icon: "⚡", title: "فريق جاهز 7 أيام أسبوعياً", desc: "نصل إليك في أسرع وقت في أي مركز من مراكز المنيا، صباحاً أو مساءً." },
  { icon: "🔧", title: "ماكينات ألمانية متطورة", desc: "نستخدم أحدث ماكينات الكور دريل والمناشير الماسية المزودة بنظام التبريد المائي." },
  { icon: "📐", title: "دقة هندسية مضمونة", desc: "كل فتحة ننفذها تخرج بالقطر والشكل المطلوب تماماً دون أي انحراف أو تشقق." },
  { icon: "🤝", title: "سعر شفاف بدون مفاجآت", desc: "نقدم عرض السعر الكامل قبل البدء. لا رسوم مخفية ولا مفاجآت بعد الانتهاء." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "دريل ماكس لقص وتخريم الخرسانة بالمنيا",
    "description": "متخصصون في تخريم الخرسانة بالكور وقص الخرسانة بالمنشار الماسي في المنيا",
    "url": "https://drilmax.com/minya-concrete-cutting-core/",
    "telephone": "+2001070046464",
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "المنيا", "addressRegion": "EG-MN", "addressCountry": "EG" },
    "geo": { "@type": "GeoCoordinates", "latitude": 28.0871, "longitude": 30.7618 },
    "openingHours": "Mo-Su 00:00-23:59",
    "areaServed": [{ "@type": "City", "name": "المنيا" }]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map(x => ({ "@type": "Question", "name": x.q, "acceptedAnswer": { "@type": "Answer", "text": x.a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://drilmax.com", "name": "الرئيسية" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://drilmax.com/minya-concrete-cutting-core/", "name": "قص وتخريم خرسانة بالمنيا" } }
    ]
  }
]);
---

<MainLayout
  title="قص وتخريم خرسانة بالمنيا | كور ومنشار ماسي | 01070046464"
  description="متخصصون في تخريم الخرسانة بالكور وقص الخرسانة بالمنشار في المنيا — فتحات التكييف والغاز والسباكة وفتح الأبواب بدقة هندسية بدون اهتزاز. نخدم جميع مراكز المنيا. اتصل 01070046464."
  canonical="/minya-concrete-cutting-core/"
  ogImage="/images/تقطيع-بمنشار-الخرسانة.webp"
  schema={schema}
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 850px; margin: 0 auto;">
        <nav aria-label="breadcrumb" style="margin-bottom: 16px; font-size: 0.9rem; color: rgba(255,255,255,0.7);">
          <a href="/" style="color: rgba(255,255,255,0.7); text-decoration: none;">الرئيسية</a>
          <span style="margin: 0 8px;">›</span>
          <span style="color: #fff;">قص وتخريم خرسانة بالمنيا</span>
        </nav>
        <span class="hero-subtitle" style="color: rgba(255,255,255,0.85);">دريل ماكس | خدمات المنيا</span>
        <h1 style="text-align: center; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.3;">
          قص وتخريم خرسانة بالمنيا<br>كور ومنشار ماسي | 01070046464
        </h1>
        <p style="text-align: center; font-size: 1.15rem; margin-top: 18px; color: rgba(255,255,255,0.9); line-height: 1.8;">
          نقدم خدمات تخريم الخرسانة بالكور وقص الخرسانة بالمنشار في جميع مراكز المنيا بدقة هندسية وبدون تكسير أو اهتزاز.
        </p>
        <div style="display: flex; gap: 12px; margin-top: 28px; justify-content: center; flex-wrap: wrap;">
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="font-size: 1.05rem; padding: 14px 30px;">
            واتساب مباشر
          </a>
          <a href={`tel:${PHONE}`} class="btn btn-outline" style="background: rgba(255,255,255,0.15); color: #fff; border-color: rgba(255,255,255,0.5); font-size: 1.05rem; padding: 14px 30px;">
            اتصل: {PHONE}
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container city-page-wrapper">
    <div class="city-page-grid">

      <!-- MAIN CONTENT -->
      <main class="city-main-content">

        <section class="city-card">
          <div class="inline-badge">✅ تخريم الكور وقص الخرسانة في المنيا</div>
          <h2 style="margin-top:15px;">خدمات قص وتخريم الخرسانة في المنيا</h2>
          <p>تُعدّ المنيا عروس الصعيد وتشهد تطوراً عمرانياً كبيراً، مما يزيد الحاجة إلى حلول احترافية لقص وتخريم الخرسانة. شركة <strong>دريل ماكس</strong> تقدم هذه الخدمات باستخدام أحدث ماكينات الكور دريل والمناشير الماسية، مما يضمن إنجاز العمل بدقة هندسية عالية ودون إحداث أي تشقق أو ضرر للهيكل الإنشائي.</p>
          <p style="margin-top: 14px;">سواء كنت تحتاج فتحة غاز في شقتك بمدينة المنيا، أو تريد قص جدار لفتح باب في منزلك بملوي، أو تحتاج فتحات تكييف في مشروع بمغاغة — فريقنا يصلك بكل معداته ويُنجز العمل في نفس اليوم.</p>
          <div class="check-grid">
            <div class="check-item"><span class="check-icon">✓</span> فتحات كور بأقطار 1 حتى 14 بوصة</div>
            <div class="check-item"><span class="check-icon">✓</span> قص مستقيم بالمنشار الماسي</div>
            <div class="check-item"><span class="check-icon">✓</span> تبريد مائي لا غبار ولا اهتزاز</div>
            <div class="check-item"><span class="check-icon">✓</span> معاينة مجانية قبل البدء</div>
            <div class="check-item"><span class="check-icon">✓</span> جميع مراكز المنيا</div>
            <div class="check-item"><span class="check-icon">✓</span> تنفيذ في نفس اليوم</div>
          </div>
        </section>

        <section class="city-card">
          <h2>الخدمات التي نقدمها في المنيا</h2>
          <p style="color: var(--gray); margin-bottom: 20px;">نغطي جميع احتياجات قص وتخريم الخرسانة للمنازل والشركات والمشاريع الكبرى</p>
          <div class="services-mini-grid">
            {SERVICES.map(s => (
              <div class="service-mini-card">
                <div class="service-icon">{s.icon}</div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="city-card">
          <h2>لماذا تختار دريل ماكس في المنيا؟</h2>
          <p style="margin-bottom: 20px;">نعرف أن المنيا لها طابعها الخاص وطبيعة مبانيها المتنوعة بين الحديث والقديم. خبرتنا الممتدة في التعامل مع مباني الصعيد تمكننا من تقديم نتائج احترافية في كل مشروع.</p>
          <div class="why-list">
            {WHY_US.map(w => (
              <div class="why-item">
                <span class="why-icon">{w.icon}</span>
                <div>
                  <strong>{w.title}</strong>
                  <p>{w.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="city-card">
          <h2>الأسئلة الشائعة عن تخريم الكور في المنيا</h2>
          <div class="faq-list">
            {FAQ.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                <p class="faq-a">{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </main>

      <!-- SIDEBAR -->
      <aside class="city-sidebar">

        <div class="sidebar-cta">
          <h3>اطلب معاينة مجانية</h3>
          <p>فريقنا يصل المنيا ويقدم عرض سعر فوري لكلتا الخدمتين.</p>
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="cta-whatsapp">واتساب مباشر</a>
          <a href={`tel:${PHONE}`} class="cta-phone">{PHONE}</a>
        </div>

        <div class="sidebar-card">
          <h3>لماذا دريل ماكس بالمنيا؟</h3>
          {["امان انشائي مثبت", "كور دريل + منشار ماسي", "اسعار شفافة بدون مفاجآت", "تغطية المنيا كاملة", "معاينة مجانية بدون التزام", "تنفيذ في نفس اليوم"].map(item => (
            <div class="pill">✅ {item}</div>
          ))}
        </div>

        <div class="sidebar-dark">
          <h3>مراكز المنيا التي نخدمها</h3>
          {MINYA_AREAS.map(area => (
            <div class="area-item">
              <span class="area-dot"></span>
              {area}
            </div>
          ))}
        </div>

        <div class="sidebar-card">
          <h3>خدمات اخرى</h3>
          {[
            { href: "/core-drilling-صنايعي-كور/", label: "صنايعي كور تخريم خرسانة" },
            { href: "/saw-cuttingقص-خرسانة/", label: "قص الخرسانة بالمنشار" },
            { href: "/قص-الخرسانة-بالواير/", label: "قص بالواير الماسي" },
            { href: "/alexandria-concrete-cutting-core/", label: "قص وتخريم في الإسكندرية" },
            { href: "/services/", label: "جميع الخدمات" },
          ].map(s => (
            <a href={s.href} class="related-link">
              <span class="related-arrow">›</span>
              {s.label}
            </a>
          ))}
        </div>

      </aside>
    </div>

    <!-- BOTTOM CTA -->
    <section class="bottom-cta">
      <div class="bottom-cta-glow"></div>
      <div class="bottom-cta-content">
        <div class="bottom-cta-text">
          <span class="cta-badge">تخريم الكور وقص الخرسانة بالمنيا</span>
          <h2>جاهز لبدء مشروعك في المنيا؟</h2>
          <p>تواصل معنا الآن للحصول على معاينة مجانية وعرض سعر فوري. فريقنا جاهز لخدمتك في المنيا 7 أيام اسبوعياً.</p>
          <div class="cta-phone-big">{PHONE}</div>
        </div>
        <div class="bottom-cta-buttons">
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn-wa">واتساب مباشر</a>
          <a href={`tel:${PHONE}`} class="btn-call">اتصل الان</a>
        </div>
      </div>
    </section>
  </div>

</MainLayout>

<style>
.city-page-wrapper { max-width: 1200px; margin: 0 auto; padding: 50px 20px; }
.city-page-grid { display: grid; grid-template-columns: 1fr 320px; gap: 30px; align-items: start; }
.city-main-content { display: flex; flex-direction: column; gap: 26px; }
.city-card { background: white; border-radius: 20px; border: 1px solid rgba(0,0,0,0.08); padding: 36px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
.inline-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 16px; border-radius: 999px; background: #e0f2fe; color: #0369a1; font-weight: 700; font-size: 0.85rem; }
.city-card h2 { color: var(--dark); font-size: 1.8rem; margin-bottom: 14px; font-weight: 900; }
.city-card p { color: var(--gray); line-height: 1.9; font-size: 1.05rem; }
.check-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
.check-item { display:flex; align-items:center; gap:8px; padding: 12px 16px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; color: var(--dark); font-weight: 700; font-size: 0.95rem; }
.check-icon { color: var(--primary); font-weight:900; font-size:1.1rem; }
.services-mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top:20px; }
.service-mini-card { padding: 22px; border-radius: 16px; border: 1px solid #e5e7eb; background: #fafafa; transition: all 0.3s ease; }
.service-mini-card:hover { box-shadow: 0 10px 30px rgba(0,0,0,0.08); border-color:#cbd5e1; transform:translateY(-2px); }
.service-icon { font-size: 1.8rem; margin-bottom: 12px; }
.service-mini-card h3 { color: var(--dark); font-size: 1.05rem; font-weight: 900; margin-bottom: 8px; }
.service-mini-card p { color: var(--gray); font-size: 0.95rem; line-height: 1.7; margin: 0; }
.why-list { display: flex; flex-direction: column; gap: 16px; }
.why-item { display: flex; gap: 16px; align-items: flex-start; padding: 18px; border-radius: 14px; background: #f8fafc; border: 1px solid #e2e8f0; transition: border-color 0.2s;}
.why-item:hover { border-color: var(--primary); }
.why-icon { font-size: 1.8rem; flex-shrink: 0; }
.why-item strong { color: var(--dark); display: block; margin-bottom: 6px; font-size:1.05rem;}
.why-item p { color: var(--gray); margin: 0; line-height: 1.7; font-size: 0.95rem; }
.faq-list { display: flex; flex-direction: column; gap: 12px; margin-top:20px; }
.faq-item { border-radius: 16px; border: 1px solid #e5e7eb; padding: 20px 24px; cursor: pointer; background: white; transition:all 0.2s; }
.faq-item:hover { border-color: var(--primary); }
.faq-item[open] { border-color: var(--primary); box-shadow:0 4px 20px rgba(0,0,0,0.05); }
.faq-q { font-weight: 800; color: var(--dark); font-size: 1.05rem; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.faq-q::-webkit-details-marker { display:none; }
.faq-icon { color: var(--primary); transition: transform 0.3s; flex-shrink:0; }
.faq-item[open] .faq-icon { transform: rotate(180deg); }
.faq-a { color: var(--gray); line-height: 1.9; margin: 16px 0 0; padding: 18px; background: #f8fafc; border-radius: 12px; border-right: 4px solid var(--primary); font-size: 0.95rem; }
.city-sidebar { display: flex; flex-direction: column; gap: 20px; position: sticky; top: 24px; }
.sidebar-cta { background: linear-gradient(135deg, var(--primary), var(--dark)); border-radius: 20px; padding: 28px; color: white; position:relative; overflow:hidden;}
.sidebar-cta::after { content:''; position:absolute; top:-30px; right:-30px; width:100px; height:100px; background:rgba(255,255,255,0.1); border-radius:50%; }
.sidebar-cta h3 { font-size: 1.3rem; font-weight: 900; margin-bottom: 10px; position:relative; z-index:2;}
.sidebar-cta p { color: rgba(255,255,255,0.85); font-size: 0.95rem; line-height: 1.7; margin-bottom: 20px; position:relative; z-index:2;}
