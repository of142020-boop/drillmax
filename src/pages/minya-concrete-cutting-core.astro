---

<MainLayout {...seo}>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
        <span class="hero-subtitle" style="color: #fff;">دريل ماكس | المنيا</span>
        <h1 style="text-align: center; font-size: 2.8rem;">قص وتخريم خرسانة بالمنيا | كور ومنشار ماسي | 01070046464</h1>
        <p style="text-align: center; font-size: 1.2rem; margin-top: 20px;">نقدم خدمات قص الخرسانة بالمنشار الماسي وعمل فتحات الكور في جميع مراكز ومدن محافظة المنيا بدقة متناهية وبدون تكسير — المنيا، مغاغة، بني مزار، ملوي، سمالوط وغيرها.</p>
        <div style="display: flex; gap: 15px; margin-top: 30px; justify-content: center; flex-wrap: wrap;">
          <a href="/contact/" class="btn btn-primary">اطلب الخدمة الآن</a>
          <a href="tel:01070046464" class="btn btn-outline" style="background: rgba(255,255,255,0.15); color: #fff; border-color: rgba(255,255,255,0.5);">📞 01070046464</a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO SECTION -->
  <section class="intro-section py-section bg-light">
    <div class="container">
      <div class="row-flex align-center">
        <div class="half-box content-box">
          <h2 class="mb-4" style="color: var(--dark); font-size: 2rem;">خدمات قص وتخريم الخرسانة في محافظة المنيا باستخدام أحدث المعدات</h2>
          <p style="color: var(--gray); line-height: 1.9; font-size: 1.1rem;">
            مع التطور العمراني والتوسع في مشاريع البناء بمحافظة المنيا، تزداد الحاجة لحلول احترافية في قص وتخريم الخرسانة. شركة <strong>دريل ماكس</strong> تصل إليك في المنيا مزوّدة بأحدث ماكينات الكور دريل والمناشير الماسية، لتقديم فتحات دقيقة ونظيفة بدون أي تشقق أو تدمير للهيكل الإنشائي.
          </p>
          <ul style="color: var(--gray); line-height: 2; padding-right: 20px; margin-top: 15px;">
            <li>✅ تنفيذ فتحات كور بأقطار مختلفة (من 5 سم حتى 60 سم)</li>
            <li>✅ قص الخرسانة بالمنشار الماسي في خطوط مستقيمة ودقيقة</li>
            <li>✅ العمل في جميع أنواع الخرسانة المسلحة والعادية</li>
            <li>✅ الوصول لجميع مراكز ومدن المنيا بسرعة واحترافية</li>
          </ul>
        </div>
        <div class="half-box img-box shadow-hover" style="min-height: auto;">
          <img src="/images/تقطيع-بمنشار-الخرسانة.webp" alt="قص خرسانة بالمنيا" style="width: 100%; border-radius: 12px; object-fit: cover;" />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES CARDS -->
  <section class="services-cards py-section border-top">
    <div class="container">
      <div class="text-center section-header mb-5">
        <span class="section-subtitle">خدماتنا في المنيا</span>
        <h2>ماذا نقدم لك في محافظة المنيا؟</h2>
        <p style="color: var(--gray); max-width: 700px; margin: 15px auto;">نغطي جميع احتياجات قص وتخريم الخرسانة سواء للمنازل أو الشركات أو المشاريع الكبرى</p>
      </div>

      <div class="services-grid">
        <div class="service-card shadow-hover">
          <div class="service-content text-right">
            <h3>تخريم فتحات الغاز والمداخن</h3>
            <p class="service-desc">تنفيذ دقيق لفتحات الغاز الطبيعي والمداخن بمعايير شركات الغاز بدون تكسير أو تشقق.</p>
          </div>
        </div>
        <div class="service-card shadow-hover">
          <div class="service-content text-right">
            <h3>فتحات تكييف وتهوية</h3>
            <p class="service-desc">عمل مسارات التكييف المركزي والسبليت وفتحات التهوية بأي قطر مطلوب.</p>
          </div>
        </div>
        <div class="service-card shadow-hover">
          <div class="service-content text-right">
            <h3>قص الخرسانة بالمنشار الماسي</h3>
            <p class="service-desc">قطع الخرسانة في خطوط مستقيمة دقيقة لأعمال التوسعة والتعديل الإنشائي.</p>
          </div>
        </div>
        <div class="service-card shadow-hover">
          <div class="service-content text-right">
            <h3>أعمال السباكة والكهرباء</h3>
            <p class="service-desc">تخريم مسارات المياه والصرف والكابلات الكهربائية بشكل نظيف ومحكم.</p>
          </div>
        </div>
        <div class="service-card shadow-hover">
          <div class="service-content text-right">
            <h3>فتحات المصاعد والسلالم</h3>
            <p class="service-desc">تنفيذ الفتحات الكبيرة اللازمة لتركيب المصاعد والدرج في المباني القائمة.</p>
          </div>
        </div>
        <div class="service-card shadow-hover">
          <div class="service-content text-right">
            <h3>تخريم فتحات الشفاطات</h3>
            <p class="service-desc">عمل فتحات خروج الشفاطات في الخرسانة بدقة عالية وبدون إتلاف الواجهات.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AREAS IN MINYA -->
  <section class="py-section bg-light border-top">
    <div class="container">
      <div class="text-center section-header mb-5">
        <span class="section-subtitle">التغطية الجغرافية</span>
        <h2>مراكز ومدن محافظة المنيا التي نخدمها</h2>
        <p style="color: var(--gray); max-width: 700px; margin: 15px auto;">نصل إلى جميع مراكز ومدن المنيا بسرعة واحترافية</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px;">
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 مدينة المنيا</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 مغاغة</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 بني مزار</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 ملوي</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 سمالوط</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 أبو قرقاص</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 العدوة</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 مطاي</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 دير مواس</div>
        <div style="background: white; border-radius: 10px; padding: 12px 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); font-weight: 600; color: var(--primary); border: 1px solid #e8f0fe;">📍 بني خالد</div>
