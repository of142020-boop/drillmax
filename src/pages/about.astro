---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="من نحن - Drill Max - Drill Max | دريل ماكس لخدمات قص وتخريم الخرسانة - 01070046464" 
  description="نحن - Drill Max تأسست على يد فريق من المهندسين وأمهر الفنيين (صنايعي كور وصنايعي منشار) الذين يمتلكون خبرة طويلة في قطاع المقاولات والإنشاءات."
>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
        <span class="hero-subtitle">من نحن</span>
        <h1 style="text-align: center; font-size: 3.5rem;">عن شركة Drill Max</h1>
        <p style="text-align: center; font-size: 1.3rem;">خبرة هندسية، دقة والتزام في كل مشروع</p>
      </div>
    </div>
  </section>

  <!-- ABOUT INTRODUCTION SECTION -->
  <section class="py-section">
    <div class="container">
      <div class="row-flex align-center">
        <div class="half-box content-box">
          <h2 style="color: var(--dark); font-size: 2.2rem; margin-bottom: 20px;">نحن - Drill Max</h2>
          <p style="color: var(--gray); font-size: 1.15rem; line-height: 1.9; margin-bottom: 20px;">
            تأسست على يد فريق من المهندسين وأمهر الفنيين (<a href="/core-drilling-صنايعي-كور/">صنايعي كور</a> و<a href="/saw-cuttingقص-خرسانة/">صنايعي منشار</a>) الذين يمتلكون خبرة طويلة في قطاع المقاولات والإنشاءات. رؤيتنا هي أن نكون الشريك الأول والموثوق لكل مشروع في مصر يتطلب دقة متناهية.
          </p>
          <h3 style="color: var(--primary); font-size: 1.5rem; margin-bottom: 15px;">خبرتنا تمتد في جميع أنحاء الجمهورية</h3>
          <p style="color: var(--gray); font-size: 1.1rem; line-height: 1.9; margin-bottom: 30px;">
            نحن - Drill Max لا نوفر مجرد خدمة، بل نقدم حلاً هندسياً متكاملاً يبدأ من المعاينة الدقيقة وينتهي بالتسليم النظيف والآمن، مع التزام كامل بالمواصفات الفنية والجداول الزمنية.
          </p>
          <a href="/contact/" class="btn btn-primary">تواصل معنا الآن</a>
        </div>
        <div class="half-box img-box shadow-hover">
          <img src="/images/Untitled-134.webp" alt="عمل فتحات في الخرسانة" style="width: 100%; border-radius: 12px; object-fit: cover; height: 100%; min-height: 400px;" />
        </div>
      </div>
    </div>
  </section>

  <!-- STATS SECTION -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">+753</div>
          <div class="stat-title">مشروع مُكتمل</div>
          <p>لقد قمنا بتنفيذ أكثر من 753 مشروعًا متنوعًا لعملائنا في القطاعين السكني والصناعي بنجاح.</p>
        </div>
        <div class="stat-card">
          <div class="stat-number">+10</div>
          <div class="stat-title">سنوات من الخبرة</div>
          <p>أكثر من 10 سنوات من الخبرة الميدانية في أصعب مشاريع قص وتخريم الخرسانة المسلحة.</p>
        </div>
        <div class="stat-card">
          <div class="stat-number">98%</div>
          <div class="stat-title">نسبة رضا العملاء</div>
          <p>نلتزم بتحقيق رضا العملاء الكامل من خلال تقديم أعلى مستويات الجودة والدقة في التنفيذ.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VISION MISSION VALUES SECTION -->
  <section class="py-section bg-light">
    <div class="container">
      <div class="section-header text-center mb-5">
        <h2 style="font-size: 2.5rem; color: var(--dark);">رؤيتنا، رسالتنا، وقيمنا</h2>
      </div>
      <div class="values-grid mt-5">
        <!-- Values -->
        <div class="value-card text-center">
          <div class="value-icon">🎯</div>
          <h3>قيمنا: الدقة المتناهية</h3>
          <p>نؤمن بأن الدقة هي أساس كل عمل ناجح. قيمنا تحتم علينا تنفيذ كل فتحة وقص بأبعاد مثالية، لأننا ندرك أن المليمتر الواحد يصنع الفارق في المشاريع الهندسية.</p>
        </div>
        <!-- Mission -->
        <div class="value-card text-center">
          <div class="value-icon">🛡️</div>
          <h3>رسالتنا: الأمان أولاً</h3>
          <p>رسالتنا هي تقديم حلول هندسية آمنة تحافظ على سلامة المباني والأفراد. نحن نلتزم بتطبيق أعلى معايير السلامة في كل خطوة، من التخطيط إلى التسليم النهائي.</p>
        </div>
        <!-- Vision -->
        <div class="value-card text-center">
          <div class="value-icon">🚀</div>
          <h3>رؤيتنا: الريادة بالخبرة</h3>
          <p>رؤيتنا هي أن نكون الشريك الأول والموثوق في مصر لخدمات قص وتخريم الخرسانة، من خلال فريق من الخبراء والمهندسين الذين يقدمون حلولاً مبتكرة وموثوقة.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US SECTION -->
  <section class="py-section">
    <div class="container">
      <div class="row-flex align-center flex-row-reverse">
        <div class="half-box content-box">
          <span class="section-subtitle">أساس عملنا</span>
          <h2 style="color: var(--dark); font-size: 2rem; margin-bottom: 20px;">التزامنا بالجودة هو ما يدفعنا للتميز</h2>
          <p style="color: var(--gray); font-size: 1.1rem; line-height: 1.8; margin-bottom: 20px;">
            نؤمن بأن كل مشروع هو فرصة لإثبات جدارتنا. ما يدفعنا هو تقديم حلول هندسية تتجاوز توقعات العميل، مع الالتزام الكامل بالمواصفات الفنية والجداول الزمنية، لنكون دائمًا الشريك الأول والموثوق في هذا المجال.
          </p>
          <ul class="styled-list">
            <li>فريق عمل مؤهل من أمهر الفنيين والمهندسين.</li>
            <li>استخدام أحدث معدات قص وتخريم الخرسانة.</li>
            <li>الالتزام الصارم بالمواعيد النهائية للمشاريع.</li>
            <li>تسليم موقع العمل نظيفًا وآمنًا بعد انتهاء التنفيذ.</li>
          </ul>
        </div>
        <div class="half-box img-box shadow-hover">
          <img src="/images/مهم-1.webp" alt="نحن - Drill Max" style="width: 100%; border-radius: 12px; object-fit: cover; height: 100%; min-height: 400px;" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="py-section bg-dark text-white text-center">
    <div class="container" style="max-width: 800px;">
      <h2 style="font-size: 2.2rem; margin-bottom: 20px;">خبرتنا في خدمتكم</h2>
      <p style="font-size: 1.15rem; line-height: 1.9; margin-bottom: 30px; color: #cbd5e1;">
        هل يتطلب مشروعك تعديلاً إنشائياً وتحتاج إلى خبراء في معالجة الخرسانة؟ نحن – Drill Max فريقك المتخصص لتنفيذ كافة أعمال قص وتخريم الخرسانة المسلحة بدقة متناهية. نوفر <a href="/core-drilling-صنايعي-كور/" style="color: #fff; text-decoration: underline;">فني كور</a> محترف لعمل فتحات السباكة والكهرباء النظيفة، و<a href="/saw-cuttingقص-خرسانة/" style="color: #fff; text-decoration: underline;">فني منشار</a> لتنفيذ قص الأسقف والجدران باستخدام معدات حديثة تضمن عدم التأثير على سلامة المبنى. سواء كنت تبحث عن أفضل أسعار الكور دريل أو تحتاج إلى مقاول معتمد لإنجاز تعديلات معمارية معقدة، فإننا نضمن لك تنفيذًا احترافيًا والتزامًا كاملاً بالمواعيد.
      </p>
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <a href="https://wa.me/201070046464" class="btn btn-primary" target="_blank" rel="noopener noreferrer">تواصل عبر واتساب</a>
        <a href="tel:01070046464" class="btn btn-outline" style="color: #fff; border-color: #fff;">اتصل بنا الآن</a>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  /* Base & Utility */
  .py-section { padding: 80px 0; }
  .bg-light { background-color: var(--section-bg); }
  .bg-dark { background-color: var(--header-bg); }
  .text-white { color: #fff; }
  .text-center { text-align: center; }
  .mb-5 { margin-bottom: 40px; }
  .mt-5 { margin-top: 40px; }
  
  .section-subtitle {
    color: var(--primary);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: inline-block;
  }

  .btn {
    display: inline-block;
    padding: 14px 30px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.3s, color 0.3s, transform 0.3s, border-color 0.3s;
    border: none;
    text-align: center;
    text-decoration: none;
  }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); }
  .btn-outline { background: transparent; border: 2px solid; }
  .btn-outline:hover { background: #fff; color: var(--header-bg) !important; transform: translateY(-2px); }

  /* Hero Section */
  .hero {
    position: relative;
    height: 45vh;
    min-height: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: url('/images/خدمات-منشار-الخرسانة.webp') center/cover no-repeat;
    z-index: 1;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to right, rgba(30, 37, 48, 0.7), rgba(30, 37, 48, 0.95));
  }
  .hero-container {
    position: relative;
    z-index: 2;
  }
  .hero-subtitle {
    color: var(--primary);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 15px;
    display: block;
  }
  .hero h1 {
    color: #fff;
    line-height: 1.3;
    margin-bottom: 20px;
    font-weight: 800;
  }
  .hero p {
    color: #cbd5e1;
    line-height: 1.8;
  }

  /* Layouts */
  .row-flex { display: flex; gap: 40px; flex-wrap: wrap; }
  .align-center { align-items: center; }
  .flex-row-reverse { flex-direction: row-reverse; }
  .half-box { flex: 1; min-width: 300px; }
  .img-box { height: 100%; min-height: 350px; overflow: hidden; border-radius: 12px; }
  .shadow-hover { transition: transform 0.3s, box-shadow 0.3s; }
  .shadow-hover:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.08); }
  .content-box { background: #fff; padding: 50px; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: 0 5px 30px rgba(0,0,0,0.03); }

  /* Lists */
  .styled-list {
    margin-right: 20px;
    color: var(--gray);
    line-height: 1.9;
  }
  .styled-list li { margin-bottom: 10px; font-size: 1.05rem; }
  .styled-list li::marker { color: var(--primary); }

  /* Stats Section */
  .stats-section {
    background-color: var(--primary);
    padding: 60px 0;
    color: #000;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    text-align: center;
  }
  .stat-card {
    background: rgba(255, 255, 255, 0.95);
    padding: 40px 30px;
    border-radius: 12px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .stat-number {
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 10px;
  }
  .stat-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 15px;
  }
  .stat-card p {
    color: var(--gray);
    line-height: 1.6;
    margin: 0;
  }

  /* Values Grid */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  .value-card {
    background: #fff;
    padding: 40px 30px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: 0 5px 20px rgba(0,0,0,0.02);
    transition: transform 0.3s;
  }
  .value-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.08);
  }
  .value-icon {
    font-size: 3.5rem;
    margin-bottom: 20px;
    display: inline-block;
  }
  .value-card h3 {
    color: var(--dark);
    font-size: 1.4rem;
    margin-bottom: 15px;
  }
  .value-card p {
    color: var(--gray);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2.2rem !important; }
    .content-box { padding: 30px 15px; }
    .py-section { padding: 40px 0; }
    .row-flex { gap: 20px; }
    .half-box { min-width: 100%; }
    .hero { min-height: 250px; }
    .img-box { min-height: 250px; }
    .stats-grid, .values-grid { grid-template-columns: 1fr; }
  }
</style>
