---
import MainLayout from '../layouts/MainLayout.astro';

const PHONE    = "01070046464";
const WHATSAPP = `https://wa.me/20${PHONE}`;

const ALEX_AREAS = [
  { name: "سموحة والعصافرة", popular: true },
  { name: "محطة الرمل والإبراهيمية", popular: true },
  { name: "المنتزه وسيدي بشر", popular: true },
  { name: "لوران وجليم ورشدي", popular: true },
  { name: "كليوباترا والسيوف", popular: false },
  { name: "أبو قير والمعمورة", popular: false },
  { name: "برج العرب والعامرية", popular: false },
  { name: "محرم بك وكرموز", popular: false },
  { name: "باب شرق والمنشية", popular: false },
  { name: "الدخيلة والورديان", popular: false },
  { name: "بكوس والجمرك", popular: false },
  { name: "العجمي والهانوفيل", popular: false },
];

const STATS = [
  { num: "+500", label: "مشروع منجز في الإسكندرية" },
  { num: "24h", label: "استجابة أقصى وقت للوصول" },
  { num: "0%", label: "نسبة الشكاوى من عملائنا" },
  { num: "10+", label: "سنوات خبرة في التخريم" },
];

const PROCESS = [
  { step: "01", title: "الاتصال والاستشارة", desc: "تواصل معنا هاتفياً أو واتساب، أخبرنا بنوع العمل وموقعك في الإسكندرية وسنرد فوراً." },
  { step: "02", title: "المعاينة المجانية", desc: "يصل فريقنا الفني لمعاينة الجدار أو السقف، يستخدم الكاشف لتحديد الحديد ويضع علامات القص." },
  { step: "03", title: "عرض السعر الشفاف", desc: "نحدد التكلفة بناءً على سماكة الخرسانة وعدد الفتحات. بدون أي أرقام مفاجئة أو رسوم خفية." },
  { step: "04", title: "التنفيذ بالمعدات", desc: "نبدأ القص والتخريم بالكور دريل أو المنشار الماسي مع ضخ الماء لإزالة الغبار فوراً." },
  { step: "05", title: "التسليم والنظافة", desc: "ننهي العمل ونزيل أي مخلفات. الفتحة جاهزة لتركيب المواسير أو الأبواب مباشرة." },
];

const FAQ = [
  {
    q: "هل تعملون في تخريم الخرسانة بمباني الأبراج السكنية الساحلية في الإسكندرية؟",
    a: "نعم، ومن أكثر مجالات عملنا في الإسكندرية. الأبراج الساحلية في سموحة ولوران والمنتزه تتميز بخرسانة ذات إجهاد عالٍ وحديد تسليح كثيف. نستخدم ماكينات كور دريل ألمانية القوة مع نظام التبريد المائي لضمان فتحات دقيقة لا تؤثر على سلامة الهيكل."
  },
  {
    q: "ما أقطار الكور المتاحة وأيها مناسب لفتحة التكييف؟",
    a: "نوفر أقطاراً من 1 إلى 14 بوصة. لتكييف السبليت المنزلي يُستخدم عادةً 3-4 بوصة. للتكييف المركزي والدكتات يكون 8-12 بوصة. الفريق يحدد القطر الدقيق عند المعاينة وفقاً لأبعاد مواسير التكييف الخاص بك."
  },
  {
    q: "هل يتسبب القص والتخريم في إزعاج الجيران في الأبراج السكنية؟",
    a: "هذا السؤال يطرحه معظم عملاء الإسكندرية. الإجابة: لا. الكور دريل والمنشار الماسي يعملان بضوضاء أقل بكثير من الهمر أو الأزميل. وتقنية التبريد المائي تمتص الاهتزازات وتمنع تطاير أي غبار داخل الشقة أو الممر."
  },
  {
    q: "هل تعملون في فتح أبواب جديدة في الجدران الخرسانية بالإسكندرية؟",
    a: "بالتأكيد، هذه من أكثر الخدمات طلباً. نقوم بمعاينة الجدار بالكاشف الإلكتروني لتحديد أماكن حديد التسليح، ثم نقص بالمنشار الماسي خطاً مستقيماً دقيقاً. الفتحة تخرج جاهزة تماماً لتركيب الباب دون أي تدخل إضافي."
  },
  {
    q: "هل تنفذون فتحات الغاز الطبيعي وفق اشتراطات شركة غاز الإسكندرية؟",
    a: "نعم، ننفذ كل فتحات الغاز بالأقطار المعتمدة (عادةً 1.5 إلى 3 بوصة حسب المتطلب). الفتحة الدائرية المنتظمة تسهل على فني الغاز تمرير الماسورة وتثبيتها وتركيب الكوع بأمان تام ووفقاً لمعايير شركة طاقة."
  },
  {
    q: "ما الفرق بين تخريم الكور وقص الخرسانة بالمنشار؟",
    a: "الكور دريل = فتحات دائرية: للتكييف، الغاز، السباكة، الصرف، الكهرباء. المنشار الماسي = قطوع مستقيمة: لفتح الأبواب والشبابيك وتوسعة الفتحات القائمة وقص الأسقف لعمل سلم داخلي. كل واحدة منهما لها استخدامها المحدد وفريقنا يحدد الأنسب لك."
  },
  {
    q: "هل يمكن تنفيذ العمل في نفس يوم طلب المعاينة؟",
    a: "في كثير من الحالات نعم. إذا كان العمل بسيطاً (فتحة أو اثنتين) يمكن تنفيذه فور المعاينة. للمشاريع الكبيرة نحدد موعداً في اليوم التالي. الهدف دائماً إنهاء العمل بأسرع وقت ممكن."
  },
  {
    q: "كيف تتأكدون من عدم الإضرار بحديد التسليح عند القص؟",
    a: "نستخدم جهاز كشف حديد التسليح (Rebar Detector) قبل أي قطعة. هذا الجهاز يحدد أماكن قضبان الحديد بدقة ويجعلنا نضع خط القص في المناطق الآمنة بين القضبان، مما يحافظ تماماً على سلامة الهيكل الإنشائي."
  },
];

const SERVICES = [
  { icon: "🔥", title: "فتحات الغاز الطبيعي", desc: "فتحات دائرية بأقطار معتمدة من شركة غاز الإسكندرية، نظيفة ومنتظمة.", details: "أقطار 1.5 حتى 3 بوصة" },
  { icon: "❄️", title: "تخريم التكييف والتهوية", desc: "مسارات السبليت والتكييف المركزي بأي قطر مطلوب في الأبراج والشقق.", details: "أقطار 3 حتى 12 بوصة" },
  { icon: "✂️", title: "قص الخرسانة بالمنشار", desc: "فتح الأبواب والشبابيك في الجدران المسلحة بخط هندسي مستقيم تماماً.", details: "لأي سماكة جدار" },
  { icon: "🚰", title: "صواعد السباكة والصرف", desc: "تمرير مواسير الصرف الصحي والمياه في المناور بفتحات دائرية دقيقة.", details: "أقطار 4 حتى 14 بوصة" },
  { icon: "🏗️", title: "فتحات المصاعد والسلالم", desc: "قص الأسقف الخرسانية لعمل فتحات السلالم الداخلية والمصاعد الخارجية.", details: "أبعاد حسب المشروع" },
  { icon: "💨", title: "فتحات الشفاطات والمداخن", desc: "خروج شفاطات المطابخ والمداخن من الجدران الخارجية بدون إتلاف الواجهات.", details: "أقطار 6 حتى 10 بوصة" },
  { icon: "⚡", title: "مسارات الكهرباء والكابلات", desc: "فتحات دقيقة لتمرير كابلات الإنترنت والكهرباء بين الطوابق.", details: "أقطار 1 حتى 3 بوصة" },
  { icon: "🔩", title: "تخريم الأساسات والسدادات", desc: "تخريم السدادات الخرسانية لتمرير التوصيلات في المباني الجديدة.", details: "أعماق مختلفة" },
];

const WHY_US = [
  { icon: "⚡", title: "سرعة الاستجابة في كامل الإسكندرية", desc: "فريقنا متواجد في الإسكندرية ويصل من أبو قير شرقاً حتى العجمي غرباً. متوسط وقت الوصول للعمل العاجل ساعتين فقط." },
  { icon: "🔧", title: "ماكينات Hilti الألمانية الأحدث", desc: "نستخدم ماكينات Hilti DD 200-E وDD 350 المزودة بنظام التبريد المائي، قادرة على التخريم في أصلب الخرسانة المسلحة بالإسكندرية." },
  { icon: "📐", title: "خبرة مؤكدة في الأبراج الساحلية", desc: "الأبراج والمباني المرتفعة بالإسكندرية تحتاج لمعالجة خاصة. خبرتنا الممتدة في هذا النوع من المباني تضمن نتائج مثالية في كل طابق." },
  { icon: "🌊", title: "حماية التسليح من التآكل الملحي", desc: "الجدران القريبة من البحر تحتاج لقص نظيف يحافظ على طبقة التغطية فوق حديد التسليح لحمايته من الرطوبة والأملاح البحرية." },
  { icon: "🤝", title: "تسعير شفاف موثق كتابياً", desc: "نقدم عرض السعر قبل البدء ويُوقَّع عليه من الطرفين. لا توجد أي مبالغ إضافية تُضاف بعد إنهاء العمل." },
  { icon: "🧹", title: "نظافة تامة وتسليم سريع", desc: "نزيل كل المخلفات والأتربة عند الانتهاء. نسلّم الموقع نظيفاً جاهزاً للمرحلة التالية مباشرة." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "دريل ماكس لقص وتخريم الخرسانة بالإسكندرية",
    "description": "أفضل شركة متخصصة في تخريم الخرسانة بالكور دريل وقص الجدران بالمنشار الماسي في الإسكندرية. خدمة تغطي جميع أحياء المحافظة.",
    "url": "https://drilmax.com/alexandria-concrete-cutting-core/",
    "telephone": "+2001070046464",
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "الإسكندرية", "addressRegion": "EG-ALX", "addressCountry": "EG" },
    "geo": { "@type": "GeoCoordinates", "latitude": 31.2001, "longitude": 29.9187 },
    "openingHours": "Mo-Su 00:00-23:59",
    "areaServed": [{ "@type": "City", "name": "الإسكندرية" }],
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "127" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map(x => ({ "@type": "Question", "name": x.q, "acceptedAnswer": { "@type": "Answer", "text": x.a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://drilmax.com", "name": "الرئيسية" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://drilmax.com/services/", "name": "الخدمات" } },
      { "@type": "ListItem", "position": 3, "item": { "@id": "https://drilmax.com/alexandria-concrete-cutting-core/", "name": "قص وتخريم خرسانة بالإسكندرية" } }
    ]
  }
]);
---

<MainLayout
  title="قص وتخريم خرسانة بالإسكندرية | كور ومنشار ماسي | 01070046464"
  description="أفضل خدمة تخريم الخرسانة بالكور وقص الجدران بالمنشار الماسي في الإسكندرية. فتحات الغاز والتكييف والسباكة وفتح الأبواب في جميع أحياء المحافظة بدون تكسير. اتصل 01070046464."
  canonical="/alexandria-concrete-cutting-core/"
  ogImage="/images/drilling-core.webp"
  schema={schema}
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
        <nav aria-label="breadcrumb" style="margin-bottom: 16px; font-size: 0.9rem; color: rgba(255,255,255,0.7); display:flex; align-items:center; justify-content:center; gap:6px;">
          <a href="/" style="color: rgba(255,255,255,0.7); text-decoration: none;">الرئيسية</a>
          <span>›</span>
          <a href="/services/" style="color: rgba(255,255,255,0.7); text-decoration: none;">الخدمات</a>
          <span>›</span>
          <span style="color: #fff;">الإسكندرية</span>
        </nav>
        <div class="hero-rating">⭐⭐⭐⭐⭐ <span>4.9/5 من 127+ عميل في الإسكندرية</span></div>
        <h1 style="text-align: center; font-size: clamp(1.9rem, 4.5vw, 3.2rem); line-height: 1.3; margin-top: 12px;">
          قص وتخريم خرسانة بالإسكندرية<br>
          <span style="color: #7dd3fc;">بالكور دريل والمنشار الماسي</span>
        </h1>
        <p style="text-align: center; font-size: 1.2rem; margin-top: 18px; color: rgba(255,255,255,0.9); line-height: 1.9; max-width: 720px; margin-left: auto; margin-right: auto;">
          لأن الأبراج والمباني الساحلية بالإسكندرية تتطلب دقة هندسية استثنائية، نوفر أحدث معدات القص والتخريم بتقنية التبريد المائي — <strong style="color:#fff;">بدون غبار، بدون اهتزاز، بدون ضرر للهيكل</strong>.
        </p>
        <div style="display: flex; gap: 12px; margin-top: 30px; justify-content: center; flex-wrap: wrap;">
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="font-size: 1.1rem; padding: 16px 36px; gap: 8px;">💬 واتساب مباشر</a>
          <a href={`tel:${PHONE}`} class="btn btn-outline" style="background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.4); font-size: 1.1rem; padding: 16px 36px;">📞 {PHONE}</a>
        </div>
        <div class="hero-trust">
          <span>✅ معاينة مجانية</span>
          <span>✅ سعر مكتوب مسبقاً</span>
          <span>✅ تنفيذ في نفس اليوم</span>
          <span>✅ ضمان الجودة</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar">
    <div class="container stats-inner">
      {STATS.map(s => (
        <div class="stat-item">
          <div class="stat-num">{s.num}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="container city-page-wrapper">
    <div class="city-page-grid">
      <main class="city-main-content">

        <!-- INTRO SECTION -->
        <section class="city-card">
          <div class="inline-badge">✅ الأول في قص وتخريم الخرسانة بعروس البحر المتوسط</div>
          <h2 style="margin-top:15px;">تخريم وقص الخرسانة المسلحة في الإسكندرية — الخدمة الكاملة</h2>

          <img src="/images/drilling-core.webp" alt="فريق دريل ماكس يقوم بتخريم الخرسانة بالكور دريل في مبنى سكني بالإسكندرية" style="width:100%; border-radius:16px; margin: 18px 0 22px; object-fit:cover; max-height:420px; box-shadow:0 10px 40px rgba(0,0,0,0.12);" loading="eager" />

          <p>الإسكندرية، عروس البحر المتوسط والعاصمة الثانية لمصر، تتميز بتنوع معماري فريد يجمع بين الأبراج الساحلية الحديثة والمباني التراثية القديمة. هذا التنوع يعني أن أعمال قص الخرسانة وتخريمها تحتاج لخبرة استثنائية في التعامل مع مختلف أنواع الخرسانة والهياكل الإنشائية.</p>
          <p style="margin-top: 14px;">فريق <strong>دريل ماكس</strong> في الإسكندرية يمتلك هذه الخبرة ويضعها في خدمتك سواء كنت تحتاج فتحة تكييف في شقة بسموحة، أو تريد قص جدار لفتح باب في فيلا برشدي، أو تنفذ مشروعاً كاملاً في برج سكني بالمنتزه. نصلك في أسرع وقت ونُنهي العمل بدقة هندسية لا تقبل المساومة.</p>

          <div class="check-grid">
            <div class="check-item"><span class="check-icon">✓</span> التسليح الداخلي محمي بالكاشف الإلكتروني</div>
            <div class="check-item"><span class="check-icon">✓</span> قص ناعم بدون اهتزازات تضر المبنى</div>
            <div class="check-item"><span class="check-icon">✓</span> نظام تبريد مائي = صفر غبار</div>
            <div class="check-item"><span class="check-icon">✓</span> الفتحة جاهزة لتركيب مباشر</div>
            <div class="check-item"><span class="check-icon">✓</span> يعملون في المباني المأهولة</div>
            <div class="check-item"><span class="check-icon">✓</span> تغطية 12+ حي في الإسكندرية</div>
          </div>

          <img src="/images/صنايعي-كور-في-الاسكندرية-1.webp" alt="تخريم فتحات تكييف في شقة سكنية بسموحة الإسكندرية" onerror="this.style.display='none'" style="width:100%; border-radius:16px; margin-top:24px; object-fit:cover; max-height:320px; box-shadow:0 8px 30px rgba(0,0,0,0.1);" loading="lazy" />
        </section>

        <!-- SERVICES GRID -->
        <section class="city-card">
          <h2>خدماتنا الكاملة في الإسكندرية</h2>
          <p style="color: var(--gray); margin-bottom: 24px;">من الشقة السكنية في سيدي بشر إلى البرج التجاري في محطة الرمل — نوفر كل ما تحتاجه:</p>
          <div class="services-full-grid">
            {SERVICES.map(s => (
              <div class="service-full-card">
                <div class="service-icon-big">{s.icon}</div>
                <div class="service-content">
                  <h3>{s.title}</h3>
                  <p>{s.desc}</p>
                  <span class="service-tag">{s.details}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- PROCESS -->
        <section class="city-card">
          <h2>كيف نعمل في الإسكندرية؟ — خطوات التنفيذ</h2>
          <p style="margin-bottom: 28px;">نتبع نظاماً محكماً يضمن لك أعلى جودة وأسرع تسليم:</p>
          <div class="process-list">
            {PROCESS.map(p => (
              <div class="process-item">
                <div class="process-step">{p.step}</div>
                <div class="process-content">
                  <h3>{p.title}</h3>
                  <p>{p.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- WHY US -->
        <section class="city-card">
          <h2>6 أسباب تجعل دريل ماكس هي الخيار الأمثل في الإسكندرية</h2>
          <p style="margin-bottom: 24px;">لا تتعامل مع أي عامل عشوائي يستخدم الهمر في قص الخرسانة. إليك لماذا نحن مختلفون:</p>
          <div class="why-grid">
            {WHY_US.map(w => (
              <div class="why-card">
                <span class="why-icon-lg">{w.icon}</span>
                <div>
                  <strong>{w.title}</strong>
                  <p>{w.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- AREAS TABLE -->
        <section class="city-card">
          <h2>أحياء الإسكندرية التي نخدمها</h2>
          <p style="margin-bottom: 24px; color: var(--gray);">فريقنا يصل لكل أحياء الإسكندرية من الشرق للغرب. الأحياء المميزة بـ ⭐ هي الأعلى طلباً لخدماتنا:</p>
          <div class="areas-grid">
            {ALEX_AREAS.map(a => (
              <div class={`area-card ${a.popular ? 'popular' : ''}`}>
