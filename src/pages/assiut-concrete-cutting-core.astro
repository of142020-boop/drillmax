---
import MainLayout from '../layouts/MainLayout.astro';

const PHONE    = "01070046464";
const WHATSAPP = `https://wa.me/2${PHONE}`;

const ASSIUT_AREAS = [
  "مدينة أسيوط وكورنيشها",
  "ديروط والقوصية",
  "منفلوط وساحل سليم",
  "أبنوب وأبو تيج",
  "الفتح والغنايم",
  "الشغب وصدفا",
  "أسيوط الجديدة",
  "المنطقة الصناعية أسيوط",
];

const FAQ = [
  {
    q: "هل تناسب معداتكم الخرسانة شديدة الكثافة في مباني أسيوط؟",
    a: "نعم. مباني أسيوط والصعيد الأوسط معروفة بإجهاداتها العالية ونسب الحديد الكثيفة فيها. ماكيناتنا ألمانية الصنع ذات طاقة اختراق عالية جداً، مصممة للتعامل مع أصعب أنواع الخرسانة المسلحة."
  },
  {
    q: "هل يمكنكم تخريم فتحات التكييف في الأدوار العلوية بالعمارات السكنية في أسيوط؟",
    a: "بالتأكيد. فريقنا مجهز للعمل في كل الأدوار مهما بلغ ارتفاعها. نصل للموقع بكل المعدات اللازمة ونُنهي العمل في الجلسة ذاتها بدون ضوضاء مزعجة أو تطاير للأتربة."
  },
  {
    q: "ما هو الفرق بين الكور دريل والمنشار الماسي؟ أيهما أحتاج لأسيوط؟",
    a: "الكور دريل لعمل الفتحات الدائرية: التكييف، الغاز، السباكة، الصرف. المنشار الماسي لعمل الفتحات المستطيلة: الأبواب، الشبابيك، قص الأسقف للسلالم الداخلية. الفريق يحدد الأنسب لك عند المعاينة."
  },
  {
    q: "هل تعملون في المناطق الصناعية حول أسيوط؟",
    a: "نعم، نقدم خدماتنا للمصانع والمنشآت الصناعية في المنطقة الصناعية بأسيوط وما حولها، سواء لعمل فتحات التوصيلات أو تركيب الأجهزة الثقيلة."
  },
  {
    q: "كيف أحجز موعداً للخدمة في أسيوط؟",
    a: "تواصل معنا عبر واتساب أو الهاتف على 01070046464، أخبرنا بنوع الفتحة وأبعادها وموقعك، وسنتواصل معك فوراً بعرض سعر وموعد محدد."
  }
];

const SERVICES = [
  { icon: "01", title: "فتحات الغاز الطبيعي", desc: "فتحات دائرية دقيقة مطابقة لمواصفات شركة الغاز في أسيوط." },
  { icon: "02", title: "فتحات التكييف", desc: "تخريم الخرسانة لتمرير مواسير التكييف المنزلي والمركزي." },
  { icon: "03", title: "قص بالمنشار الماسي", desc: "فتح الأبواب والشبابيك في الجدران المسلحة بخط مستقيم." },
  { icon: "04", title: "مسارات السباكة", desc: "فتحات دقيقة لمواسير الصرف والمياه في الحمامات والمطابخ." },
  { icon: "05", title: "قص الأسقف للسلالم", desc: "إحداث فتحات السلالم الداخلية بين الطوابق بدقة كاملة." },
  { icon: "06", title: "فتحات التهوية", desc: "تهوية المطابخ والحمامات ومداخن سخانات الغاز." },
];

const WHY_US = [
  { icon: "01", title: "تغطية شاملة لأسيوط والمحيطين", desc: "نصل لكل مراكز محافظة أسيوط، من ديروط شمالاً حتى أبو تيج ومنفلوط جنوباً." },
  { icon: "02", title: "معدات ثقيلة تناسب الصعيد", desc: "نمتلك ماكينات ألمانية بقدرة اختراق عالية تتغلب على كثافة الخرسانة في مباني الصعيد." },
  { icon: "03", title: "دقة الفتحة مضمونة", desc: "كل فتحة ننفذها تخرج بالمقاس الدقيق المطلوب، مناسبة للتركيبات مباشرة." },
  { icon: "04", title: "التزام وأمانة في التعامل", desc: "نقدم عرض سعر واضح وشفاف قبل البدء، ونلتزم بالموعد المتفق عليه دون تأخير." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "دريل ماكس لقص وتخريم الخرسانة بأسيوط",
    "description": "متخصصون في تخريم الخرسانة بالكور دريل وقص الجدران بالمنشار الماسي في أسيوط والصعيد الأوسط",
    "url": "https://drilmax.com/assiut-concrete-cutting-core/",
    "telephone": "+201070046464",
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "أسيوط", "addressRegion": "EG-AST", "addressCountry": "EG" },
    "geo": { "@type": "GeoCoordinates", "latitude": 27.1783, "longitude": 31.1859 },
    "openingHours": "Mo-Su 00:00-23:59",
    "areaServed": [{ "@type": "City", "name": "أسيوط" }]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map(x => ({ "@type": "Question", "name": x.q, "acceptedAnswer": { "@type": "Answer", "text": x.a } }))
  }
]);
---

<MainLayout
  title="قص وتخريم خرسانة بأسيوط | كور ومنشار ماسي | 01070046464"
  description="متخصصون في قص وتخريم الخرسانة المسلحة بأسيوط والصعيد الأوسط. فتحات تكييف وغاز وسباكة بمعدات ألمانية متطورة بدون تكسير واهتزاز. اتصل 01070046464."
  canonical="/assiut-concrete-cutting-core/"
  ogImage="/images/drilling-core.webp"
  schema={schema}
>

  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 850px; margin: 0 auto;">
        <nav aria-label="breadcrumb" style="margin-bottom: 16px; font-size: 0.9rem; color: rgba(255,255,255,0.7);">
          <a href="/" style="color: rgba(255,255,255,0.7); text-decoration: none;">الرئيسية</a>
          <span style="margin: 0 8px;">›</span>
          <span style="color: #fff;">خدمات أسيوط والصعيد الأوسط</span>
        </nav>
        <span class="hero-subtitle" style="color: rgba(255,255,255,0.85);">دريل ماكس | قلب الصعيد</span>
        <h1 style="text-align: center; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.3;">
          قص وتخريم خرسانة بأسيوط <br>بالكور دريل والمنشار الماسي
        </h1>
        <p style="text-align: center; font-size: 1.15rem; margin-top: 18px; color: rgba(255,255,255,0.9); line-height: 1.8;">
          خبرتنا في التعامل مع مباني الصعيد الأوسط تجعلنا الخيار الأمثل لأسيوط. نفتح الفتحات ونقص الجدران بدقة هندسية بدون أي تشقق أو اهتزاز.
        </p>
        <div style="display: flex; gap: 12px; margin-top: 28px; justify-content: center; flex-wrap: wrap;">
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="font-size: 1.05rem; padding: 14px 30px;">واتساب مباشر</a>
          <a href={`tel:+2${PHONE}`} class="btn btn-outline" style="background: rgba(255,255,255,0.15); color: #fff; border-color: rgba(255,255,255,0.5); font-size: 1.05rem; padding: 14px 30px;">اتصل: {PHONE}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="container city-page-wrapper">
    <div class="city-page-grid">
      <div class="city-main-content">
        <section class="city-card">
          <div class="inline-badge">خبراء قص وتخريم الخرسانة في قلب الصعيد</div>
          <h2 style="margin-top:15px;">خدمات قص وتخريم الخرسانة المتخصصة بأسيوط</h2>
          <img width="1200" height="1003" src="/images/drilling-core.webp" alt="تخريم خرسانة بالكور دريل في مبنى سكني بأسيوط" style="width:100%; border-radius:4px; margin: 15px 0 25px; object-fit:cover; max-height:400px; border:1px solid #dad7ce; padding:6px; background:#f5f4f0;" />
          <p>أسيوط، عاصمة الصعيد الأوسط، تعيش حركة عمرانية متنامية تضم مشاريع الدولة الكبرى كأسيوط الجديدة ومشاريع التطوير الريفي. هذه المباني ذات التسليح الكثيف والخرسانة القوية تحتاج لأدوات قص متخصصة قادرة على التعامل معها.</p>
          <p style="margin-top: 14px;">فريق <strong>دريل ماكس</strong> وصل للتحدي في أسيوط بماكينات ألمانية متطورة: كور دريل عالي الطاقة، ومنشار ماسي قادر على قص أي جدار خرساني مهما بلغت صلابته وسماكته. نضمن لك فتحة مثالية في الجدار أو السقف بدون دق أو تكسير.</p>
          <div class="check-grid">
            <div class="check-item"><span class="check-icon">✓</span> معدات تتغلب على خرسانة الصعيد</div>
            <div class="check-item"><span class="check-icon">✓</span> فتحات دائرية ومستطيلة بدقة</div>
            <div class="check-item"><span class="check-icon">✓</span> لا اهتزاز ولا تشقق في المبنى</div>
            <div class="check-item"><span class="check-icon">✓</span> تغطية أسيوط والمراكز المحيطة</div>
          </div>
        </section>

        <section class="city-card">
          <h2>أعمالنا وخدماتنا المتاحة في أسيوط</h2>
          <p style="color: var(--gray); margin-bottom: 20px;">من الشقق السكنية إلى المنشآت الصناعية، نقدم حلول قص وتخريم متكاملة:</p>
          <div class="services-mini-grid">
            {SERVICES.map(s => (
              <div class="service-mini-card">
                <div class="service-icon">{s.icon}</div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="city-card">
          <h2>لماذا دريل ماكس هي الأفضل في أسيوط؟</h2>
          <p style="margin-bottom: 20px;">لأننا نؤمن بأن كل مشروع يستحق أن يُنفَّذ بأعلى مستويات الاحترافية والدقة:</p>
          <div class="why-list">
            {WHY_US.map(w => (
              <div class="why-item">
                <span class="why-icon">{w.icon}</span>
                <div><strong>{w.title}</strong><p>{w.desc}</p></div>
              </div>
            ))}
          </div>
        </section>

        <section class="city-card">
          <h2>أسئلة شائعة من عملائنا في أسيوط</h2>
          <div class="faq-list">
            {FAQ.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                <p class="faq-a">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="city-sidebar">
        <div class="sidebar-cta">
          <h3>اطلب خدمتك في أسيوط</h3>
          <p>فريقنا جاهز لمعاينة موقعك وتقديم عرض سعر فوري.</p>
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="cta-whatsapp">واتساب مباشر</a>
          <a href={`tel:+2${PHONE}`} class="cta-phone">{PHONE}</a>
        </div>
        <div class="sidebar-dark">
          <h3>مناطق التغطية في أسيوط</h3>
          {ASSIUT_AREAS.map(area => (
            <div class="area-item"><span class="area-dot"></span>{area}</div>
          ))}
        </div>
        <div class="sidebar-card">
          <h3>خدمات في محافظات أخرى</h3>
          {[
            { href: "/minya-concrete-cutting-core/", label: "المنيا وصعيد مصر" },
            { href: "/alexandria-concrete-cutting-core/", label: "الإسكندرية" },
            { href: "/mansoura-concrete-cutting-core/", label: "المنصورة والدقهلية" },
            { href: "/hurghada-concrete-cutting-core/", label: "الغردقة والبحر الأحمر" },
            { href: "/services/", label: "جميع الخدمات" },
          ].map(s => (
            <a href={s.href} class="related-link"><span class="related-arrow">›</span>{s.label}</a>
          ))}
        </div>
      </aside>
    </div>

    <section class="bottom-cta">
      <div class="bottom-cta-glow"></div>
      <div class="bottom-cta-content">
        <div class="bottom-cta-text">
          <span class="cta-badge">في خدمتكم بأسيوط والصعيد الأوسط</span>
          <h2>ابدأ مشروعك بأدوات المحترفين</h2>
          <p>دريل ماكس وفرت حلولاً حديثة لقص وتخريم الخرسانة في أسيوط. تواصل معنا للحصول على معاينة وعرض سعر مجاني.</p>
          <div class="cta-phone-big">{PHONE}</div>
        </div>
        <div class="bottom-cta-buttons">
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn-wa">تواصل عبر الواتساب</a>
          <a href={`tel:+2${PHONE}`} class="btn-call">اتصل هاتفياً الآن</a>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.text-center { text-align: center; }
.hero-rating { display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.18); padding:7px 14px; border-radius:4px; font-size:0.9rem; color:#f5f4f0; }
.hero-trust { display:flex; flex-wrap:wrap; gap:16px; justify-content:center; margin-top:20px; }
.hero-trust span { color:#d6d3cb; font-size:0.92rem; display:flex; align-items:center; gap:5px; }
.stats-bar { background:#14171c; padding:26px 0; border-bottom:1px solid #262b34; }
.stats-inner { display:grid; grid-template-columns:repeat(4, 1fr); gap:18px; max-width:1200px; margin:0 auto; padding:0 20px; }
.stat-item { text-align:center; padding:8px; border-inline-end:1px solid rgba(255,255,255,0.1); }
.stat-item:last-child { border-inline-end:0; }
.stat-num { font-family:var(--font-display); font-size:2rem; font-weight:800; color:#fdba74; font-variant-numeric:tabular-nums; }
.stat-label { color:#c7cbd3; font-size:0.88rem; margin-top:4px; }
.city-page-wrapper { max-width:1200px; margin:0 auto; padding:52px 20px 64px; }
.city-page-grid { display:grid; grid-template-columns:1fr 330px; gap:32px; align-items:start; }
.city-main-content { display:flex; flex-direction:column; gap:28px; }
.city-card { background:#fff; border-radius:4px; border:1px solid var(--border-color, #dad7ce); padding:34px; }
.inline-badge { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:4px; background:var(--section-bg, #f5f4f0); border:1px solid var(--border-color, #dad7ce); color:var(--primary, #c2410c); font-weight:700; font-size:0.82rem; margin-bottom:12px; }
.city-card h2 { color:var(--dark, #14171c); font-size:clamp(1.4rem, 2.3vw, 1.75rem); margin-bottom:14px; font-weight:800; line-height:1.38; }
.city-card p { color:var(--gray, #4b5058); line-height:1.92; font-size:1.02rem; }
.city-card a { color:#9a3412; text-decoration:underline; text-underline-offset:4px; font-weight:600; }
.check-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:22px; }
.check-item { display:flex; align-items:center; gap:8px; padding:12px 14px; background:var(--section-bg, #f5f4f0); border-radius:4px; border:1px solid var(--border-color, #dad7ce); color:var(--dark, #14171c); font-weight:600; font-size:0.93rem; }
.check-icon { color:var(--primary, #c2410c); font-weight:800; font-size:1rem; }
.services-full-grid { display:flex; flex-direction:column; gap:12px; margin-top:20px; }
.service-full-card { display:flex; align-items:flex-start; gap:16px; padding:18px 20px; border-radius:4px; border:1px solid var(--border-color, #dad7ce); background:var(--section-bg, #f5f4f0); transition:border-color 0.2s, background-color 0.2s; }
.service-full-card:hover { border-color:var(--primary, #c2410c); background:#fff; }
.service-icon-big { font-family:var(--font-display); font-size:0.9rem; font-weight:800; flex-shrink:0; width:38px; height:38px; display:flex; align-items:center; justify-content:center; background:#14171c; color:#fdba74; border-radius:4px; font-variant-numeric:tabular-nums; }
.service-content h3 { color:var(--dark, #14171c); font-size:1.05rem; font-weight:800; margin-bottom:5px; }
.service-content p { color:var(--gray, #4b5058); font-size:0.93rem; line-height:1.7; margin:0; }
.service-tag { display:inline-block; margin-top:8px; padding:3px 10px; background:#eae8e1; color:#14171c; border-radius:3px; font-size:0.78rem; font-weight:700; }
.process-list { display:flex; flex-direction:column; gap:0; border-top:1px solid var(--border-color, #dad7ce); margin-top:16px; }
.process-item { display:flex; gap:18px; align-items:flex-start; padding:18px 0; border-bottom:1px solid var(--border-color, #dad7ce); }
.process-step { width:40px; height:40px; border-radius:4px; background:#14171c; color:#fdba74; font-weight:800; font-size:0.88rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-variant-numeric:tabular-nums; }
.process-content h3 { color:var(--dark, #14171c); font-weight:800; font-size:1.04rem; margin-bottom:5px; }
.process-content p { color:var(--gray, #4b5058); font-size:0.94rem; line-height:1.75; margin:0; }
.why-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.why-card { display:flex; gap:14px; align-items:flex-start; padding:18px; border-radius:4px; background:var(--section-bg, #f5f4f0); border:1px solid var(--border-color, #dad7ce); transition:border-color 0.2s; }
.why-card:hover { border-color:var(--primary, #c2410c); }
.why-icon-lg { font-family:var(--font-display); font-size:0.88rem; font-weight:800; flex-shrink:0; width:34px; height:34px; display:flex; align-items:center; justify-content:center; background:#14171c; color:#fdba74; border-radius:4px; font-variant-numeric:tabular-nums; }
.why-card strong { color:var(--dark, #14171c); display:block; margin-bottom:5px; font-size:0.98rem; }
.why-card p { color:var(--gray, #4b5058); margin:0; line-height:1.7; font-size:0.9rem; }
.areas-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:6px; }
.area-card { display:flex; align-items:center; gap:10px; padding:11px 14px; border-radius:4px; border:1px solid var(--border-color, #dad7ce); background:var(--section-bg, #f5f4f0); font-size:0.93rem; color:var(--dark, #14171c); font-weight:600; }
.area-card.popular { border-color:var(--primary, #c2410c); background:#fff; color:#9a3412; font-weight:700; }
.area-icon { font-size:0.75rem; color:var(--primary, #c2410c); }
.faq-list { display:flex; flex-direction:column; gap:0; margin-top:16px; border-top:1px solid var(--border-color, #dad7ce); }
.faq-item { border-bottom:1px solid var(--border-color, #dad7ce); padding:0; cursor:pointer; background:#fff; }
.faq-q { font-weight:700; color:var(--dark, #14171c); font-size:1.02rem; list-style:none; display:flex; justify-content:space-between; align-items:center; gap:12px; padding:18px 4px; }
.faq-q::-webkit-details-marker { display:none; }
.faq-icon { color:var(--primary, #c2410c); transition:transform 0.25s; flex-shrink:0; }
.faq-item[open] .faq-icon { transform:rotate(180deg); }
.faq-a { color:var(--gray, #4b5058); line-height:1.88; margin:0 0 18px; padding:14px 16px; background:var(--section-bg, #f5f4f0); border-radius:4px; border-inline-start:3px solid var(--primary, #c2410c); font-size:0.95rem; }
.city-sidebar { display:flex; flex-direction:column; gap:18px; position:sticky; top:108px; }
.sidebar-cta { background:#14171c; border-top:3px solid var(--primary, #c2410c); border-radius:4px; padding:26px; color:#fff; }
