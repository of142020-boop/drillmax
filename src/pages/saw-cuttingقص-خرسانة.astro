---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'قص خرسانة بالمنشار والليزر في مصر | بدون اهتزاز | 01070046464';
const description = 'مقاول قص خرسانة بالمنشار الماسي وقص جدران بالليزر في مصر لفتح الأبواب والشبابيك وقص الأسقف بدون شروخ أو تكسير وبأسعار واضحة. اتصل 01070046464.';
const canonical = '/saw-cuttingقص-خرسانة/';

const faq = [
  {
    q: 'ما المقصود بـ قص خرسانة بالليزر أو قص جدار بالليزر؟',
    a: 'مصطلح قص خرسانة بالليزر هو الاسم الشائع في السوق المصري لخدمة قص الخرسانة بالمنشار الماسي الجداري المثبّت على سكة توجيه دقيقة (Diamond Wall Saw) تُعاير بميزان ليزر؛ والنتيجة خط قطع مستقيم بالملليمتر بحواف ملساء جاهزة لتركيب الحلق مباشرة دون تكسير أو محارة إضافية.'
  },
  {
    q: 'كيف يتم قص الخرسانة المسلحة بدون شروخ أو إضرار بالمبنى؟',
    a: 'يتم التثبيت على سكة توجيه مع كشف مواضع التسليح ومراجعة المخطط الإنشائي أولاً، ثم تعمل أسطوانة الألماس الصناعي بدوران منتظم مع تبريد مائي مستمر (Wet Cutting) يقطع الخرسانة وحديد التسليح بسلاسة تامة دون أي طرق أو اهتزازات تؤثر على الجدران أو الأسقف المجاورة.'
  },
  {
    q: 'هل يمكن قص الجدران الحاملة أو عمل فتحات السقف للدوبلكس والأسانسير بأمان؟',
    a: 'نعم، بشرط الالتزام بالضوابط الهندسية: مراجعة المهندس الإنشائي أولاً، وتنفيذ التدعيم المؤقت (الشدات) قبل القطع، ثم تنفيذ التدعيم الدائم (مثل كمر حديدي أو تزريع أشاير وتدعيم سقف بالحديد) عند الحاجة. لا نقص أي جدار حامل أو سقف إنشائي بشكل عشوائي.'
  },
  {
    q: 'ما أقصى سمك للخرسانة يمكن قصه بمنشار قص الخرسانة؟',
    a: 'المنشار الماسي الجداري (Wall Saw) يقص سماكات حتى 70 سم من وجه واحد أو أكثر من وجهين. أما للكتل والقواعد والأعمدة الضخمة التي تتجاوز 70 سم، فنستخدم تقنية قص الخرسانة بالواير الماسي التي تنفذ القطع بأي عمق مطلوب بدون قيود.'
  },
  {
    q: 'كيف يتم حساب سعر متر قص الخرسانة بالمنشار في مصر؟',
    a: 'يُحسب السعر عادةً بالمتر الطولي لمسار القطع، ويتوقف على سماكة الحائط أو السقف (من 12 سم حتى 70 سم)، ونوع العنصر (طوب أم خرسانة مسلحة كثيفة التسليح)، وإجمالي الأمتار المطلوبة، وهل يشمل الطلب تقطيع ونقل الكتلة المقصوصة أم القص فقط. أرسل الصور والمقاسات على 01070046464 لعرض سعر واضح قبل البدء.'
  },
  {
    q: 'هل يسبب تقطيع الخرسانة بالمنشار غبارًا أو فوضى في الشقة المشطبة؟',
    a: 'تقنية القص الرطب بالمياه تمنع تطاير الغبار بنسبة تفوق 95%، ومع ذلك نضع أغطية حماية للأرضيات ونظام احتواء وتجميع لمياه التبريد في الشقق المشطبة للحفاظ على الدهانات والسيراميك وتسليم المكان نظيفًا.'
  },
  {
    q: 'ما الفرق بين منشار قص الجدران الماسي وقص الجدار بالصاروخ اليدوي؟',
    a: 'الصاروخ اليدوي عمقه محدود جدًا (لا يتجاوز بضعة سنتيمترات)، ويصدر غبارًا كثيفًا واهتزازات ويضطر العامل بعده لاستخدام الهيلتي للتكسير، ما يسبب شروخًا وحواف مشرشرة. أما منشار قص الخرسانة الجداري الماسي فيخترق كامل سماكة الجدار المسلح وحديده بخط واحد مستقيم وآمن.'
  },
  {
    q: 'هل تنفذون فواصل التمدد في الأرضيات الخرسانية وقص الأسفلت؟',
    a: 'نعم، نمتلك مناشير أرضيات ماسية متخصصة (Floor Saws) لتنفيذ فواصل التمدد والهبوط في أرضيات المصانع والهناجر والجراجات والمخازن، بالإضافة إلى قص الأسفلت لمد شبكات المرافق والكابلات بعمق وعرض مطابقين للمواصفات.'
  },
  {
    q: 'هل توفرون تأجير منشار قص خرسانة أم التنفيذ بالفني فقط؟',
    a: 'نوفر تنفيذ جميع أعمال القص والتقطيع بفريق فنيين ومهندسين متخصصين وبالمتر أو بالمقايسة، كما تتوفر خدمة تأجير مناشير قص الخرسانة بالفني للمشاريع الكبرى ويمكن مراجعة شروطها في صفحة تأجير منشار الخرسانة.'
  },
];

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://drilmax.com/' },
        { '@type': 'ListItem', position: 2, name: 'الخدمات', item: 'https://drilmax.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'قص خرسانة بالمنشار والليزر', item: `https://drilmax.com${canonical}` },
      ],
    },
    {
      '@type': 'Service',
      name: 'قص خرسانة بالمنشار الماسي وقص جدران بالليزر في مصر',
      alternateName: 'Concrete Cutting | تقطيع الخرسانة المسلحة بالمنشار',
      url: `https://drilmax.com${canonical}`,
      description,
      serviceType: 'قص وتقطيع الخرسانة المسلحة بالمنشار الماسي (Wall & Floor Sawing)',
      provider: {
        '@type': 'LocalBusiness',
        name: 'Drill Max | دريل ماكس',
        url: 'https://drilmax.com/',
        telephone: '+201070046464',
      },
      areaServed: [
        { '@type': 'Country', name: 'Egypt' },
        { '@type': 'City', name: 'القاهرة' },
        { '@type': 'City', name: 'الجيزة' },
        { '@type': 'City', name: 'الإسكندرية' },
        { '@type': 'City', name: 'المنصورة' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'خدمات قص الخرسانة بالمنشار الماسي',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'قص جدار بالليزر وفتح أبواب وشبابيك في الحوائط الخرسانية' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'قص سقف خرساني وعمل فتحات السقف للدوبلكس والسلالم والأسانسير' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'إزالة سقف خرساني وقص البلكونات والأسوار والواجهات' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'عمل فواصل التمدد في الأرضيات الخرسانية وقص الأسفلت' } },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
});
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/images/منشار-خرسانة.webp"
  preloadImage="/images/منشار-خرسانة.webp"
  schema={serviceSchema}
>
<article class="saw-page">
  <!-- ARCHITECTURAL SPLIT HERO -->
  <header class="saw-hero">
    <div class="container saw-intro">
      <div>
        <nav class="saw-crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span><a href="/services/">الخدمات</a><span>/</span><span>قص الخرسانة بالمنشار والليزر</span></nav>
        <p class="saw-eyebrow">دريل ماكس · شركة قص وتخريم الخرسانة المسلحة في مصر</p>
        <h1>قص خرسانة بالمنشار الماسي والليزر بدون اهتزاز</h1>
        <p class="saw-lead">بصفتنا واحدة من أبرز <strong>شركات قص الخرسانة</strong> ومقاولي <strong>Concrete Cutting</strong> في مصر، ننفذ أعمال <strong>قص الخرسانة المسلحة</strong> و<strong>قص جدار بالليزر</strong> (المنشار الماسي الجداري والأرضي) لـ <strong>فتح جدار</strong> وإنشاء الأبواب والشبابيك، وتنفيذ <strong>فتحات السقف</strong> للدوبلكس والأسانسير، وعمل <strong>فواصل التمدد في الأرضيات الخرسانية</strong> بدقة ملليمترية وبدون شروخ أو تكسير.</p>
        <ul class="saw-trust" aria-label="المواصفات الفنية لخدمة القص">
          <li><strong>حتى 70+ سم</strong><span>عمق قص مسلح</span></li>
          <li><strong>قص رطب</strong><span>95% أقل غبار</span></li>
          <li><strong>سكة ليزر</strong><span>استقامة ملليمترية</span></li>
          <li><strong>جميع المحافظات</strong><span>معاينة وتسعير واضح</span></li>
        </ul>
        <div class="saw-actions">
          <a class="btn btn-primary" href="https://wa.me/201070046464">أرسل الصور والمقاسات واتساب</a>
          <a class="btn btn-secondary" href="tel:+201070046464" dir="ltr">01070046464</a>
        </div>
      </div>
      <figure class="saw-hero-media">
        <img src="/images/منشار-خرسانة.webp" alt="مقاول قص خرسانة ينفذ تقطيع جدار خرساني مسلح بمنشار قص الخرسانة الماسي" width="1200" height="666" loading="eager" fetchpriority="high" />
        <figcaption>قص جدران وأسقف خرسانية مسلحة بمنشار ماسي موجه بدون اهتزاز</figcaption>
      </figure>
    </div>
  </header>

  <div class="container saw-body">
    <nav class="saw-toc" aria-label="محتويات خدمة قص الخرسانة">
      <a href="#services">تطبيقات القص</a>
      <a href="#depths">جدول السماكات والمعدات</a>
      <a href="#gallery">صور وفيديو من الموقع</a>
      <a href="#vs-methods">المنشار مقابل الصاروخ</a>
      <a href="#safety">الجدران الحاملة والأسقف</a>
      <a href="#prices">سعر متر قص الخرسانة</a>
      <a href="#steps">خطوات التنفيذ</a>
      <a href="#areas">التغطية الجغرافية</a>
      <a href="#faq">الأسئلة الشائعة</a>
    </nav>

    <!-- SECTION 1: 01-06 APPLICATIONS -->
    <section id="services">
      <h2>تطبيقات قص وتقطيع الخرسانة المسلحة في المشاريع السكنية والتجارية</h2>
      <p>سواء كنت تحتاج إلى <strong>مقاول قص خرسانة</strong> لتعديل فيلا أو شقة دوبلكس، أو تبحث عن <strong>شركة قص وتخريم الخرسانة</strong> لمشروع تجاري أو مصنع، تغطي فرق <strong>دريل ماكس</strong> جميع مهام <strong>قطع الخرسانة المسلحة</strong> بأحدث <strong>معدات قص الخرسانة</strong> الألمانية (Hilti وCayken):</p>
      <div class="saw-grid saw-grid-3">
        <div>
          <span class="saw-num">01</span>
          <h3>فتح جدار وعمل فتحة باب أو شباك</h3>
          <p><strong>عمل فتحة في الجدار</strong> الخرساني أو الطوب لفتح باب جديد أو توسيع شباك أو دمج غرفتين بحواف ناعمة جاهزة لتركيب الحلق مباشرة دون محارة. راجع <a href="/قص-جدران-بالليزر-وفتح-ابواب/">دليل قص جدران بالليزر وفتح الأبواب</a>.</p>
        </div>
        <div>
          <span class="saw-num">02</span>
          <h3>فتحات السقف وقص سقف خرساني للدوبلكس</h3>
          <p>تنفيذ <strong>قص سقف خرساني</strong> لربط طابقين وإنشاء سلم داخلي أو فتح منور تهوية بأبعاد مطابقة للرسم المعماري، مع تأمين الكتلة المقصوصة وإنزالها بأمان كامل.</p>
        </div>
        <div>
          <span class="saw-num">03</span>
          <h3>قص مكان أسانسير وفتحات المصاعد</h3>
          <p>إنشاء فتحات المصاعد في البلاطات والأسقف الخرسانية متعددة الطوابق باستقامة رأسية موحدة، مع إمكانية دمج التدعيم و<a href="/تزريع-الاشاير/">تزريع حديد السقف والأشاير</a> عند الحاجة.</p>
        </div>
        <div>
          <span class="saw-num">04</span>
          <h3>إزالة سقف خرساني وقص البلكونات والواجهات</h3>
          <p>تنفيذ <strong>إزالة سقف خرساني</strong> جزئيًا أو كليًا، وقص البلكونات والأسوار والكمرات والواجهات الخرسانية لتعديل التصميم الخارجي دون تشويه المبنى القائم.</p>
        </div>
        <div>
          <span class="saw-num">05</span>
          <h3>فواصل التمدد في الأرضيات الخرسانية والأسفلت</h3>
          <p>استخدام المنشار الأرضي (Floor Saw) لتنفيذ <strong>فواصل التمدد في الأرضيات الخرسانية</strong> و<strong>فواصل الخرسانة</strong> في المصانع والمخازن والجراجات، وقص الأسفلت لمد المرافق.</p>
        </div>
        <div>
          <span class="saw-num">06</span>
          <h3>قص وتخريم الخرسانة المسلحة المتكامل</h3>
          <p>دمج أعمال القص بالمنشار مع <a href="/core-drilling-صنايعي-كور/">تخريم الخرسانة بالكور دريل</a> لفتحات الدكت والتكييف المركزي والسباكة، أو <a href="/قص-الخرسانة-بالواير/">قص الخرسانة بالواير الماسي</a> للسماكات العملاقة.</p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: DEPTHS & EQUIPMENT TABLE -->
    <section id="depths">
      <h2>جدول سماكات قص الخرسانة واختيار المنشار المناسب</h2>
      <p>اختيار <strong>منشار قص الخرسانة</strong> المناسب يعتمد على سماكة العنصر الخرساني وموقعه (رأسي أم أفقي). يوضح الجدول التالي قدرات <strong>معدات قص الخرسانة</strong> المستخدمة لدى دريل ماكس:</p>
      <div class="saw-table">
        <table>
          <thead>
            <tr>
              <th scope="col">سماكة العنصر</th>
              <th scope="col">المعدة المعتمدة</th>
              <th scope="col">آلية القطع</th>
              <th scope="col">الاستخدامات المثالية</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">10 – 25 سم</th>
              <td>منشار قص الجدران (Wall Saw) أو منشار يدوي ماسي رطب</td>
              <td>قص رطب بأسطوانة ماسية على مسار موجه</td>
              <td>فتح أبواب وشبابيك، قص حوائط داخلية، قص بلكونات وبلاطات سوليد سلاب.</td>
            </tr>
            <tr>
              <th scope="row">25 – 45 سم</th>
              <td>منشار تقطيع الخرسانة الجداري الهيدروليكي / الكهربائي (Track Saw)</td>
              <td>سكة توجيه ثابتة معايرة بالليزر مع تبريد مائي</td>
              <td>قص الأسقف الفلات سلاب والهوردي، فتحات السقف للدوبلكس، قص مكان أسانسير.</td>
            </tr>
            <tr>
              <th scope="row">45 – 70 سم</th>
              <td>منشار جداري عالي القدرة (قص من وجه واحد أو وجهين)</td>
              <td>أسطوانات ماسية كبيرة متدرجة العمق</td>
              <td>الجدران الساندة (Retaining Walls)، الحوائط المسلحة السميكة، والكمرات.</td>
            </tr>
            <tr>
              <th scope="row">أرضيات 5 – 35 سم</th>
              <td>منشار قص أرضيات خرسانة وأسفلت (Floor Saw)</td>
              <td>دفع ذاتي بخطوط مستقيمة ومضخة مياه مدمجة</td>
              <td>فواصل التمدد في الأرضيات الخرسانية، قنوات الصرف بالمصانع، وقص الأسفلت.</td>
            </tr>
            <tr>
              <th scope="row">أكثر من 70 سم</th>
              <td><a href="/قص-الخرسانة-بالواير/">الواير الماسي (Diamond Wire Saw)</a></td>
              <td>سلك ماسي يدور حول الكتلة بعمق غير محدود</td>
              <td>القواعد الضخمة، الأعمدة الكبيرة، الكباري، والكتل الصناعية الثقيلة.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECTION 3: GALLERY + VIDEO -->
    <section id="gallery">
      <h2>صور وفيديو حقيقي من أعمال قص الخرسانة بالمنشار الماسي</h2>
      <p>نماذج ميدانية من تنفيذ فرق <strong>تقطيع خرسانة بالمنشار</strong> في دريل ماكس لفتحات المصاعد والجدران وفواصل التمدد:</p>
      <div class="saw-gallery">
        <figure>
          <img src="/images/saw-cutting-1.webp" alt="تقطيع جدار خرساني مسلح بمنشار قص الجدران الماسي" width="900" height="968" loading="lazy" />
          <figcaption>تقطيع جدار خرساني مسلح باستقامة تامة على مسار توجيه</figcaption>
        </figure>
        <figure>
          <img src="/images/elevator-hole.webp" alt="قص فتحة مصعد وأسانسير في سقف خرساني مسلح" width="1200" height="895" loading="lazy" />
          <figcaption>قص فتحة أسانسير في سقف خرساني بأبعاد هندسية مطابقة للرسم</figcaption>
        </figure>
        <figure>
          <img src="/images/عمل-فواصل-تمدد-للأرضيات-قص-رطب.webp" alt="عمل فواصل التمدد في الأرضيات الخرسانية بالقص الرطب" width="1200" height="895" loading="lazy" />
          <figcaption>عمل فواصل التمدد في الأرضيات الخرسانية بالمنشار الأرضي الرطب</figcaption>
        </figure>
        <figure>
          <img src="/images/saw.webp" alt="منشار قص الخرسانة الماسي في موقع عمل بمصر" width="800" height="533" loading="lazy" />
          <figcaption>تجهيز وتشغيل منشار قص الخرسانة الماسي بدون غبار أو شروخ</figcaption>
        </figure>
      </div>
      <div class="saw-video-frame">
        <iframe loading="lazy" width="100%" height="440" src="https://www.youtube.com/embed/kydiflKy_ag" title="فيديو عملي لقص الخرسانة بالمنشار الماسي والليزر من أعمال دريل ماكس" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        <p class="saw-video-cap">لقطة ميدانية من تنفيذ قص الخرسانة بالمنشار الماسي الموجه بالليزر</p>
      </div>
    </section>

    <!-- SECTION 4: COMPARISON -->
    <section id="vs-methods">
      <h2>المنشار الماسي الموجه بالليزر مقابل الصاروخ اليدوي والتكسير بالهيلتي</h2>
      <p>يلجأ البعض لتوفير مبدئي عبر <strong>قص الجدار بالصاروخ</strong> اليدوي ثم استكمال الفتحة بالتكسير بالهيلتي، لكن التجربة الهندسية تثبت أن التكلفة الكلية والضرر الإنشائي يكونان أعلى بكثير. قارن بين الطريقتين بوضوح:</p>
      <div class="saw-table">
        <table>
          <thead>
            <tr>
              <th scope="col">وجه المقارنة</th>
              <th scope="col">قص الخرسانة بالمنشار الماسي (Wall Saw)</th>
              <th scope="col">الصاروخ اليدوي + التكسير بالهيلتي</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">السلامة الإنشائية</th>
              <td>قطع ناعم بدون اهتزازات؛ لا يسبب شروخًا شعرية في الكمرات أو الحوائط المجاورة.</td>
              <td>طرق واهتزازات عنيفة تفكك تماسك الخرسانة بالحديد وتسبب شروخًا لاحقة.</td>
            </tr>
            <tr>
              <th scope="row">عمق القطع</th>
              <td>يخترق الجدران والأسقف المسلحة بعمق يصل حتى 70 سم بسلاسة.</td>
              <td>عمق سطحي (4–7 سم فقط) ويضطر العامل للتكسير العشوائي لإكمال السماكة.</td>
            </tr>
            <tr>
              <th scope="row">استقامة الحواف والترميم</th>
              <td>حواف مستقيمة بالملليمتر جاهزة لتركيب حلق الباب أو الشباك دون محارة إضافية.</td>
              <td>حواف متعرجة ومكسرة تتطلب أعمال مرمات ومحارة ودهانات مكلفة.</td>
            </tr>
            <tr>
              <th scope="row">الغبار والضوضاء</th>
              <td>نظام القص الرطب يمنع 95% من الغبار ومناسب للمباني المأهولة والكمبوندات.</td>
              <td>سحب غبار كثيفة وضوضاء شديدة وركام ثقيل يرهق السكان والتشطيبات.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="saw-callout">
        <h3>توضيح مهني: ما حقيقة مصطلح «قص خرسانة بالليزر»؟</h3>
        <p>لا يوجد شعاع ليزر يذيب الخرسانة المسلحة في المواقع السكنية؛ وإنما يطلق العملاء والمهندسون اسم <strong>قص خرسانة بالليزر</strong> أو <strong>قص جدران بالليزر</strong> على <strong>منشار قص الجدران الماسي</strong> المثبّت على سكة توجيه يتم ضبط استقامتها بميزان ليزر، لأنه يخرج خط قطع مستقيمًا ونظيفًا كشعاع الليزر تمامًا.</p>
      </div>
    </section>

    <!-- SECTION 5: STRUCTURAL SAFETY -->
    <section id="safety">
      <h2>كيف يتم قص الخرسانة المسلحة والجدران الحاملة والأسقف بأمان؟</h2>
      <p>الأمان الإنشائي هو الخط الأحمر في كل موقع نعمل به. عند التعامل مع <strong>قص سقف خرساني</strong> أو جدار حامل أو كمرة، نلتزم بالضوابط التالية:</p>
      <div class="saw-grid">
        <div>
          <h3>1. الجدران الحاملة والكمرات</h3>
          <ul>
            <li>لا يُقص أي جدار حامل أو عمود أو كمرة إلا بعد مراجعة المخطط الإنشائي واعتماد المهندس المسؤول.</li>
            <li>تنفيذ <strong>التدعيم المؤقت (الشدات المعدنية)</strong> قبل بدء القطع لنقل الأحمال بأمان.</li>
            <li>في حالة الحاجة لتقوية الحواف بعد فتح الباب أو السقف، نوفر تنفيذ <a href="/تزريع-الاشاير/">تزريع الأشاير وتدعيم الأسقف بالحديد</a> وتركيب الكمرات المعدنية وفق التصميم.</li>
          </ul>
        </div>
        <div>
          <h3>2. قص الأسقف وإنزال الكتل الخرسانية</h3>
          <ul>
            <li>تقسيم مساحة الفتحة (مثل الدوبلكس أو الأسانسير) إلى بلوكات محددة الوزن يسهل حملها وإنزالها بأمان دون سقوط مفاجئ على الدور السفلي.</li>
            <li>استخدام جهاز كشف التسليح ومراجعة مسارات الكهرباء والسباكة المدفونة قبل تثبيت سكة المنشار.</li>
            <li>احتواء مياه التبريد وتنظيف الموقع، مع إمكانية <a href="/مقاول-هدم/">تشوين ونقل المخلفات الخرسانية</a> بالكامل عند الطلب.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION 6: PRICING -->
    <section id="prices">
