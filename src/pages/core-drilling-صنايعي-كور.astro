---
import MainLayout from '../layouts/MainLayout.astro';
const title = 'صنايعي كور لعمل فتحات الخرسانة وتخريم الجدران - 01070046464';
const description = 'خدمة صنايعي كور لفتحات التكييف والسباكة والتهوية في الخرسانة. جهز العدد والقطر والسماكة وصور الموقع لتقييم التخريم والتكلفة مع دريل ماكس: 01070046464.';
const canonical = '/core-drilling-صنايعي-كور/';
const faq = [
  {q:'ما المعلومات المطلوبة لطلب صنايعي كور؟',a:'حدد استخدام الفتحة وعددها وقطر المرور المعتمد وسماكة العنصر إن كانت معروفة، وأرسل صور مكان الدخول والخروج والعنوان والطابق. إذا كان المقاس أو نوع الجدار غير مؤكد، اذكر ذلك لتحديد ما يحتاج إلى مراجعة أو معاينة.'},
  {q:'هل فتحة الكور تشمل تركيب الماسورة أو الشفاط؟',a:'التخريم بند يختلف عن تركيب المواسير أو العزل أو الدكت أو الجهاز. وضح الأعمال التي تحتاجها عند الطلب، ويحدد العرض البنود المشمولة وما يحتاج إلى تنسيق مع فني التمديدات أو التركيب.'},
  {q:'هل يمكن توسيع فتحة قائمة بدل إنشاء فتحة جديدة؟',a:'قد يكون ذلك ممكنًا بحسب حالة الحواف والعنصر ومساحة تثبيت المعدة وموضع الخدمات. أرسل القطر الحالي والمقاس المطلوب وصور جانبي الفتحة؛ لا تُؤكد إمكانية التوسيع من المقاس وحده.'},
  {q:'هل تعمل ماكينة الكور دون صوت أو مياه؟',a:'تشغيل المعدة يصدر صوتًا، ويستخدم الماء في كثير من أعمال التبريد، مع ناتج حفر يحتاج إلى احتواء وتجميع. تحدد ترتيبات الحماية ومواعيد العمل وحدود التنظيف بحسب الموقع قبل التنفيذ.'},
  {q:'هل يمكن التخريم في كمرة أو عمود؟',a:'تعديل العناصر الإنشائية يحتاج إلى موافقة المهندس المسؤول ومراجعة المخططات والخدمات. لا يُختار الموضع أو يُقطع التسليح لمجرد سهولة وصول المعدة، وقد يتطلب الطلب تغيير الموضع أو طريقة العمل.'},
];
const serviceSchema=JSON.stringify([
  {'@context':'https://schema.org','@type':'Service',name:'خدمة صنايعي كور وفتحات الخرسانة',url:`https://drilmax.com${canonical}`,description,serviceType:'تخريم الخرسانة بالكور',provider:{'@type':'Organization',name:'دريل ماكس',url:'https://drilmax.com/',telephone:'+201070046464'},areaServed:{'@type':'Country',name:'Egypt'}},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},
]);
---
<MainLayout title={title} description={description} canonical={canonical} ogImage="/images/gas-hole.webp" schema={serviceSchema}>
<article class="core-service">
  <header class="core-hero"><div class="container core-intro">
    <div><p class="eyebrow">دريل ماكس · تخريم دائري لخدمات المباني</p><h1>{title}</h1>
    <p>لطلب فتحة كور، نبدأ بمكان مرور الخدمة والمقاس المطلوب وحالة الجدار أو السقف. نراجع إمكانية تثبيت الماكينة والوصول إلى الجانبين، ثم نحدد نطاق التخريم وتجهيزات الموقع والتكلفة قبل الحجز.</p>
    <div class="core-actions"><a class="btn btn-primary" href="https://wa.me/201070046464">أرسل صور ومقاسات الفتحات</a><a class="btn btn-secondary" href="tel:+201070046464">اتصل 01070046464</a></div></div>
    <img src="/images/gas-hole.webp" alt="تجهيز فتحة لمرور خدمات المبنى بالكور" width="800" height="800" loading="eager" fetchpriority="high" />
  </div></header>
  <div class="container core-body">
    <nav class="core-toc" aria-label="محتويات خدمة الكور"><a href="#openings">استخدامات الفتحات</a><a href="#quote">المقاسات والتكلفة</a><a href="#site-check">تجهيز الموقع</a><a href="#steps">مراحل الطلب</a><a href="#areas">تأكيد التغطية</a><a href="#faq">أسئلة قبل الحجز</a></nav>
    <section id="openings"><h2>فتحات كور خرسانة للتكييف والسباكة والتهوية</h2><p>الكور يناسب الفتحة الدائرية التي تمر منها ماسورة أو كابل أو وصلة تهوية. يحدد مسؤول التمديدات أو المختص بالجهاز قطر المرور المطلوب؛ لا يكفي اسم الاستخدام أو المقاس الاسمي للماسورة لاختيار قطر التخريم.</p>
      <div class="core-grid"><div><h3>السباكة والصرف</h3><p>حدد قطر المرور وأي جراب أو عزل، وموضع الدخول والخروج والطابق السفلي عند التخريم في بلاطة.</p></div><div><h3>التكييف والكابلات</h3><p>نسّق المقاس والمسار مع فني التمديدات، وأرسل عدد المواسير أو الكابلات ومخطط مواقع الفتحات إن توفر.</p></div><div><h3>التهوية والشفاطات</h3><p>راجع مخرج الجهاز ومقاس الدكت وطريقة الطرد. تجهيز الفتحة يختلف عن نطاق <a href="/فني-شفاطات/">تركيب الشفاط والدكت</a>.</p></div><div><h3>الغاز ومدخنة الجهاز</h3><p>يحدد المختص بالجهاز أو جهة توصيل الغاز الموضع والمقاس والمسار المعتمد. التخريم لا يشمل تلقائيًا توصيل الغاز أو اعتماد التهوية.</p></div></div>
      <p>إذا كان المطلوب بابًا أو شباكًا مستطيلًا أو خط قطع في جدار، راجع <a href="/saw-cuttingقص-خرسانة/">قص الخرسانة بالمنشار</a>؛ تحديد الخدمة المناسبة يسبق اختيار المعدة.</p>
    </section>
    <section id="quote"><h2>أسعار فتحات الكور: ما الذي يغيّر عرض التنفيذ؟</h2><p>قد تختلف تكلفة فتحتين لهما القطر نفسه بسبب السماكة والتسليح وارتفاع نقطة العمل ومساحة الوصول وحالة التشطيب. كما يؤثر توزيع الفتحات بين طوابق ومواقع مختلفة في وقت التجهيز والانتقال.</p>
      <div class="core-table"><table><thead><tr><th scope="col">البند</th><th scope="col">ما تجهزه لطلب السعر</th></tr></thead><tbody><tr><th scope="row">الكميات والمقاسات</th><td>عدد كل مجموعة وقطرها المطلوب وسماكة العنصر إن عُرفت.</td></tr><tr><th scope="row">المكان والوصول</th><td>المنطقة والطابق وصور الجانبين ونقطة التحميل ومواعيد دخول المعدات.</td></tr><tr><th scope="row">التشطيب والخدمات</th><td>نوع الكسوة والأثاث أو الأجهزة القريبة ومواقع التمديدات المعروفة.</td></tr><tr><th scope="row">حدود التسليم</th><td>التخريم والحماية والتنظيف، وأي تركيب أو عزل أو نقل مخلفات مطلوب بصورة منفصلة.</td></tr></tbody></table></div>
      <p>إذا لم تعرف أحد البنود، اذكر أنه غير مؤكد ليُراجع بدل إدراج مقاس تقديري كحقيقة. اقرأ <a href="/prices/">عوامل أسعار القص والتخريم</a> لمقارنة عروض لها نطاق عمل متساوٍ.</p>
    </section>
    <section id="site-check"><h2>قبل التخريم في جدار قائم أو شقة مشطبة</h2><p>تُراجع مادة العنصر ومكان التسليح والخدمات القريبة وما يقع خلف نقطة الخروج. وفي العناصر الحاملة، يلزم اعتماد المهندس المسؤول قبل اختيار موضع الفتحة أو بدء العمل.</p>
      <ul><li>توفير مساحة مناسبة لتثبيت المعدة وحركة الفني وإمكانية الوصول إلى الجهة المقابلة.</li><li>مراجعة مصدر المياه والكهرباء ووسيلة تجميع مياه التبريد وناتج التخريم.</li><li>الاتفاق على حماية الرخام والسيراميك والأثاث والمساحات المشتركة المحيطة.</li><li>توضيح من يتولى تركيب الماسورة أو العزل أو معالجة التشطيب حول الفتحة بعد التنفيذ.</li></ul>
      <p>تُحدد هذه الترتيبات قبل الحجز. نوع الماكينة وحده لا يضمن غياب أثر على التشطيبات أو يلغي الحاجة إلى المراجعة الهندسية.</p>
    </section>
    <section id="steps"><h2>من إرسال الصور إلى تأكيد نطاق العمل</h2><ol><li><strong>وصف الطلب:</strong> صور واسعة وموضع كل فتحة ومقاساتها وعددها وعنوان المشروع.</li><li><strong>مراجعة البيانات:</strong> تحديد ما ينقص من مقاسات أو مخططات أو معاينة للوصول والتثبيت.</li><li><strong>توضيح العرض:</strong> تحديد أعمال التخريم والتجهيز والتنظيف والبنود المستثناة والموعد المتاح.</li><li><strong>التنفيذ والمراجعة:</strong> الالتزام بالمواضع والمقاسات المعتمدة ومراجعة حدود التسليم المتفق عليها.</li></ol><a href="/projects/">اطلع على الأعمال المعروضة في موقع دريل ماكس</a></section>
    <section id="areas"><h2>طلب صنايعي كور حسب عنوان الموقع</h2><p>حدد المنطقة والطابق ومدخل التحميل وأي تصريح مطلوب. تُراجع إمكانية الوصول والموعد وتكلفة الانتقال بعد معرفة الكميات وتجهيزات الموقع، خاصة خارج نطاق المدن القريبة.</p><div class="core-actions"><a href="/october-zayed-concrete-cutting-core/">أكتوبر والشيخ زايد</a><a href="/alexandria-concrete-cutting-core/">الإسكندرية</a><a href="/service-areas/">باقي مناطق الخدمة</a></div></section>
    <section id="faq"><h2>أسئلة قبل طلب فني تخريم كور</h2>{faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    <section class="core-request"><h2>جهّز بيانات الفتحات وناقش التنفيذ</h2><p>أرسل المقاس والعدد والصور والعنوان، ووضّح إن كان المطلوب تخريمًا فقط أم أعمال تركيب وتجهيز إضافية.</p><div class="core-actions"><a class="btn btn-primary" href="https://wa.me/201070046464">أرسل تفاصيل العمل عبر واتساب</a><a href="tel:+201070046464">اتصل 01070046464</a></div></section>
  </div>
</article>
</MainLayout>
<style>
.core-service{line-height:2;color:#334155}.core-hero{background:#f4f6f8;padding:48px 0}.core-intro{display:grid;gap:30px;align-items:center;grid-template-columns:1.2fr 1fr}.core-intro h1{font-size:clamp(28px,3vw,42px);line-height:1.5;color:#17212f}.eyebrow{color:#a33a13;font-weight:700}.core-intro img{width:100%;height:auto;border-radius:18px}.core-actions .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 20px;border-radius:10px;background:#c2410c;color:#fff;font-weight:700;text-decoration:none}.core-actions .btn-secondary{background:#fff;color:#9a3412;border:1px solid #c2410c}.core-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:20px}.core-body{max-width:1000px}.core-toc{display:flex;flex-wrap:wrap;gap:12px;padding:24px 0}.core-toc a{padding:8px 14px;background:#f1f5f9;border-radius:9px}.core-body section{padding:28px 0;scroll-margin-top:110px}.core-body h2{font-size:27px;color:#17212f;margin-bottom:18px}.core-body h3{font-size:21px;color:#17212f}.core-body p{margin-bottom:16px}.core-body a{color:#a33a13;text-decoration:underline;text-underline-offset:4px}.core-body .btn{color:white;text-decoration:none}.core-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:25px 0}.core-grid>div{padding:22px;border:1px solid #dfe5eb;border-radius:14px}.core-body ul,.core-body ol{padding-inline-start:24px;list-style:disc}.core-body ol{list-style:decimal}.core-table{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{border:1px solid #dfe5eb;padding:14px;text-align:right;vertical-align:top}th{background:#f4f6f8}.core-body details{border:1px solid #dfe5eb;border-radius:12px;padding:16px;margin:14px 0}.core-body summary{cursor:pointer;font-weight:700}.core-request{border-top:3px solid #d84315}@media(max-width:760px){.core-intro,.core-grid{grid-template-columns:1fr}.core-hero{padding:28px 0}.core-body h2{font-size:24px}}
</style>
