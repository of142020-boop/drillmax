---
import MainLayout from '../layouts/MainLayout.astro';
const title = 'صنايعي كور ومقاول فتحات كور دريل في مصر | 01070046464';
const description = 'اطلب صنايعي كور ومقاول فتحات كور دريل لتخريم الخرسانة للتكييف والغاز والسباكة والشفاطات بدون تكسير أو غبار في جميع المحافظات. اتصل 01070046464.';
const canonical = '/core-drilling-صنايعي-كور/';
const faq = [
  {
    q: 'ما المعلومات المطلوبة لطلب صنايعي كور وتحديد سعر فتحة الكور بدقة؟',
    a: 'أرسل عبر واتساب على 01070046464 نوع الاستخدام (تكييف، غاز، صرف، شفاط، كابلات)، وعدد الفتحات وقطرها بالبوصة وسماكة الحائط أو السقف إن عُرفت، مع صور واضحة لمكان الدخول والخروج والمنطقة والطابق. نراجع البيانات فورًا ونؤكد لك السعر وموعد التنفيذ قبل الحجز.'
  },
  {
    q: 'هل عمل فتحات الكور يؤثر على سلامة الخرسانة أو يسبب شروخًا في الشقة المشطبة؟',
    a: 'لا، لأن جهاز الكور للحفر (الكور الماسي) يعمل بدوران هادئ بدون طرق أو اهتزازات مثل الهيلتي أو الكمبروسر، ما يمنع تمامًا حدوث شروخ في الخرسانة أو المحارة أو الدهانات. كما نستخدم أغطية حماية ونظام تجميع وشفط لمياه التبريد للحفاظ على السيراميك والباركيه في الشقق المشطبة.'
  },
  {
    q: 'هل يمكن فتح كور في الكمر أو السقف الفلات سلاب والهوردي بأمان؟',
    a: 'تخريم السقف العادي والفلات سلاب والهوردي يتم بأمان تام بعد تحديد المسار الصحيح وتجنب مناطق الضغط والحديد الرئيسي. أما فتح كور في الكمر أو الأعمدة الحاملة فيستلزم مراجعة واعتماد المهندس الإنشائي لتحديد الموضع والقطر المسموح بهما دون المساس بتسليح العنصر الإنشائي.'
  },
  {
    q: 'ما الفرق بين التخريم الجاف والتخريم بالمياه (الرطب) بالكور؟',
    a: 'التخريم بالمياه هو الأكثر كفاءة في الخرسانة المسلحة الكثيفة لأنه يبرّد ريشة الكور الماسية ويمنع تطاير الغبار ويطيل عمر القطع، ونستخدم معه حلقات تجميع ومكنسة شفط مياه في الأماكن المشطبة. أما التخريم الجاف فيُستخدم في الطوب والبلوك وبعض الجدران الخاصة أو الأماكن الحساسة للرطوبة مع شفاط غبار صناعي.'
  },
  {
    q: 'هل يمكن عمل فتحة كور تكييف أو شفاط أو غاز في نفس اليوم؟',
    a: 'نعم، تتوفر فرق صنايعي كور دريل في القاهرة الكبرى والتجمع الخامس وأكتوبر والشيخ زايد ومدينة نصر والإسكندرية للتنفيذ في نفس اليوم أو خلال 24 ساعة حسب ضغط المواعيد ومواعيد العمل المسموحة في الكمبوند أو العمارة.'
  },
  {
    q: 'هل تنفذ دريل ماكس فتحات كور للمشاريع الكبرى واختبار الكور للخرسانة (Core Test)؟',
    a: 'نعم، نعمل كشركة فتح كور ومقاول فتحات كور لمشاريع الكهروميكانيكال (MEP) ومواسير الحريق وصواني الكابلات بخصومات على الكميات، كما نوفر خدمة أخذ عينات كور أسطوانية من الخرسانة المسلحة بدقة عالية لصالح معامل اختبار الكور تست للخرسانة والمهندسين الاستشاريين.'
  },
  {
    q: 'هل يمكن توسيع فتحة قائمة أو عمل تخريم مائل في جدار خرساني؟',
    a: 'نعم، يمكن توسيع فتحة قائمة بقطر أكبر باستخدام تثبيت محكم للماكينة بعد مراجعة حالة الحواف وموضع الخدمات القريبة، كما ننفذ التخريم المائل (لصرف التكييف والسباكة) والتخريم الأفقي والرأسي في الأسقف والجدران بسماكات تصل لأكثر من متر.'
  },
  {
    q: 'هل خدمة فتح الكور تشمل تركيب الشفاط أو الماسورة؟',
    a: 'تخريم الخرسانة بالكور بند مستقل عن تركيب المواسير أو العزل أو الأجهزة، لكن إذا كنت تحتاج تركيب شفاط المطبخ أو الحمام وتمديد المدخنة مع الفتحة في زيارة واحدة، نوفر فريق فني الشفاطات المتخصص بالتنسيق المسبق ضمن نفس الطلب.'
  },
  {
    q: 'ما أكبر وأصغر قطر متاح لعمل فتحات في الخرسانة بالكور؟',
    a: 'ننفذ فتحات كور خرسانة بداية من 1 بوصة (2.5 سم) لكابلات الكهرباء ومواسير التغذية، وحتى 14 و24 بوصة فأكثر لخطوط الصرف الرئيسية ودكت التكييف المركزي والشفاطات الصناعية. وللفتحات المستطيلة كالأبواب والشبابيك نستخدم منشار قص الخرسانة بالليزر والواير.'
  },
];
const serviceSchema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://drilmax.com/' },
      { '@type': 'ListItem', position: 2, name: 'الخدمات', item: 'https://drilmax.com/services/' },
      { '@type': 'ListItem', position: 3, name: 'صنايعي كور ومقاول فتحات كور', item: `https://drilmax.com${canonical}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'صنايعي كور ومقاول فتحات كور وتخريم الخرسانة المسلحة في مصر',
    url: `https://drilmax.com${canonical}`,
    description,
    serviceType: 'تخريم الخرسانة المسلحة بالكور (Diamond Core Drilling)',
    provider: {
      '@type': 'Organization',
      '@id': 'https://drilmax.com/#organization',
      name: 'دريل ماكس',
      url: 'https://drilmax.com/',
      telephone: '+201070046464',
    },
    areaServed: [
      { '@type': 'Country', name: 'Egypt' },
      { '@type': 'City', name: 'القاهرة' },
      { '@type': 'City', name: 'الجيزة' },
      { '@type': 'City', name: 'الإسكندرية' },
      { '@type': 'City', name: 'المنصورة' },
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'خدمات فتحات الكور وتخريم الخرسانة',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'عمل فتحات كور للتكييف والسباكة والصرف الصحي' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'تخريم فتحات الغاز وهواية ومدخنة سخان الغاز وشفاط المطبخ' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'فتح كور في الكمر وتخريم الأسقف والجدران المسلحة' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'أخذ عينات اختبار الكور للخرسانة (Core Test) ومشاريع MEP' } },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: `https://drilmax.com${canonical}`,
    name: title,
    inLanguage: 'ar-EG',
    dateModified: '2026-11-23',
    isPartOf: { '@id': 'https://drilmax.com/#website' },
    about: { '@id': 'https://drilmax.com/#organization' },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.core-intro h1', '.core-lead', '#faq summary', '#faq p'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]);
---
<MainLayout title={title} description={description} canonical={canonical} ogImage="/images/core-drill-hero.webp" schema={serviceSchema}>
<article class="core-service">
  <header class="core-hero">
    <div class="container core-intro">
      <div>
        <nav class="core-crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span><a href="/services/">الخدمات</a><span>/</span><span>صنايعي كور وفتحات الخرسانة</span></nav>
        <p class="eyebrow">دريل ماكس · شركة فتح كور ومقاول تخريم خرسانة في مصر</p>
        <h1>صنايعي كور ومقاول فتحات كور في الخرسانة المسلحة</h1>
        <p class="core-lead">سواء كنت تبحث عن <strong>صنايعي كور دريل</strong> لعمل فتحة تكييف أو سباكة أو غاز أو شفاط داخل شقة مشطبة بدون تكسير، أو تبحث عن <strong>شركة فتح كور</strong> و<strong>مقاول فتح كور</strong> لتنفيذ مئات الفتحات في مشروع إنشائي أو كهروميكانيكال (MEP) — تنفذ فرق <strong>دريل ماكس</strong> جميع أعمال <strong>تخريم الخرسانة المسلحة بالكور</strong> بأحدث ماكينات الكور الماسية بأقطار من 1 إلى 24 بوصة في القاهرة وجميع محافظات مصر.</p>
        <ul class="core-trust" aria-label="مميزات خدمة الكور">
          <li><strong>1 – 24 بوصة</strong><span>أقطار دقيقة بلا شروخ</span></li>
          <li><strong>شفط مياه</strong><span>حماية للشقق المشطبة</span></li>
          <li><strong>تنفيذ سريع</strong><span>نفس اليوم أو 24 ساعة</span></li>
          <li><strong>شقق ومشاريع</strong><span>فني كور ومقاول MEP</span></li>
        </ul>
        <div class="core-actions">
          <a class="btn btn-primary" href="https://wa.me/201070046464">أرسل الصور والمقاسات واتساب</a>
          <a class="btn btn-secondary" href="tel:+201070046464">اتصل الآن 01070046464</a>
        </div>
      </div>
      <figure class="core-hero-media">
        <img src="/images/core-drill-hero.webp" alt="صنايعي كور ينفذ فتحة كور دائرية دقيقة في جدار خرساني مسلح باستخدام جهاز الكور الماسي" width="1200" height="630" loading="eager" fetchpriority="high" />
        <figcaption>تنفيذ فتحات كور خرسانة بدقة ملليمترية بدون اهتزاز أو تكسير</figcaption>
      </figure>
    </div>
  </header>

  <div class="container core-body">
    <nav class="core-toc" aria-label="محتويات خدمة الكور">
      <a href="#openings">استخدامات فتحات الكور</a>
      <a href="#sizes">جدول المقاسات</a>
      <a href="#gallery">صور من أعمالنا</a>
      <a href="#vs-hilti">الكور مقابل الهيلتي</a>
      <a href="#structural">تخريم الكمر والأسقف</a>
      <a href="#prices">سعر فتحة الكور</a>
      <a href="#steps">خطوات الطلب</a>
      <a href="#areas">المحافظات والمدن</a>
      <a href="#faq">الأسئلة الشائعة</a>
    </nav>

    <section id="openings">
      <h2>عمل فتحات كور خرسانة لجميع تمديدات المباني والمشاريع</h2>
      <p>يُعد <strong>الكور الخرساني</strong> (Diamond Core Drilling) الحل الهندسي الأول لـ <strong>عمل فتحات في الخرسانة</strong> المسلحة والطوب والرخام والجرانيت بحواف ناعمة ومقاس مطابق تمامًا لقطر الماسورة أو الدكت. بدلاً من التكسير العشوائي الذي يسبب تصدعات وتكاليف محارة ودهانات إضافية، يقوم <strong>فني كور</strong> متخصص بتثبيت <strong>جهاز الكور للحفر</strong> وقطع الخرسانة وحديد التسليح بسلاسة تامة في الأوضاع الأفقية والرأسية والمائلة.</p>
      <div class="core-grid core-grid-3">
        <div>
          <h3>فتحات السباكة وفتحة الصرف الصحي</h3>
          <p>تنفيذ <strong>تخريم السقف</strong> والجدران لمرور مواسير التغذية و<strong>فتحة الصرف الصحي</strong> (4 إلى 8 بوصة) والبيب والصواعد مع ضبط الميول والعزل وحماية الدور السفلي. راجع <a href="/فتحات-كور-التكييف-والسباكة/">دليل فتحات الكور للسباكة والتكييف</a>.</p>
        </div>
        <div>
          <h3>فتحة تكييف مركزي واسبليت والكابلات</h3>
          <p><strong>عمل فتحات كور</strong> لمواسير الفريون وصرف التكييف بميل هندسي للخارج، وفتحات صواني الكابلات (Cable Trays) وخطوط إطفاء الحريق في الجراجات والمولات. راجع <a href="/فتحات-كور-التكييف-والسباكة/#ac-sizes">جدول مقاسات فتحات التكييف</a>.</p>
        </div>
        <div>
          <h3>فتحة كور شفاط المطبخ والحمام</h3>
          <p>تنفيذ <strong>فتحة شفاط المطبخ</strong> والشفاطات السقفية والمركزية (4 و5 و6 و8 بوصة فأكثر) مع حماية السيراميك والرخام. وإذا احتجت التركيب مع الفتحة راجع <a href="/فني-شفاطات/">خدمة فني الشفاطات</a> و<a href="/تأسيس-مدخنة-شفاط-المطبخ-بلت-ان/">تأسيس مدخنة شفاط المطبخ</a>.</p>
        </div>
        <div>
          <h3>فتحة تهوية سخان الغاز والغاز الطبيعي</h3>
          <p>تخريم <strong>فتحة تهوية سخان الغاز</strong> وفتحات المدخنة ومواسير الغاز الطبيعي وفق اشتراطات ومقاسات شركات الغاز بدقة تامة. راجع <a href="/عمل-فتحات-الغاز/">دليل عمل فتحات الغاز والهواية</a> و<a href="/سعر-تخريم-مدخنة-سخان-الغاز-بدرجة-عالية/">سعر تخريم مدخنة السخان</a>.</p>
        </div>
        <div>
          <h3>فتح كور في الكمر والأسقف المسلحة</h3>
          <p>تنفيذ <strong>فتح السقف بالكور</strong> و<strong>تخريم جدار</strong> خرساني و<strong>فتح كور في الكمر</strong> في حالات التعديلات المعمارية وتمرير الخطوط الرئيسية بعد التأكد من المواضع الآمنة واعتماد المهندس الإنشائي.</p>
        </div>
        <div>
          <h3>اختبار الكور للخرسانة (Core Test) ومشاريع MEP</h3>
          <p>تقدم <strong>دريل ماكس</strong> كـ <strong>شركة تخريم خرسانة</strong> متخصصة خدمة استخراج عينات أسطوانية قياسية لصالح معامل <strong>اختبار الكور تست للخرسانة</strong>، إلى جانب عقود <strong>مقاول فتحات كور</strong> لمشاريع الأبراج والمصانع والمستشفيات.</p>
        </div>
      </div>
      <p>هل تحتاج فتحات مستطيلة مثل فتح باب أو شباك أو منور أو قص سلم؟ نوفر أيضًا <a href="/saw-cuttingقص-خرسانة/">خدمة قص الخرسانة بالمنشار والليزر</a> و<a href="/قص-الخرسانة-بالواير/">قص الخرسانة بالواير الماسي</a> لتعمل مع <strong>صنايعي كور ومنشار</strong> من فريق واحد متكامل.</p>
    </section>

    <section id="sizes">
      <h2>دليل مقاسات فتحات الكور الأكثر طلبًا في مصر</h2>
      <p>نمتلك مجموعة كاملة من <strong>ريش وأسطوانات الكور الماسية</strong> لتغطية كل الأقطار المطلوبة سواء للأعمال المنزلية أو المشاريع الصناعية، وبأعماق تصل إلى أكثر من 100 سم عبر وصلات إطالة متخصصة:</p>
      <div class="core-table">
        <table>
          <thead>
            <tr>
              <th scope="col">قطر الفتحة (بالبوصة)</th>
              <th scope="col">القطر التقريبي (سم)</th>
              <th scope="col">أشهر الاستخدامات العملية</th>
              <th scope="col">ملاحظة فنية</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">1 إلى 2 بوصة</th>
              <td>2.5 – 5 سم</td>
              <td>مواسير تغذية المياه، صرف التكييف، كابلات الكهرباء والإنترنت، وفتحات <strong>تزريع الأشاير</strong> بأقطار كبيرة.</td>
              <td>تُنصح للثقوب الدقيقة أو بزاوية مائلة لصرف المياه.</td>
            </tr>
            <tr>
              <th scope="row">2.5 إلى 3 بوصة</th>
              <td>6.5 – 7.5 سم</td>
              <td>الفتحة القياسية لمواسير فريون التكييف الاسبليت ومواسير الغاز الطبيعي وخطوط التبريد.</td>
              <td>الأكثر طلبًا في الشقق المشطبة؛ تستغرق دقائق معدودة.</td>
            </tr>
            <tr>
              <th scope="row">4 إلى 5 بوصة</th>
              <td>10 – 12.5 سم</td>
              <td>مواسير الصرف الصحي 4 بوصة، مدخنة و<strong>فتحة تهوية سخان الغاز</strong>، وشفاطات الحمام والمطبخ (4–5 بوصة).</td>
              <td>تسمح بتركيب الجلبة والعزل حول الماسورة بدون تكسير.</td>
            </tr>
            <tr>
              <th scope="row">6 إلى 8 بوصة</th>
              <td>15 – 20 سم</td>
              <td>خطوط الصرف الرئيسية، <strong>فتحة كور شفاط</strong> المطبخ القوي والبلت إن، دكت التهوية ومواسير الحريق.</td>
              <td>تتطلب تثبيتًا محكمًا للماكينة وضبطًا لتجميع المياه.</td>
            </tr>
            <tr>
              <th scope="row">10 إلى 14 بوصة</th>
              <td>25 – 35 سم</td>
              <td>دكت التكييف المركزي، <a href="/شفاط-مركزي-وشفاطات-مطاعم/">شفاطات المطاعم والتهوية المركزية</a>، وصواعد المصانع.</td>
              <td>تُنفذ بماكينات كور ثقيلة 3 فاز أو قدرات عالية.</td>
            </tr>
            <tr>
              <th scope="row">16 إلى 24 بوصة فأكثر</th>
              <td>40 – 60+ سم</td>
              <td>المناور الدائرية، غرف التفتيش، المحطات الصناعية، وفتحات MEP العملاقة.</td>
              <td>يمكن تنفيذها بقطر واحد كبير أو بالثقب المتجاور (Stitch Drilling).</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="gallery">
      <h2>صور حقيقية من أعمال شغل الكور وتخريم الخرسانة المسلحة</h2>
      <p>نماذج ميدانية من تنفيذ فرق <strong>دريل ماكس</strong> في <strong>حفر كور خرسانة</strong> أفقي ورأسي ومائل وبأقطار كبيرة في مشاريع وشقق داخل مصر:</p>
