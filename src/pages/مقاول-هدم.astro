---
import MainLayout from '../layouts/MainLayout.astro';

const faqItems = [
  {
    q: "هل يؤثر تكسير الجدران على سلامة المبنى؟",
    a: "لا، عندما يتم بشكل احترافي ومدروس. قبل البدء، نراجع طبيعة الجدران والمخططات الإنشائية للتمييز بين الجدران الحاملة وغير الحاملة، ولا يُنفّذ أي تعديل على عنصر إنشائي حامل إلا بعد اعتماد المهندس المسؤول وتوفير التدعيم اللازم."
  },
  {
    q: "كم تكلفة خدمات تكسير الحوائط والأرضيات والهدم؟",
    a: "تعتمد التكلفة على مساحة وحجم الأعمال، ونوع المواد المطلوب تكسيرها (طوب، سيراميك، خرسانة مسلحة)، والدور، وهل يشمل العرض تشوين ونقل المخلفات أم لا. نقدم معاينة فنية لتحديد عرض سعر دقيق ومفصل قبل البدء."
  },
  {
    q: "هل تشمل الخدمة رفع ونقل مخلفات الهدم والتكسير؟",
    a: "نعم، نوفر خدمة متكاملة تشمل فرز وتجميع الأنقاض وتعبئتها وتحميلها ونقلها بسيارات مخصصة للتخلص منها بالطرق القانونية وتسليم الموقع نظيفاً وجاهزاً للمرحلة التالية."
  },
  {
    q: "متى يُفضّل استخدام القص بالمنشار بدلاً من التكسير؟",
    a: "عند الحاجة لعمل فتحة باب أو شباك أو قص جزء محدد في خرسانة مسلحة مع الحفاظ على استقامة الحواف وتقليل الاهتزازات، يكون المنشار الماسي هو الحل الأنسب، بينما يُستخدم التكسير في إزالة الجدران غير الحاملة والأرضيات والحمامات بالكامل."
  }
];

const seo = {
  title: "مقاول هدم وتكسير حوائط وخرسانة وتشوين في مصر | 01070046464",
  description: "مقاول هدم وتكسير حوائط وخرسانة مسلحة في مصر: إزالة حوائط الشقق والمحلات، تكسير حمامات ومطابخ، وتشوين ونقل المخلفات بأمان. اتصل 01070046464.",
  canonical: "/%d9%85%d9%82%d8%a7%d9%88%d9%84-%d9%87%d8%af%d9%85/",
  ogImage: "/images/Untitled-134.webp",
  schema: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://drilmax.com/#organization",
        "name": "Drill Max | دريل ماكس",
        "url": "https://drilmax.com",
        "sameAs": ["https://www.facebook.com/drillmaxeg"],
        "logo": {
          "@type": "ImageObject",
          "@id": "https://drilmax.com/#logo",
          "url": "https://drilmax.com/images/logo-1.webp",
          "contentUrl": "https://drilmax.com/images/logo-1.webp",
          "caption": "Drill Max | دريل ماكس لخدمات قص وتخريم الخرسانة",
          "inLanguage": "ar",
          "width": "400",
          "height": "400"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://drilmax.com/#website",
        "url": "https://drilmax.com",
        "name": "Drill Max | دريل ماكس لخدمات قص وتخريم الخرسانة",
        "alternateName": "دريل ماكس",
        "publisher": { "@id": "https://drilmax.com/#organization" },
        "inLanguage": "ar"
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://drilmax.com/%d9%85%d9%82%d8%a7%d9%88%d9%84-%d9%87%d8%af%d9%85/#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "item": { "@id": "https://drilmax.com", "name": "الرئيسية" } },
          { "@type": "ListItem", "position": 2, "item": { "@id": "https://drilmax.com/%d9%85%d9%82%d8%a7%d9%88%d9%84-%d9%87%d8%af%d9%85/", "name": "مقاول هدم وتكسير" } }
        ]
      },
      {
        "@type": "Service",
        "@id": "https://drilmax.com/%d9%85%d9%82%d8%a7%d9%88%d9%84-%d9%87%d8%af%d9%85/#service",
        "name": "مقاول هدم وتكسير وتشوين مخلفات",
        "description": "خدمات هدم وتكسير الحوائط والخرسانات والأرضيات مع تشوين ونقل كامل للمخلفات بدقة وأمان في مصر.",
        "provider": { "@id": "https://drilmax.com/#organization" },
        "areaServed": { "@type": "Country", "name": "Egypt" },
        "url": "https://drilmax.com/%d9%85%d9%82%d8%a7%d9%88%d9%84-%d9%87%d8%af%d9%85/"
      },
      {
        "@type": "FAQPage",
        "@id": "https://drilmax.com/%d9%85%d9%82%d8%a7%d9%88%d9%84-%d9%87%d8%af%d9%85/#faq",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.q,
          "acceptedAnswer": { "@type": "Answer", "text": item.a }
        }))
      }
    ]
  })
};

const serviceBlocks = [
  {
    title: "تكسير الخرسانة المسلحة والهياكل",
    desc: "متخصصون في أعمال الهدم الثقيل وتكسير الخرسانة المسلحة للأعمدة والأساسات والكمرات وفق خطة هندسية تضمن السلامة.",
    img: "/images/تكسير.webp",
    alt: "مقاول هدم وتكسير خرسانة مسلحة من دريل ماكس",
    points: ["تكسير الأعمدة والكمرات والسلالم", "هدم الأساسات والقواعد الخرسانية", "تنفيذ التعديلات الإنشائية بإشراف فني"],
    cta: "اطلب خدمة هدم خرسانة"
  },
  {
    title: "تكسير وتجهيز الشقق والمكاتب للتجديدات",
    desc: "نقدم خدمات تكسير دقيقة للمنازل والمكاتب وإزالة الجدران الفاصلة والأرضيات والأسقف لتجهيز المساحة للتشطيب الجديد.",
    img: "/images/Untitled-1.webp",
    alt: "أعمال تكسير حوائط وتجهيز شقة للتجديد",
    points: ["إزالة الحوائط والجدران غير الحاملة", "تكسير الأرضيات (بلاط، سيراميك، رخام)", "إزالة الأسقف المعلقة والجبسية"],
    cta: "احجز خدمة تجهيز وتكسير"
  },
  {
    title: "هدم وتكسير للمنشآت التجارية والصناعية",
    desc: "حلول هدم وتكسير مخصصة للمحلات التجارية والمكاتب والمصانع مع الالتزام الكامل بجدول التسليم لتقليل توقف النشاط.",
    img: "/images/Untitled-12.webp",
    alt: "أعمال هدم وتكسير لموقع تجاري وصناعي",
    points: ["إزالة القواطيع والمنشآت الداخلية", "تكسير أرضيات المصانع الخرسانية", "تجهيز المواقع التجارية والمولات"],
    cta: "اطلب عرض سعر لمشروع تجاري"
  },
  {
    title: "تكسير وتجهيز الحمامات والمطابخ",
    desc: "إزالة كاملة للحمامات والمطابخ القديمة بما يشمل السيراميك والأرضيات وتكسير مسارات السباكة القديمة استعداداً للتجديد.",
    img: "/images/demolition.webp",
    alt: "فريق عمل دريل ماكس أثناء تنفيذ عملية تكسير لجدار داخلي",
    points: ["إزالة البلاط والسيراميك والرخام", "فك وتكسير الأحواض والمراحيض", "فك وإزالة وحدات وتجهيزات المطبخ القديمة"],
    cta: "اطلب خدمة تكسير حمام أو مطبخ"
  },
  {
    title: "إزالة وتشوين المخلفات وتسليم الموقع نظيفاً",
    desc: "لا يكتمل عملنا إلا بتسليم موقعك نظيفاً بالكامل؛ نتولى فرز وتجميع وتحميل ونقل جميع مخلفات الهدم والأنقاض بطريقة آمنة وقانونية.",
    img: "/images/Untitled-14.webp",
    alt: "سيارة نقل وتشوين مخلفات هدم من موقع عمل لدريل ماكس",
    points: ["فرز وتجميع وتعبئة المخلفات", "تحميل ونقل آمن للأنقاض", "التخلص من المخلفات بالطرق القانونية"],
    cta: "اطلب خدمة شاملة مع التشوين"
  }
];
---

<MainLayout {...seo}>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container text-center">
      <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
        <span class="hero-subtitle">دريل ماكس | مقاول هدم وتكسير حوائط وخرسانة</span>
        <h1>مقاول هدم وتكسير حوائط وخرسانة وتشوين مخلفات في مصر</h1>
        <p class="hero-lead">
          نقدم خدمات مقاول هدم وتكسير حوائط وخرسانة مسلحة بدقة وأمان للشقق والفيلات والمحلات والمصانع، مع فريق عمال تكسير محترف وتشوين ونقل كامل للأنقاض وتسليم الموقع نظيفاً.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">اطلب معاينة وعرض سعر</a>
          <a href="https://wa.me/201070046464" class="btn btn-wa" target="_blank" rel="noopener noreferrer">تواصل عبر واتساب</a>
        </div>
      </div>
    </div>
  </section>

  <section class="demo-section bg-light">
    <div class="container">
      <div class="intro-box">
        <h2>تكسير حوائط وخرسانة بأسلوب هندسي آمن</h2>
        <p>
          سواء كنت تبحث عن <strong>مقاول تكسير</strong> لإزالة حائط فاصل وتوسعة الريسبشن، أو <strong>مقاول هدم مباني</strong> وهياكل خرسانية، فإن التكسير الاحترافي يبدأ بمعاينة الموقع والتمييز بين الجدران الحاملة وغير الحاملة وتحديد مسارات الكهرباء والسباكة قبل تشغيل المعدات.
        </p>
        <p>
          <strong>متى نختار تكسير الحوائط ومتى نختار القص بالمنشار؟</strong> لإزالة حوائط الطوب والسيراميك والحمامات بالكامل يوفّر فريق عمال التكسير لدينا سرعة عالية وتكلفة اقتصادية مع تشوين ونقل المخلفات؛ أما لفتح باب أو شباك في خرسانة مسلحة دون اهتزاز فيُدمج التنفيذ مع <a href="/saw-cutting%d9%82%d8%b5-%d8%ae%d8%b1%d8%b3%d8%a7%d9%86%d8%a9/">قص الخرسانة بالمنشار الماسي</a> و<a href="/core-drilling-%d8%b5%d9%86%d8%a7%d9%8a%d8%b9%d9%8a-%d9%83%d9%88%d8%b1/">فتحات الكور دريل</a>.
        </p>
        <p>
          <strong>نطاق التغطية وعوامل التسعير:</strong> تتحدد تكلفة تكسير حوائط الشقة أو الخرسانة بناءً على مساحة الجدار وسماكته (طوب أم خرسانة مسلحة)، الطابق وتوافر المصعد، وعدد نقلات الرتش. للمزيد اقرأ <a href="/تكسير-حوائط-وخرسانة-شقق/">دليل تكسير حوائط الشقة والخرسانة وتشوين المخلفات</a>. نخدم القاهرة والجيزة و<a href="/new-cairo-tagamoa-concrete-cutting-core/">التجمع الخامس</a> و<a href="/new-capital-shorouk-madinaty-core/">العاصمة الإدارية والشروق ومدينتي</a> و<a href="/تخريم-خرسانة-مدينة-نصر/">مدينة نصر</a> و<a href="/october-zayed-concrete-cutting-core/">6 أكتوبر والشيخ زايد</a> و<a href="/alexandria-concrete-cutting-core/">الإسكندرية</a> و<a href="/service-areas/">جميع محافظات مصر</a>. راجع أيضاً <a href="/prices/">دليل الأسعار</a>.
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <h3>الأمان أولويتنا القصوى</h3>
          <p>نلتزم بمعايير السلامة المهنية وتأمين الموقع والمرافق المجاورة قبل بدء أي أعمال تكسير.</p>
        </div>
        <div class="feature-card">
          <h3>التزام بالمخطط الهندسي</h3>
          <p>مراجعة الجدران الحاملة وتجنب أي مساس بالسلامة الإنشائية للمبنى أثناء الإزالة.</p>
        </div>
        <div class="feature-card">
          <h3>إنجاز سريع ومنظم</h3>
          <p>معدات تكسير هيدروليكية وكهربائية حديثة تنجز الأعمال في الوقت المتفق عليه.</p>
        </div>
        <div class="feature-card">
          <h3>تشوين ونقل المخلفات</h3>
          <p>رفع كامل للأنقاض وتنظيف موقع العمل لتسليمه جاهزاً للمقاول أو فني التشطيبات.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="demo-section">
    <div class="container">
      <div class="section-header text-center">
        <h2>خدمات الهدم والتكسير التي نقدمها</h2>
        <p>تغطية شاملة لأعمال التكسير السكنية والتجارية والصناعية مع خيار تشوين ونقل المخلفات.</p>
      </div>

      <div class="services-stack">
        {serviceBlocks.map((item, idx) => (
          <div class={`service-row ${idx % 2 === 1 ? 'reverse' : ''}`}>
            <div class="service-media">
              <img src={item.img} alt={item.alt} width="1000" height="712" loading="lazy" />
            </div>
            <div class="service-body">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              <ul>
                {item.points.map(pt => <li>{pt}</li>)}
              </ul>
              <a href="/contact/" class="btn btn-primary">{item.cta}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="demo-section bg-light">
    <div class="container" style="max-width: 900px;">
      <div class="section-header text-center">
        <h2>أسئلة شائعة حول خدمات الهدم والتكسير</h2>
      </div>
      <div class="faq-list">
        {faqItems.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>

      <div class="demo-cta">
        <h2>جاهز لبدء أعمال التكسير والتجهيز في موقعك؟</h2>
        <p>أرسل تفاصيل المساحة وصور الموقع عبر واتساب أو اتصل بنا لمناقشة نطاق العمل وتكلفة التكسير والتشوين.</p>
        <div class="cta-actions">
          <a href="/contact/" class="btn btn-primary">تواصل معنا الآن</a>
          <a href="tel:+201070046464" class="btn btn-outline">اتصل: 01070046464</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .text-center { text-align: center; }
  .bg-light { background-color: var(--section-bg); }
  .demo-section { padding: 64px 0; }
  .hero h1 { font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.35; margin-bottom: 16px; }
  .hero-lead { color: #e2e8f0; font-size: 1.12rem; line-height: 1.85; margin-bottom: 24px; }
  .hero-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  .section-header { max-width: 760px; margin: 0 auto 40px; }
  .section-header h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--dark); margin-bottom: 10px; }
  .section-header p { color: var(--gray); line-height: 1.85; font-size: 1.05rem; }

  .intro-box {
    background: #fff;
    padding: 36px;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    margin-bottom: 32px;
  }
  .intro-box h2 { color: var(--dark); font-size: 1.7rem; margin-bottom: 14px; }
  .intro-box p { color: var(--gray); line-height: 1.9; margin-bottom: 12px; font-size: 1.05rem; }
  .intro-box a { color: var(--primary); font-weight: 700; text-decoration: underline; }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 20px;
  }
  .feature-card {
    background: #fff;
    padding: 26px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--primary);
  }
  .feature-card h3 { color: var(--dark); font-size: 1.15rem; margin-bottom: 8px; }
  .feature-card p { color: var(--gray); line-height: 1.8; font-size: 0.98rem; }

  .services-stack { display: flex; flex-direction: column; gap: 36px; }
  .service-row {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 32px;
    align-items: center;
    background: #fff;
    padding: 28px;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    box-shadow: 0 6px 22px rgba(15, 23, 42, 0.04);
  }
  .service-row.reverse .service-media { order: 2; }
  .service-media img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }
  .service-body h3 { color: var(--dark); font-size: 1.45rem; margin-bottom: 12px; }
  .service-body p { color: var(--gray); line-height: 1.85; margin-bottom: 14px; }
  .service-body ul { list-style: disc; padding-inline-start: 22px; color: var(--dark); line-height: 1.9; margin-bottom: 20px; }
  .service-body li { margin-bottom: 6px; }

  .faq-list { display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px; }
  .faq-item {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px 24px;
  }
  .faq-item summary {
    font-weight: 700;
    color: var(--dark);
    font-size: 1.08rem;
    cursor: pointer;
  }
  .faq-item p {
    color: var(--gray);
    line-height: 1.85;
    margin-top: 12px;
  }

  .demo-cta {
    background: var(--header-bg);
    color: #fff;
    border-radius: 14px;
    padding: 40px 28px;
    text-align: center;
  }
  .demo-cta h2 { font-size: 1.7rem; margin-bottom: 12px; color: #fff; }
  .demo-cta p { color: #cbd5e1; max-width: 650px; margin: 0 auto 22px; line-height: 1.85; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .demo-section { padding: 40px 0; }
    .service-row { grid-template-columns: 1fr; padding: 20px; }
    .service-row.reverse .service-media { order: 0; }
    .service-media img { height: 220px; }
    .intro-box, .demo-cta { padding: 24px 18px; }
  }
</style>
