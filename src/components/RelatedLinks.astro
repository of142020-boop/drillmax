---
/**
 * RelatedLinks.astro
 * SEO internal-linking component.
 * Renders a semantic <nav> block with related service links.
 * Improves crawl paths, distributes PageRank, and boosts topical authority.
 */
interface Link {
  href: string;
  label: string;
  desc?: string;
}

interface Props {
  title?: string;
  links: Link[];
  columns?: 2 | 3 | 4;
}

const {
  title = "خدمات ذات صلة",
  links,
  columns = 3,
} = Astro.props;
---

<nav class="related-links" aria-label={title}>
  <h2 class="related-links__title">{title}</h2>
  <ul class={`related-links__grid related-links__grid--${columns}`}>
    {links.map((link) => (
      <li class="related-links__item">
        <a href={link.href}>
          <span class="related-links__label">{link.label}</span>
          {link.desc && <span class="related-links__desc">{link.desc}</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .related-links {
    margin: 50px 0 20px;
    padding: 30px;
    background: var(--light, #f8fafc);
    border-radius: 12px;
    border: 1px solid var(--border, #e2e8f0);
  }
  .related-links__title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--dark, #1e293b);
    margin-bottom: 22px;
    text-align: center;
  }
  .related-links__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .related-links__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .related-links__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .related-links__grid--4 { grid-template-columns: repeat(4, 1fr); }
  .related-links__item a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.25s ease;
    height: 100%;
  }
  .related-links__item a:hover {
    border-color: var(--primary, #f59e0b);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }
  .related-links__label {
    font-weight: 700;
    color: var(--dark, #1e293b);
    font-size: 1rem;
    line-height: 1.4;
  }
  .related-links__desc {
    font-size: 0.88rem;
    color: var(--gray, #64748b);
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .related-links__grid--3,
    .related-links__grid--4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .related-links__grid--2,
    .related-links__grid--3,
    .related-links__grid--4 { grid-template-columns: 1fr; }
    .related-links { padding: 22px 16px; }
  }
</style>
