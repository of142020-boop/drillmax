---
/**
 * RelatedLinks.astro
 * SEO internal-linking component.
 * Renders a semantic <nav> block with related service links.
 * Improves crawl paths, distributes PageRank, and boosts topical authority.
 */
interface Link {
  href: string;
  label: string;
  desc?: string;
}

interface Props {
  title?: string;
  links: Link[];
  columns?: 2 | 3 | 4;
}

const {
  title = "خدمات ذات صلة",
  links,
  columns = 3,
} = Astro.props;
---

<nav class="related-links" aria-label={title}>
  <h2 class="related-links__title">{title}</h2>
  <ul class={`related-links__grid related-links__grid--${columns}`}>
    {links.map((link) => (
      <li class="related-links__item">
        <a href={link.href}>
          <span class="related-links__label">{link.label}</span>
          {link.desc && <span class="related-links__desc">{link.desc}</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .related-links {
    margin: 48px 0 20px;
    padding: 28px;
    background: var(--section-bg, #f5f4f0);
    border-radius: 4px;
    border: 1px solid var(--border-color, #dad7ce);
  }
  .related-links__title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--dark, #14171c);
    margin-bottom: 20px;
    text-align: right;
  }
  .related-links__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .related-links__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .related-links__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .related-links__grid--4 { grid-template-columns: repeat(4, 1fr); }
  .related-links__item a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid var(--border-color, #dad7ce);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    height: 100%;
  }
  .related-links__item a:hover {
    border-color: var(--primary, #c2410c);
    background: #faf9f6;
  }
  .related-links__label {
    font-weight: 700;
    color: var(--dark, #14171c);
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .related-links__desc {
    font-size: 0.87rem;
    color: var(--gray, #4b5058);
    line-height: 1.55;
  }
  @media (max-width: 900px) {
    .related-links__grid--3,
    .related-links__grid--4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .related-links__grid--2,
    .related-links__grid--3,
    .related-links__grid--4 { grid-template-columns: 1fr; }
    .related-links { padding: 20px 16px; }
  }
</style>
