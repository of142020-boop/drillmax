<form class="whatsapp-request" action="https://wa.me/201070046464" method="get" data-whatsapp-form>
  <label>الاسم الكريم
    <input type="text" name="clientName" autocomplete="name" maxlength="100" required />
  </label>
  <label>رقم الهاتف
    <input type="tel" name="phone" autocomplete="tel" inputmode="tel" dir="ltr" maxlength="30" required />
  </label>
  <label>رسالتك أو تفاصيل المشروع
    <textarea name="message" rows="4" maxlength="2000" required></textarea>
  </label>
  <p class="form-help">سنفتح واتساب بتفاصيل طلبك لتراجع الرسالة وترسلها بنفسك.</p>
  <button type="submit">متابعة الطلب عبر واتساب</button>
  <noscript><style>.whatsapp-request button { display: none; }</style><p>فعّل JavaScript لتجهيز الرسالة، أو <a href="https://wa.me/201070046464">تواصل معنا مباشرة عبر واتساب</a>.</p></noscript>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-whatsapp-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const name = String(data.get('clientName') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const message = String(data.get('message') || '').trim();
      if (!name || !phone || !message) {
        const field = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(!name ? '[name="clientName"]' : !phone ? '[name="phone"]' : '[name="message"]');
        if (field) {
          field.setCustomValidity('يرجى كتابة البيانات المطلوبة.');
          field.reportValidity();
          field.addEventListener('input', () => field.setCustomValidity(''), { once: true });
        }
        return;
      }
      const text = `طلب خدمة من موقع دريل ماكس\nالاسم: ${name}\nالهاتف: ${phone}\nتفاصيل المشروع: ${message}`;
      const destination = new URL(form.action);
      destination.searchParams.set('text', text);
      window.location.assign(destination.href);
    });
  });
</script>

<style>
  .whatsapp-request { display: grid; gap: 18px; text-align: right; }
  label { display: grid; gap: 8px; font-weight: 700; color: var(--dark); }
  input, textarea { display: block; width: 100%; min-width: 0; padding: 14px; border: 1px solid #94a3b8; border-radius: 8px; font: inherit; font-weight: 400; background: #fff; color: var(--dark); }
  textarea { resize: vertical; min-height: 120px; }
  input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 3px solid #c2410c; outline-offset: 3px; }
  .form-help { margin: 0; color: #475569; font-size: .9rem; line-height: 1.7; }
  button { border: 0; border-radius: 8px; padding: 15px 20px; min-height: 48px; background: var(--primary); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { background: var(--primary-hover); }
</style>
