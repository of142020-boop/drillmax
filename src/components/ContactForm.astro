<form class="whatsapp-request" action="https://wa.me/201070046464" method="get" data-whatsapp-form>
  <label>الاسم الكريم
    <input type="text" name="clientName" autocomplete="name" maxlength="100" required />
  </label>
  <label>رقم الهاتف
    <input type="tel" name="phone" autocomplete="tel" inputmode="tel" dir="ltr" maxlength="30" required />
  </label>
  <label>رسالتك أو تفاصيل المشروع
    <textarea name="message" rows="4" maxlength="2000" required></textarea>
  </label>
  <p class="form-help">سنفتح واتساب بتفاصيل طلبك لتراجع الرسالة وترسلها بنفسك.</p>
  <button type="submit" disabled>متابعة الطلب عبر واتساب</button>
  <noscript><p>فعّل JavaScript لتجهيز الرسالة، أو <a href="https://wa.me/201070046464">تواصل معنا مباشرة عبر واتساب</a>.</p></noscript>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-whatsapp-form]').forEach((form) => {
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = false;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const name = String(data.get('clientName') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const message = String(data.get('message') || '').trim();
      if (!name || !phone || !message) {
        const field = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(!name ? '[name="clientName"]' : !phone ? '[name="phone"]' : '[name="message"]');
        if (field) {
          field.setCustomValidity('يرجى كتابة البيانات المطلوبة.');
          field.reportValidity();
          field.addEventListener('input', () => field.setCustomValidity(''), { once: true });
        }
        return;
      }
      const normalizedPhone = phone.replace(/[٠-٩]/g, d => String(d.charCodeAt(0) - 1632)).replace(/[۰-۹]/g, d => String(d.charCodeAt(0) - 1776));
      const digits = normalizedPhone.replace(/\D/g, '');
      if (!/^[+\d\s().-]+$/.test(normalizedPhone) || digits.length < 7 || digits.length > 15) {
        const field = form.querySelector<HTMLInputElement>('[name="phone"]');
        if (field) {
          field.setCustomValidity('يرجى كتابة رقم هاتف صحيح من 7 إلى 15 رقمًا.');
          field.reportValidity();
          field.addEventListener('input', () => field.setCustomValidity(''), { once: true });
        }
        return;
      }
      const text = `طلب خدمة من موقع دريل ماكس\nالاسم: ${name}\nالهاتف: ${phone}\nتفاصيل المشروع: ${message}`;
      const destination = new URL(form.action);
      destination.searchParams.set('text', text);
      window.location.assign(destination.href);
    });
  });
</script>

<style>
  .whatsapp-request { display: grid; gap: 16px; text-align: right; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .92rem; color: var(--dark); }
  input, textarea { display: block; width: 100%; min-width: 0; padding: 13px 14px; border: 1px solid #c9c5bb; border-radius: 4px; font: inherit; font-weight: 400; background: #faf9f6; color: var(--dark); transition: border-color .2s, background-color .2s; }
  input:focus, textarea:focus { background: #fff; border-color: var(--primary); }
  textarea { resize: vertical; min-height: 112px; }
  input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 2px solid #c2410c; outline-offset: 2px; }
  .form-help { margin: 0; color: var(--gray); font-size: .86rem; line-height: 1.7; }
  button { border: 0; border-radius: 4px; padding: 14px 20px; min-height: 48px; background: var(--primary); color: #fff; font: inherit; font-weight: 700; cursor: pointer; transition: background-color .2s; }
  button:hover { background: var(--primary-hover); }
</style>
